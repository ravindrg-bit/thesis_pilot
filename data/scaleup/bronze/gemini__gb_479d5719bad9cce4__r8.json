          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": null,
                "end_index": 221,
                "part_index": null,
                "text": "**Welch Allyn** (a premier brand under Baxter, formerly Hillrom) has been a leading pioneer in medical diagnostics since 1915, when its founders developed the world\u2019s first handheld, directly illuminating ophthalmoscope"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                0,
                2
              ],
              "segment": {
                "start_index": 223,
                "end_index": 379,
                "part_index": null,
                "text": "Today, Welch Allyn produces a wide range of industry-standard ophthalmic diagnostic tools, trusted by optometrists, ophthalmologists, GPs, and pediatricians"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 482,
                "end_index": 640,
                "part_index": null,
                "text": "Direct Ophthalmoscopes\nWelch Allyn offers several models of direct ophthalmoscopes, ranging from premium digital-ready devices to highly portable pocket tools"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 643,
                "end_index": 817,
                "part_index": null,
                "text": "*   **PanOptic\u2122 Plus Ophthalmoscope (Premium / Wide-View):** \n    *   **Field of View:** Provides a field of view **20 times larger** than a standard coaxial ophthalmoscope"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                5
              ],
              "segment": {
                "start_index": 824,
                "end_index": 935,
                "part_index": null,
                "text": "*   **Key Features:** It features *Quick Eye* alignment technology (using lights to guide the patient\u2019s gaze)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                6
              ],
              "segment": {
                "start_index": 824,
                "end_index": 972,
                "part_index": null,
                "text": "*   **Key Features:** It features *Quick Eye* alignment technology (using lights to guide the patient\u2019s gaze), LED illumination (SureColor\u2122 LED)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                6
              ],
              "segment": {
                "start_index": 824,
                "end_index": 1059,
                "part_index": null,
                "text": "*   **Key Features:** It features *Quick Eye* alignment technology (using lights to guide the patient\u2019s gaze), LED illumination (SureColor\u2122 LED), and *DuraShock\u2122* technology, which makes the tool drop-resistant and highly durable"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                6
              ],
              "segment": {
                "start_index": 1066,
                "end_index": 1170,
                "part_index": null,
                "text": "*   **Digital Ready:** This model is designed to easily pair with smartphone digital imaging accessories"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                4
              ],
              "segment": {
                "start_index": 1306,
                "end_index": 1453,
                "part_index": null,
                "text": "By aligning the entry light and the viewing path, it reduces glare, shadows, and pupillary constriction, making it easier to enter undilated pupils"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1459,
                "end_index": 1664,
                "part_index": null,
                "text": "*   **Apertures & Lenses:** Typically includes multiple apertures (such as micro-spot, small spot, large spot, slit, and fixation grid) and filters (like cobalt blue and red-free) alongside 28 focus lenses"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                4
              ],
              "segment": {
                "start_index": 1666,
                "end_index": 1813,
                "part_index": null,
                "text": "*   **Pocket LED / PocketScope\u2122 Ophthalmoscope (Portable / Student-Friendly):**\n    *   The most lightweight, compact, and budget-friendly option"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 1901,
                "end_index": 2053,
                "part_index": null,
                "text": "Digital Ophthalmoscopy: The iExaminer\u2122 Pro System\nWelch Allyn bridges classic physical exams with digital medicine through the **iExaminer** ecosystem"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                6
              ],
              "segment": {
                "start_index": 1901,
                "end_index": 2193,
                "part_index": null,
                "text": "Digital Ophthalmoscopy: The iExaminer\u2122 Pro System\nWelch Allyn bridges classic physical exams with digital medicine through the **iExaminer** ecosystem:\n*   **iExaminer SmartBracket\u2122:** A custom adapter that clips a smartphone directly onto the eyepiece of the PanOptic Plus ophthalmoscope"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                11
              ],
              "segment": {
                "start_index": 2195,
                "end_index": 2331,
                "part_index": null,
                "text": "*   **iExaminer Pro App:** Enables clinicians to capture, save, and share high-resolution, digital photos and video of the fundus/retina"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                12
              ],
              "segment": {
                "start_index": 2333,
                "end_index": 2494,
                "part_index": null,
                "text": "This is highly beneficial for documenting conditions like diabetic retinopathy, glaucoma, or papilledema, and sending images directly to specialists for referral"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                14
              ],
              "segment": {
                "start_index": 2509,
                "end_index": 2681,
                "part_index": null,
                "text": "Retinoscopes (for Refraction)\nFor objective measurement of refractive errors (such as myopia, hyperopia, and astigmatism), Welch Allyn manufactures specialized retinoscopes"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                15
              ],
              "segment": {
                "start_index": 2684,
                "end_index": 2833,
                "part_index": null,
                "text": "*   **Elite\u2122 Streak Retinoscope:** \n    *   Provides a highly defined, bright, and sharp streak reflex, making refractions faster and more accurate"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16
              ],
              "segment": {
                "start_index": 2839,
                "end_index": 2933,
                "part_index": null,
                "text": "*   Features a continuously rotating **external focusing sleeve** for easy physical adjustment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16
              ],
              "segment": {
                "start_index": 2939,
                "end_index": 3034,
                "part_index": null,
                "text": "*   Includes a **crossed linear polarizing filter** to eliminate 99% of glare from trial lenses"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16
              ],
              "segment": {
                "start_index": 3040,
                "end_index": 3225,
                "part_index": null,
                "text": "*   **Spot Retinoscopy Interchangeability:** By simply swapping the streak bulb for a spot bulb, the device converts into a spot retinoscope, eliminating the need to buy a second device"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17,
                2
              ],
              "segment": {
                "start_index": 3240,
                "end_index": 3464,
                "part_index": null,
                "text": "Binocular Indirect Ophthalmoscopes (BIO)\n*   **Model 12500 Binocular Indirect Ophthalmoscope:**\n    *   Worn on the examiner's head, this tool is designed for a stereoscopic, wide-angle clinical view of the peripheral retina"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                18,
                2
              ],
              "segment": {
                "start_index": 3551,
                "end_index": 3697,
                "part_index": null,
                "text": "Diagnostics Power Handles and Chargers\nOphthalmoscope and retinoscope heads require power handles, and Welch Allyn offers highly durable solutions"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 3551,
                "end_index": 3869,
                "part_index": null,
                "text": "Diagnostics Power Handles and Chargers\nOphthalmoscope and retinoscope heads require power handles, and Welch Allyn offers highly durable solutions:\n*   **3.5 V Lithium-Ion Plus USB Rechargeable Handle:** A lightweight handle with twice the on-time of traditional NiCad handles, featuring a convenient USB charging port"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                18
              ],
              "segment": {
                "start_index": 3871,
                "end_index": 3972,
                "part_index": null,
                "text": "*   **3.5 V Nickel-Cadmium (NiCad) Rechargeable Handle:** The classic, heavy-duty rechargeable option"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                18,
                9
              ],
              "segment": {
                "start_index": 3974,
                "end_index": 4103,
                "part_index": null,
                "text": "*   **Universal Desk Charger:** A dual-well tabletop charger that charges two handles (both NiCad and Lithium-Ion) simultaneously"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                19
              ],
              "segment": {
                "start_index": 4118,
                "end_index": 4230,
                "part_index": null,
                "text": "Integrated Wall Systems & Clinical Sets\nWelch Allyn tools are most frequently purchased in clinical combinations"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                19,
                18
              ],
              "segment": {
                "start_index": 4118,
                "end_index": 4467,
                "part_index": null,
                "text": "Integrated Wall Systems & Clinical Sets\nWelch Allyn tools are most frequently purchased in clinical combinations:\n*   **Green Series 777 Integrated Wall Board Systems:** Commonly seen in exam rooms, these mount to the wall and keep an ophthalmoscope, an otoscope (ear tool), a specula dispenser, and power cords organized and instantly ready for use"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                20
              ],
              "segment": {
                "start_index": 4469,
                "end_index": 4683,
                "part_index": null,
                "text": "*   **Portable Ophthalmic Sets:** Hard-case kits featuring a matching ophthalmoscope head, power handle, and sometimes an otoscope head (e.g., the MacroView Plus) for doctors traveling between exam rooms or clinics"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
          "search_entry_point": {
