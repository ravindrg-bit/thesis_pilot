              ],
              "segment": {
                "start_index": 4069,
                "end_index": 4273,
                "part_index": null,
                "text": "It is the visual result of your blood vessels clamping shut to redirect resources to your vital organs, leaving behind a pale yellow and blue optical mix that signals to the world: *\"I need to lay down.\"*"
              },
              "rendered_parts": null
            }
