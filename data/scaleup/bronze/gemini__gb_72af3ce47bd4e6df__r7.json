            {
              "image": null,
              "maps": null,
              "retrieved_context": null,
              "web": {
                "domain": null,
                "title": "wsws.org",
                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGXeBWfJ899IiYIwfHWGxUmsrrmxxFENek_s8s9b1PtH2roOyS5zUFgYUFdcJ8xb4MYbnVjwqQpjsZVz7I50BoBhY8hGFb0RJcBH763JoLNYZejM3epbhxk_XMB_dGZmyReQ-lxEwLXmVsNgNk="
