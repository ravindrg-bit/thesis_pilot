          ],
          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": null,
                "end_index": 154,
                "part_index": null,
                "text": "To answer this question, we have to look at both **food science** (the chemical makeup of the food) and **packaging science** (how the packets are sealed)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 158,
                "end_index": 325,
                "part_index": null,
                "text": "However, there is a very important distinction to make first: **sour cream packets actually *do* need to be refrigerated**, while ketchup and mayonnaise packets do not"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 504,
                "end_index": 569,
                "part_index": null,
                "text": "Unlike ketchup and mayo, **sour cream packets must be kept cold**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 572,
                "end_index": 687,
                "part_index": null,
                "text": "* **The Science:** Sour cream is a fresh, cultured dairy product with high moisture, low salt, and very little acid"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 690,
                "end_index": 825,
                "part_index": null,
                "text": "* **The Danger:** This environment is highly welcoming to harmful bacteria like *Listeria* and *Salmonella* if left at room temperature"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3,
                4
              ],
              "segment": {
                "start_index": 828,
                "end_index": 980,
                "part_index": null,
                "text": "* **The Reality:** Single-serve sour cream packets (like those made by Daisy or provided in meal kits) are shipped, stored, and sold under refrigeration"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                5
              ],
              "segment": {
                "start_index": 982,
                "end_index": 1109,
                "part_index": null,
                "text": "If you receive one at room temperature, it has a very short safe window (usually under 2 hours) before it should be thrown away"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 1243,
                "end_index": 1281,
                "part_index": null,
                "text": "In packet form, it is even more stable"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                6
              ],
              "segment": {
                "start_index": 1283,
                "end_index": 1344,
                "part_index": null,
                "text": "* **High Acidity:** Ketchup is made with tomatoes and vinegar"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                6
              ],
              "segment": {
                "start_index": 1528,
                "end_index": 1594,
                "part_index": null,
                "text": "* **Natural Preservatives:** Ketchup is loaded with sugar and salt"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                10
              ],
              "segment": {
                "start_index": 1720,
                "end_index": 1783,
                "part_index": null,
                "text": "* **Hermetic Seal:** The foil packets keep out oxygen and light"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                12
              ],
              "segment": {
                "start_index": 1969,
                "end_index": 2176,
                "part_index": null,
                "text": "Why Mayonnaise Packets Don't Need Refrigeration\nMany people are terrified of warm mayonnaise because of its reputation for causing food poisoning, but commercially produced mayo packets are incredibly stable"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 2178,
                "end_index": 2252,
                "part_index": null,
                "text": "* **Pasteurization:** Commercial mayonnaise is made using pasteurized eggs"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                12
              ],
              "segment": {
                "start_index": 2403,
                "end_index": 2571,
                "part_index": null,
                "text": "* **High Acid Content:** Like ketchup, commercial mayonnaise contains high levels of vinegar or lemon juice, which lowers its pH and makes it highly hostile to bacteria"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 2573,
                "end_index": 2686,
                "part_index": null,
                "text": "* **The \"Single-Use\" Advantage:** When you buy a jar of mayonnaise, you have to refrigerate it *after* opening it"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                13
              ],
              "segment": {
                "start_index": 2688,
                "end_index": 2823,
                "part_index": null,
                "text": "This is because opening the jar introduces room-temperature air, moisture, and potentially dirty spoons or knives (cross-contamination)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                11
              ],
              "segment": {
                "start_index": 2825,
                "end_index": 2973,
                "part_index": null,
                "text": "Because mayo packets are **single-use**, they are completely sterile inside until the exact second you tear them open, use them, and throw them away"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2989,
                "end_index": 3106,
                "part_index": null,
                "text": "The Power of \"Aseptic\" Packaging\nThe plastic and foil laminate used to make condiment packets is highly sophisticated"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                10
              ],
              "segment": {
                "start_index": 3109,
                "end_index": 3194,
                "part_index": null,
                "text": "* **Zero Oxygen:** The packets are filled and sealed in a sterile factory environment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 3196,
                "end_index": 3299,
                "part_index": null,
                "text": "Because there is no air inside, aerobic bacteria (which require oxygen to grow) and mold cannot survive"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 3301,
                "end_index": 3386,
                "part_index": null,
                "text": "* **Light and Vapor Barrier:** The packaging completely blocks out light and moisture"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 3526,
                "end_index": 3620,
                "part_index": null,
                "text": "### Summary\nWhile **sour cream packets must always be kept cold** because they are fresh dairy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                11,
                12
              ],
              "segment": {
                "start_index": 3526,
                "end_index": 3831,
                "part_index": null,
                "text": "### Summary\nWhile **sour cream packets must always be kept cold** because they are fresh dairy, **ketchup and mayo packets stay fresh at room temperature** because they are pasteurized, highly acidic, and vacuum-sealed in single-use packets that keep out all bacteria and air until the moment you use them"
              },
              "rendered_parts": null
            }
          ],
