          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": null,
                "end_index": 186,
                "part_index": null,
                "text": "While it is a common belief that all single-serve condiment packets are shelf-stable, there is actually a major exception to this rule: **sour cream packets must always be refrigerated**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 197,
                "end_index": 379,
                "part_index": null,
                "text": "The Big Exception: Sour Cream Packets **Do** Need Refrigeration\nUnlike ketchup or mayonnaise, real sour cream is a fresh dairy product with high moisture content and very low acidity"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 382,
                "end_index": 512,
                "part_index": null,
                "text": "* **Live Cultures:** Sour cream relies on live, active lactic acid bacteria to give it its thick texture and signature tangy taste"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 514,
                "end_index": 664,
                "part_index": null,
                "text": "Because of this, it cannot be heavily sterilized or pasteurized to a shelf-stable state, as doing so would kill the good bacteria and ruin the product"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 666,
                "end_index": 789,
                "part_index": null,
                "text": "* **Bacterial Growth:** At room temperature, harmful bacteria like *Listeria* or *Salmonella* can quickly multiply in dairy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3,
                1
              ],
              "segment": {
                "start_index": 792,
                "end_index": 978,
                "part_index": null,
                "text": "* **The Reality of Packets:** Any real sour cream packets you get (such as at Wendy's, Taco Bell, or in home meal kits) are stored in refrigerators or on ice until they are handed to you"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 1164,
                "end_index": 1361,
                "part_index": null,
                "text": "### Why Ketchup and Mayonnaise Packets Don't Need Refrigeration\nOn the other hand, unopened packets of ketchup and mayonnaise can sit in your kitchen drawer or glove box for months without spoiling"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                6
              ],
              "segment": {
                "start_index": 1558,
