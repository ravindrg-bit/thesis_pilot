              "segment": {
                "start_index": 604,
                "end_index": 798,
                "part_index": null,
                "text": "Supplement Doses\nTo understand how much you need versus how much you might be taking:\n*   **Recommended Dietary Allowance (RDA):** The daily recommendation for adults is **2.4 micrograms (mcg)**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 800,
                "end_index": 883,
                "part_index": null,
                "text": "This increases slightly to 2.6 mcg during pregnancy and 2.8 mcg while breastfeeding"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 885,
                "end_index": 1067,
                "part_index": null,
                "text": "*   **Typical Supplement Doses:** Over-the-counter B12 supplements often contain **1,000 mcg to 5,000 mcg** per serving\u2014which is tens of thousands of times the daily recommendation"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
