              ],
              "segment": {
                "start_index": 4037,
                "end_index": 4239,
                "part_index": null,
                "text": "Instead of launching one massive satellite, companies like SpaceX (Starlink) and Amazon (Project Kuiper) deploy thousands of highly coordinated, mass-produced small satellites into Low Earth Orbit (LEO)"
              },
              "rendered_parts": null
            }
