          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 177,
                "part_index": null,
                "text": "Traditionally, **sovereignty** is defined as the supreme, absolute, and independent authority of a state to govern its own territory and population without external interference"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                2
              ],
              "segment": {
                "start_index": 179,
                "end_index": 386,
                "part_index": null,
                "text": "Established primarily by the Peace of Westphalia in 1648, this classical view was rooted in physical geography: a state was sovereign if it could control its physical borders and enforce its laws within them"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 464,
                "end_index": 590,
                "part_index": null,
                "text": "In a highly globalized, digitized, and interconnected world, physical borders are no longer a shield against outside influence"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                4
              ],
              "segment": {
                "start_index": 592,
                "end_index": 816,
                "part_index": null,
                "text": "Sovereignty is no longer viewed as absolute, but rather as a dynamic exercise in **strategic autonomy**\u2014the ability of a nation to protect its values, resources, and systems while remaining deeply entangled in a global web"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 905,
                "end_index": 1037,
                "part_index": null,
                "text": "Digital and Technological Sovereignty\nThe most fiercely contested frontier of modern sovereignty is not land, but the digital sphere"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 1039,
                "end_index": 1204,
                "part_index": null,
                "text": "Digital sovereignty is a state\u2019s ability to control its own data, digital infrastructure, software, and artificial intelligence without relying on foreign entities"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 1207,
                "end_index": 1341,
                "part_index": null,
                "text": "* **Data Borders and Cloud Infrastructure:** Countries are increasingly legislating where their citizens' data is stored and processed"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 1344,
                "end_index": 1547,
                "part_index": null,
                "text": "* **The Legislative Push:** In June 2026, the European Commission introduced its landmark **Tech Sovereignty Package**, which includes the *Cloud and AI Development Act (CADA)* and an updated *Chips Act*"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 1549,
                "end_index": 1715,
                "part_index": null,
                "text": "These laws aim to aggressively scale domestic cloud and AI capacity to reduce reliance on foreign tech giants, particularly those based in the United States and China"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1731,
                "end_index": 1845,
                "part_index": null,
                "text": "Big Tech:** Multinational tech corporations often wield more power, capital, and influence than many nation-states"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1847,
                "end_index": 2054,
                "part_index": null,
                "text": "Governments are increasingly clashing with these platforms (such as the high-profile regulatory battles and suspensions of platforms like X in Brazil) to reassert state authority over the digital town square"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 2064,
                "end_index": 2356,
                "part_index": null,
                "text": "Economic Sovereignty and \"Strategic Autonomy\"\nThe era of hyper-globalization\u2014where states gladly outsourced manufacturing to wherever was cheapest\u2014has given way to an era of \"de-risking\" and \"friend-shoring.\" Today, economic sovereignty means securing supply chains for critical resources"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
