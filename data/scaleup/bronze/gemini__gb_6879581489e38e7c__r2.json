              "segment": {
                "start_index": 562,
                "end_index": 676,
                "part_index": null,
                "text": "* **Why you\u2019ll love it:** This is the brand-new sci-fi series by the exact same writing duo behind *The Expanse*"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2
              ],
              "segment": {
                "start_index": 766,
                "end_index": 879,
                "part_index": null,
                "text": "The story begins on a human colony planet that is suddenly conquered by an ancient alien empire called the Carryx"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                3
              ],
              "segment": {
                "start_index": 881,
                "end_index": 998,
                "part_index": null,
                "text": "Humans are taken captive, and a group of scientists must figure out how to survive and remain useful to their captors"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                4
              ],
              "segment": {
                "start_index": 1000,
                "end_index": 1095,
                "part_index": null,
                "text": "It features the same brilliant, character-driven multi-POV writing and masterful world-building"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                3
              ],
              "segment": {
                "start_index": 1097,
                "end_index": 1166,
                "part_index": null,
                "text": "Best of all, the sequel, ***The Faith of Beasts***, was just released"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 3617,
                "end_index": 3766,
                "part_index": null,
                "text": "It follows Mahit Dzmare, a young ambassador from a small independent mining station who is sent to the capital of a massive, planet-conquering empire"
              },
              "rendered_parts": null
            }
