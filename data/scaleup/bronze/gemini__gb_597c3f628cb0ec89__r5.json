              "segment": {
                "start_index": 2720,
                "end_index": 2889,
                "part_index": null,
                "text": "*   **The ICCPR Treaty:** The International Covenant on Civil and Political Rights (ICCPR) actually contains a provision (Article 15) affirming the right to *lex mitior*"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 2891,
                "end_index": 3003,
                "part_index": null,
                "text": "However, when the United States ratified the treaty, it officially made a \"reservation\" to this specific article"
