              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 1102,
                "end_index": 1253,
                "part_index": null,
                "text": "* **Fever and Chills (The Thermostat Reset):** When you run a fever, your brain's \"thermostat\" (the hypothalamus) resets to a higher target temperature"
