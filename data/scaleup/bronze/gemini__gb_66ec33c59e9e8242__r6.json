              "web": {
                "domain": null,
                "title": "clevelandclinic.org",
                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQH62Khz7ZTO9Y7onR2u8QOeQRfii5islc_wu_4gNRFfMy_yGqX7LxDSCMjCno6TmmtWopWRpcbqK_TYcxHOXjFq2SG398jBTePDMY9dXftUkVirvdOx_wmYbKJOAUGuxbHIHzy5DfYxD-UzYA7e6ASbUHQr"
