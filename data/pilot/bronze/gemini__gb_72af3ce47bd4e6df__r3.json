            }
          ],
          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 112,
                "part_index": null,
                "text": "The destruction of hundreds of contemporary and modern artworks in the **Momart warehouse fire of May 24, 2004**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": null,
                "end_index": 247,
                "part_index": null,
                "text": "The destruction of hundreds of contemporary and modern artworks in the **Momart warehouse fire of May 24, 2004**, was a massive financial disaster, resulting in insurance claims and legal settlements estimated between \u00a330 million and \u00a350 million"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                3
              ],
              "segment": {
                "start_index": 754,
                "end_index": 826,
                "part_index": null,
                "text": "The fire destroyed seminal works of the **Young British Artists (YBAs)**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                4
              ],
              "segment": {
                "start_index": 754,
                "end_index": 897,
                "part_index": null,
                "text": "The fire destroyed seminal works of the **Young British Artists (YBAs)**, alongside highly significant pieces of 20th-century British modernism"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                6
              ],
              "segment": {
                "start_index": 980,
                "end_index": 1100,
                "part_index": null,
                "text": "Most famous among them were Tracey Emin\u2019s *Everyone I Have Ever Slept With 1963\u20131995* (famously known as \"The Tent\")"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                7
              ],
              "segment": {
                "start_index": 980,
                "end_index": 1176,
                "part_index": null,
                "text": "Most famous among them were Tracey Emin\u2019s *Everyone I Have Ever Slept With 1963\u20131995* (famously known as \"The Tent\") and Jake and Dinos Chapman\u2019s monumental, detail-obsessed sculpture *Hell*"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                8
              ],
              "segment": {
                "start_index": 1178,
                "end_index": 1297,
                "part_index": null,
                "text": "These were not just physical objects; they were the physical anchors of the \"Sensation\" era that defined Cool Britannia"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                9
              ],
              "segment": {
                "start_index": 1299,
                "end_index": 1384,
                "part_index": null,
                "text": "* **Deceased Artists:** While living YBAs could theoretically continue producing work"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 1457,
                "end_index": 1541,
                "part_index": null,
                "text": "Over 50 major paintings by the abstract pioneer **Patrick Heron** (who died in 1999)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                9
              ],
              "segment": {
                "start_index": 1457,
                "end_index": 1607,
                "part_index": null,
                "text": "Over 50 major paintings by the abstract pioneer **Patrick Heron** (who died in 1999) and key final sculptures by **Helen Chadwick** (who died in 1996)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 1624,
                "end_index": 1737,
                "part_index": null,
                "text": "Heron's daughters described the loss of his paintings as \"another bereavement\" and a \"national artistic tragedy.\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 1624,
                "end_index": 1858,
                "part_index": null,
                "text": "Heron's daughters described the loss of his paintings as \"another bereavement\" and a \"national artistic tragedy.\" These works were physically irreplaceable, representing a permanent, blank space in the lineage of British modernist art"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 2082,
                "end_index": 2343,
                "part_index": null,
                "text": "The differing responses of the artists involved proved that physical form and the moment of creation still carry sacred weight:\n* **Tracey Emin's Refusal:** Charles Saatchi offered Emin \u00a31 million (the equivalent of the insurance payout) to recreate *The Tent*"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                10
              ],
              "segment": {
                "start_index": 2345,
                "end_index": 2536,
                "part_index": null,
                "text": "Emin flatly refused, stating that \"to recreate it would have been morally wrong\" because a replica would lack the original \"emotional input\" and \"spirit\" of the moment in which she created it"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 2538,
                "end_index": 2599,
                "part_index": null,
                "text": "To Emin, the tent was a diary of a specific epoch in her life"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                9
              ],
              "segment": {
                "start_index": 3005,
                "end_index": 3155,
                "part_index": null,
                "text": "These contrasting reactions demonstrated that contemporary art is not a monolith; for some artists, the physical \"relic\" is spiritually non-negotiable"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                9
              ],
              "segment": {
                "start_index": 3236,
                "end_index": 3346,
                "part_index": null,
                "text": "A Mirror of British Culture Wars\nThe sociological aftermath of the fire exposed a deep rift in British society"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                9,
                12
              ],
              "segment": {
                "start_index": 3350,
                "end_index": 3520,
                "part_index": null,
                "text": "When news of the fire broke, British tabloid media and segments of the general public responded not with mourning, but with **malicious glee and mockery (schadenfreude)**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                9
              ],
              "segment": {
                "start_index": 3522,
                "end_index": 3688,
                "part_index": null,
                "text": "Tabloids ran headlines celebrating the incineration of \"rubbish,\" reflecting a populist resentment toward the intellectual and financial elite of the London art scene"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                12
              ],
              "segment": {
                "start_index": 3690,
                "end_index": 3922,
                "part_index": null,
                "text": "Prominent critics, such as Brian Sewell, pointed out that the public joy only cooled when it became known that traditional abstract painters like Patrick Heron\u2014whose work was more widely respected\u2014had also been lost in the blaze"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 3925,
                "end_index": 4082,
                "part_index": null,
                "text": "This hostile public reaction illustrated that the YBA movement, for all its international acclaim, had deeply alienated a large portion of the British public"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                12,
                13
              ],
              "segment": {
                "start_index": 4084,
                "end_index": 4289,
                "part_index": null,
                "text": "The fire became a cultural Rorschach test: to the art establishment, it was a tragedy; to many ordinary citizens, it was a humorous, self-inflicted cosmic joke on wealthy collectors and pretentious artists"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 4297,
                "end_index": 4416,
                "part_index": null,
                "text": "### Conclusion\nUltimately, the Momart warehouse fire was far more than a write-off on Charles Saatchi\u2019s balance sheet"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                9
              ],
              "segment": {
                "start_index": 4418,
                "end_index": 4519,
                "part_index": null,
                "text": "It was a **cultural trauma** that permanently erased key physical milestones of late-20th-century art"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 4521,
                "end_index": 4644,
                "part_index": null,
                "text": "It acted as a philosophical boundary-testing event that forced artists to define the limits of replication and authenticity"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 4646,
                "end_index": 4763,
                "part_index": null,
                "text": "Finally, it exposed the raw, unresolved class and cultural friction between the contemporary art world and the public"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
