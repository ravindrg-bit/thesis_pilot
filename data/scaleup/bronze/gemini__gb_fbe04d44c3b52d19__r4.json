              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 394,
                "end_index": 479,
                "part_index": null,
                "text": "* Your **vocal folds** (vocal cords) are pulled together (adducted) across the airway"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                3,
                4
              ],
              "segment": {
                "start_index": 481,
                "end_index": 641,
                "part_index": null,
                "text": "* As air forces its way through the closed vocal folds, they act like double reeds, rapidly vibrating open and closed (oscillating) hundreds of times per second"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 644,
                "end_index": 781,
                "part_index": null,
