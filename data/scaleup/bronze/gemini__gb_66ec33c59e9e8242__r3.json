          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 216,
                "part_index": null,
                "text": "That \"sickly green\" or pale look we get when we're ill is a fascinating combination of **cardiovascular physics** (how your body redirects blood flow) and **color theory** (how your skin tone and eyes perceive light)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 302,
                "end_index": 491,
                "part_index": null,
                "text": "Why We Turn Pale (The Physiology)\nThe primary reason you lose your healthy flush when sick\u2014especially when nauseous, running a fever, or in pain\u2014is a process called **vasoconstriction**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 494,
                "end_index": 658,
                "part_index": null,
                "text": "* **The Fight-or-Flight Response:** When your body detects a threat (like a virus, a toxin, or severe nausea), your autonomic nervous system goes into survival mode"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 660,
                "end_index": 788,
                "part_index": null,
                "text": "It releases stress hormones like adrenaline, which tell the blood vessels near the surface of your skin to tighten and constrict"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                4
              ],
              "segment": {
                "start_index": 791,
                "end_index": 1029,
                "part_index": null,
                "text": "* **Redirection of Blood:** Your body pulls blood away from \"non-essential\" areas like your face, fingers, and toes, and redirects it to your vital internal organs (like your heart, brain, and lungs) and the muscles fighting the infection"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                6
              ],
              "segment": {
                "start_index": 1032,
                "end_index": 1183,
                "part_index": null,
                "text": "* **The Loss of Red Pigment:** Oxygen-rich blood contains **hemoglobin**, which is bright red and gives human skin its warm, healthy, pinkish undertone"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                1
              ],
              "segment": {
                "start_index": 1185,
                "end_index": 1311,
                "part_index": null,
                "text": "When vasoconstriction drains the blood from your face, you lose that red pigment, leaving your skin looking pale or washed out"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                4
              ],
              "segment": {
                "start_index": 1313,
                "end_index": 1412,
                "part_index": null,
                "text": "* **Dehydration:** When you are sick, you often lose fluids through sweating, vomiting, or diarrhea"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                8,
                9
              ],
              "segment": {
                "start_index": 1414,
                "end_index": 1496,
                "part_index": null,
                "text": "This reduces your overall blood volume, making you look even more drained and pale"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                1,
                11
              ],
              "segment": {
                "start_index": 1511,
                "end_index": 1716,
                "part_index": null,
                "text": "Why We Turn \"Green\" (The Optical Illusion)\nWhile you might not turn literally *lime green* like a cartoon character, people with nausea or sudden sickness frequently develop a noticeable greenish-gray tint"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                13
              ],
              "segment": {
                "start_index": 1775,
                "end_index": 1926,
                "part_index": null,
                "text": "#### Color Subtraction (Yellow + Blue = Green)\nYour skin has several layers of natural pigment, including brown and yellow tones (melanin and carotene)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 1928,
                "end_index": 2066,
                "part_index": null,
                "text": "Beneath these layers sit your veins, which carry deoxygenated blood and appear blue or purple because of how light scatters through tissue"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                1
              ],
              "segment": {
                "start_index": 2069,
                "end_index": 2244,
                "part_index": null,
                "text": "* **Healthy skin:** Red, oxygenated blood flows heavily through the capillaries, mixing with the yellow of your skin and blue of your veins to create a warm, lively complexion"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                1
              ],
              "segment": {
                "start_index": 2246,
                "end_index": 2428,
                "part_index": null,
                "text": "* **Sick skin:** When vasoconstriction suddenly sucks the red blood out of the equation, you are left with only the yellow pigments of your skin and the blue of your underlying veins"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 2430,
                "end_index": 2493,
                "part_index": null,
                "text": "Basic color theory tells us that **yellow and blue make green**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                11
              ],
              "segment": {
                "start_index": 2495,
                "end_index": 2574,
                "part_index": null,
                "text": "This is especially prominent in people with olive, warm, or tan skin undertones"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                14
              ],
              "segment": {
                "start_index": 2577,
                "end_index": 2684,
                "part_index": null,
                "text": "#### Brain and Visual Contrast\nThe human brain is highly evolved to read faces and detect changes in health"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 2686,
                "end_index": 2820,
                "part_index": null,
                "text": "Because green is the exact complementary (opposite) color of red on the color wheel, your eyes are highly sensitive to a \"red deficit\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                11
              ],
              "segment": {
                "start_index": 2822,
                "end_index": 2989,
                "part_index": null,
                "text": "When the red flush suddenly vanishes from someone's face, your brain overcompensates by perceiving the remaining, desaturated skin tone as distinctly \"green\" or \"gray\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15,
                16
              ],
              "segment": {
                "start_index": 3118,
                "end_index": 3235,
                "part_index": null,
                "text": "Up until the 19th century, doctors diagnosed a condition called **chlorosis**, commonly known as **\"green sickness\"**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17,
                16
              ],
              "segment": {
                "start_index": 3239,
                "end_index": 3301,
                "part_index": null,
                "text": "Today, we know this was actually severe **hypochromic anemia**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17,
                6
              ],
              "segment": {
                "start_index": 3303,
                "end_index": 3404,
                "part_index": null,
                "text": "Because of a severe lack of iron, the body couldn't produce enough hemoglobin (which makes blood red)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17,
                16
              ],
              "segment": {
                "start_index": 3406,
                "end_index": 3543,
                "part_index": null,
                "text": "The red blood cells of these patients were so pale and depleted of red pigment that their skin took on a stark, waxy, greenish-yellow hue"
              },
              "rendered_parts": null
            }
          ],
