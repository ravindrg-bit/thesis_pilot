                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFDfEyVnb6NCN4mP_fBGmDeT-SXnfp4bxujd97YqsPIWvaKeEIzQs-uyLshtnfQfd2TXTzqL1l5paPDao5n6aNb2mdL2rXu7rRzy9zel3UEY-ZSZZRO-2t8RogHGjnYKnat_No4FoAz9tGrT2Tdh9XvSZpJ73vZUAcMCSi2Av9r5xc07_R9dpGgWl6hxsX0TWiacE1IHUP2twxCBzk="
