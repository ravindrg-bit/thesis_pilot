              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 3227,
                "end_index": 3293,
                "part_index": null,
                "text": "Our brains are incredibly sensitive to subtle shifts in skin color"
              },
              "rendered_parts": null
            },
            {
