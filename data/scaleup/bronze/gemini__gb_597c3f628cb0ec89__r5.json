              ],
              "segment": {
                "start_index": 1526,
                "end_index": 1725,
                "part_index": null,
                "text": "However, many U.S. states (and Canada initially) legalized cannabis *without* including these retroactive clauses, leaving past offenders behind bars until separate legislation was passed years later"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1727,
                "end_index": 1894,
                "part_index": null,
                "text": "*   **Executive Clemency (Pardons and Commutations):** A President or Governor can use their executive power to pardon individuals or commute (shorten) their sentences"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                3
              ],
              "segment": {
                "start_index": 1990,
                "end_index": 2118,
                "part_index": null,
                "text": "However, this is an active political decision by the executive branch; it does not happen automatically through the court system"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
