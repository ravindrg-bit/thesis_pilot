              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 2040,
                "end_index": 2164,
                "part_index": null,
                "text": "* **Poori Masala:** Often **includes chopped tomatoes**, which cook down to add a subtle tanginess and moisture to the gravy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
