          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 191,
                "part_index": null,
                "text": "A **Custodial IRA** (Individual Retirement Account) is a tax-advantaged retirement savings account that an adult (usually a parent or grandparent) opens and manages on behalf of a minor child"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                1
              ],
              "segment": {
                "start_index": 195,
                "end_index": 327,
                "part_index": null,
                "text": "Because minors cannot legally open brokerage accounts or enter into binding financial contracts, the adult acts as the **custodian**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 329,
                "end_index": 572,
                "part_index": null,
                "text": "The custodian manages the investments and makes decisions for the account until the child reaches the age of majority (usually 18 or 21, depending on state law), at which point full control of the account is officially transferred to the child"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 622,
                "end_index": 742,
                "part_index": null,
                "text": "The Earned Income Rule\nThis is the most critical rule for opening a Custodial IRA: **the child must have earned income**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                0
              ],
              "segment": {
                "start_index": 745,
                "end_index": 938,
                "part_index": null,
                "text": "* **What counts:** Wages from a W-2 part-time job (like working at a grocery store or lifeguarding) or self-employment income from informal jobs (like babysitting, mowing lawns, or dog walking)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 940,
                "end_index": 1012,
                "part_index": null,
                "text": "* **What does NOT count:** Allowances, investment returns, or cash gifts"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1024,
                "end_index": 1106,
                "part_index": null,
                "text": "The contributed money does not have to physically come from the child\u2019s paycheck"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                4
              ],
              "segment": {
                "start_index": 1108,
                "end_index": 1288,
                "part_index": null,
                "text": "A parent or grandparent can contribute their own cash to the account as a \"match\" or gift, as long as the total contributed does not exceed what the child actually earned that year"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                0
              ],
              "segment": {
                "start_index": 1299,
                "end_index": 1462,
                "part_index": null,
                "text": "Contribution Limits\nThe maximum amount that can be contributed to a Custodial IRA each year is the lesser of:\n* **The child\u2019s total earned income** for that year"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1464,
                "end_index": 1499,
                "part_index": null,
                "text": "* **The annual IRS limit** for IRAs"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1504,
                "end_index": 1528,
                "part_index": null,
                "text": "* **2025 Limit:** $7,000"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1504,
                "end_index": 1555,
                "part_index": null,
                "text": "* **2025 Limit:** $7,000\n  * **2026 Limit:** $7,500"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1568,
                "end_index": 1685,
                "part_index": null,
                "text": "If a teenager earns $3,000 mowing lawns in 2026, the maximum that can be contributed to their Custodial IRA is $3,000"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                0
              ],
              "segment": {
                "start_index": 1687,
                "end_index": 1792,
                "part_index": null,
                "text": "If they work a summer job and earn $10,000, the maximum contribution is capped at the IRS limit of $7,500"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1819,
                "end_index": 1952,
                "part_index": null,
                "text": "Roth Custodial IRAs\nJust like standard adult IRAs, you can choose between two main types, though one is almost always better for kids"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1819,
                "end_index": 2040,
                "part_index": null,
                "text": "Roth Custodial IRAs\nJust like standard adult IRAs, you can choose between two main types, though one is almost always better for kids:\n* **Custodial Roth IRA (Most Popular):** Contributions are made with after-tax dollars"
              },
