          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 448,
                "end_index": 547,
                "part_index": null,
                "text": "Cli-Fi (Climate Fiction)\n* **When it emerged:** The term was coined by journalist Dan Bloom in 2007"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 448,
                "end_index": 624,
                "part_index": null,
                "text": "Cli-Fi (Climate Fiction)\n* **When it emerged:** The term was coined by journalist Dan Bloom in 2007 and grew into a widely recognized academic and commercial genre in the 2010s"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 627,
                "end_index": 857,
                "part_index": null,
                "text": "* **What it is:** While speculative stories about natural disasters have existed for a long time, Cli-Fi is specifically focused on the realities, anxieties, and human impacts of modern, anthropogenic (human-caused) climate change"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 859,
                "end_index": 1036,
                "part_index": null,
                "text": "Unlike traditional sci-fi, which often features far-off alien planets, Cli-Fi is grounded in climate science and usually set in the near-future or a visibly transforming present"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 1038,
                "end_index": 1111,
                "part_index": null,
                "text": "* **Key Examples:** *The Ministry for the Future* by Kim Stanley Robinson"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1038,
                "end_index": 1146,
                "part_index": null,
                "text": "* **Key Examples:** *The Ministry for the Future* by Kim Stanley Robinson, *The Overstory* by Richard Powers"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 1156,
                "end_index": 1259,
                "part_index": null,
                "text": "LitRPG (Literary Role-Playing Game)\n* **When it emerged:** The formal term was coined in Russia in 2013"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                9
              ],
              "segment": {
                "start_index": 1156,
                "end_index": 1346,
                "part_index": null,
                "text": "LitRPG (Literary Role-Playing Game)\n* **When it emerged:** The formal term was coined in Russia in 2013, heavily influenced by Japanese light novels and Korean web novels from the late 2000s"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 1348,
                "end_index": 1413,
                "part_index": null,
                "text": "It became a global publishing phenomenon in the mid-to-late 2010s"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 1415,
                "end_index": 1671,
                "part_index": null,
                "text": "* **What it is:** A subgenre of speculative fiction where the mechanics of tabletop or computer role-playing games (like leveling up, quest logs, and explicit character stats like \"strength\" or \"dexterity\") are a literal, visible reality for the characters"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 1673,
                "end_index": 1768,
                "part_index": null,
                "text": "Protagonists are usually aware of these \"game rules\" and must strategically level up to survive"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 1770,
                "end_index": 1829,
                "part_index": null,
                "text": "* **Key Examples:** *Dungeon Crawler Carl* by Matt Dinniman"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                12
              ],
              "segment": {
                "start_index": 1884,
                "end_index": 1959,
                "part_index": null,
                "text": "Solarpunk\n* **When it emerged:** The term was coined in a blog post in 2008"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 1884,
                "end_index": 2109,
                "part_index": null,
                "text": "Solarpunk\n* **When it emerged:** The term was coined in a blog post in 2008, with the first official literary anthology (*Solarpunk: Hist\u00f3rias Ecol\u00f3gicas e Fant\u00e1sticas em um Mundo Sustent\u00e1vel*) published in Brazil in 2012"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2112,
                "end_index": 2218,
                "part_index": null,
                "text": "* **What it is:** A direct, optimistic rebellion against the bleak, high-tech/low-life nature of cyberpunk"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                14
              ],
              "segment": {
                "start_index": 2220,
                "end_index": 2380,
                "part_index": null,
                "text": "Solarpunk focuses on speculative futures where humanity has successfully solved the climate crisis and lives in harmony with nature, powered by renewable energy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15,
                11
              ],
              "segment": {
                "start_index": 2382,
                "end_index": 2458,
                "part_index": null,
                "text": "It emphasizes community, eco-aesthetics, and Do-It-Yourself (DIY) technology"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2460,
                "end_index": 2526,
                "part_index": null,
                "text": "* **Key Examples:** *A Psalm for the Wild-Built* by Becky Chambers"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16
              ],
              "segment": {
                "start_index": 2536,
                "end_index": 2645,
                "part_index": null,
                "text": "Instapoetry\n* **When it emerged:** Early 2010s, parallel with the rise of the social media platform Instagram"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                17
              ],
              "segment": {
                "start_index": 2647,
                "end_index": 2753,
                "part_index": null,
                "text": "* **What it is:** A genre of poetry defined by its extreme brevity, accessibility, and visual presentation"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                17,
                18
              ],
              "segment": {
                "start_index": 2755,
                "end_index": 2932,
                "part_index": null,
                "text": "Designed to be consumed quickly on mobile screens, Instapoems are typically short, free-verse, minimalist pieces paired with simple, elegant line drawings or distinct typography"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                19,
                18
              ],
              "segment": {
                "start_index": 2935,
                "end_index": 2984,
                "part_index": null,
                "text": "* **Key Examples:** *Milk and Honey* by Rupi Kaur"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17
              ],
              "segment": {
                "start_index": 2935,
                "end_index": 3008,
                "part_index": null,
                "text": "* **Key Examples:** *Milk and Honey* by Rupi Kaur, the works of Lang Leav"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17
              ],
              "segment": {
                "start_index": 2935,
                "end_index": 3020,
                "part_index": null,
                "text": "* **Key Examples:** *Milk and Honey* by Rupi Kaur, the works of Lang Leav and Atticus"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                20,
                21
              ],
              "segment": {
                "start_index": 3030,
                "end_index": 3367,
                "part_index": null,
                "text": "Chat Fiction / Text-Talk Novels\n* **When it emerged:** Roots trace back to the Japanese *Keitai Shosetsu* (cell phone novels) of the early 2000s, but it evolved globally in the 2010s into \"chat fiction.\"\n* **What it is:** Stories told entirely through the medium of simulated instant messages, text-chat screenshots, or discussion boards"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                20
              ],
              "segment": {
                "start_index": 3369,
                "end_index": 3494,
                "part_index": null,
                "text": "It mimics the pacing, shorthand, and multimedia elements of modern digital communication to build suspense, humor, or romance"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 4151,
                "end_index": 4438,
                "part_index": null,
                "text": "*(Note: While some genres like **Autofiction**\u2014novels that heavily blur the lines between autobiography and fiction\u2014and **New Weird** were technically coined in the late 20th century, they only truly solidified into massive, distinct, and dominant literary movements during the 2010s"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
          "search_entry_point": {
