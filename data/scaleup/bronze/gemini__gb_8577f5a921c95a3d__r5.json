                0,
                3
              ],
              "segment": {
                "start_index": 245,
                "end_index": 388,
                "part_index": null,
                "text": "However, astronomers using space telescopes like Kepler and TESS have confirmed that these planets are not only real, but actually quite common"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 391,
                "end_index": 528,
                "part_index": null,
