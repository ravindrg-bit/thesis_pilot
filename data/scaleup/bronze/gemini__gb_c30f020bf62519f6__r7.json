          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": null,
                "end_index": 179,
                "part_index": null,
                "text": "Preventing burnout is not just about practicing \"self-care\" or working fewer hours; it requires a combination of **individual strategies** and **systemic, organizational changes**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 183,
                "end_index": 322,
                "part_index": null,
                "text": "The World Health Organization (WHO) classifies burnout as an **occupational phenomenon** resulting from chronic, unmanaged workplace stress"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 324,
                "end_index": 477,
                "part_index": null,
                "text": "It is characterized by physical and emotional exhaustion, feelings of cynicism or detachment from one's job, and a sense of reduced professional efficacy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                2
              ],
              "segment": {
                "start_index": 480,
                "end_index": 592,
                "part_index": null,
                "text": "Preventing burnout requires actions you can take personally, alongside strategies for managers and organizations"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 653,
                "end_index": 810,
                "part_index": null,
                "text": "While you cannot always control systemic workplace issues, focusing on what is within your control can help you build resilience and maintain your well-being"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 821,
                "end_index": 902,
                "part_index": null,
                "text": "Set Firm, Clear Boundaries\n* **Digital Detachment:** Establish strict \"off-hours\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1366,
                "end_index": 1467,
                "part_index": null,
                "text": "Can we prioritize this for next week, or is there something else I should drop to make room for it?\"*"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 1477,
                "end_index": 1562,
                "part_index": null,
                "text": "Reclaim Your Sense of Agency\n* Extreme stress can make you feel helpless or powerless"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 1564,
                "end_index": 1622,
                "part_index": null,
                "text": "Shift your perspective toward **action and self-efficacy**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                4
              ],
              "segment": {
                "start_index": 1624,
                "end_index": 1815,
                "part_index": null,
                "text": "Focus on problem-solving: identify what is causing you stress and actively brainstorm steps you can take to address it\u2014such as requesting a meeting to clarify your role or delegating a task"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 1951,
                "end_index": 1994,
                "part_index": null,
                "text": "Take 5-to-10-minute breaks every 90 minutes"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 1996,
                "end_index": 2049,
                "part_index": null,
                "text": "Step away from screens, stretch, or take a short walk"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 2126,
                "end_index": 2219,
                "part_index": null,
                "text": "Taking consecutive days off to fully disconnect is essential for your nervous system to reset"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 2340,
                "end_index": 2431,
                "part_index": null,
                "text": "Prioritize 7\u20138 hours of quality sleep and eat nourishing foods to keep your energy stable"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 2433,
                "end_index": 2555,
                "part_index": null,
                "text": "* **Movement:** Regular exercise acts as a natural stress reliever by burning off excess cortisol and releasing endorphins"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9,
                7
              ],
              "segment": {
                "start_index": 2557,
                "end_index": 2686,
                "part_index": null,
                "text": "* **Mindfulness and Hobbies:** Engaging in mindfulness (even just 5 minutes of deep breathing) helps regulate your nervous system"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 2688,
                "end_index": 2790,
                "part_index": null,
                "text": "Cultivate hobbies outside of work to remind yourself that your identity is not solely tied to your job"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 2801,
                "end_index": 2918,
                "part_index": null,
                "text": "Ask for Help Early\n* If you feel your workload is becoming unmanageable, do not wait until you crash to say something"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 2920,
                "end_index": 3000,
                "part_index": null,
                "text": "Schedule a meeting with your manager to realistically assess your queue of tasks"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                9,
                11
              ],
              "segment": {
                "start_index": 3002,
                "end_index": 3124,
                "part_index": null,
                "text": "If you are struggling with chronic stress, anxiety, or feelings of hopelessness, reach out to a mental health professional"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 3207,
                "end_index": 3385,
                "part_index": null,
                "text": "According to Gallup, the primary drivers of burnout are systemic: unfair treatment, unmanageable workloads, unclear communication, lack of support, and unreasonable time pressure"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 3387,
                "end_index": 3450,
                "part_index": null,
                "text": "Managers and leadership must take proactive steps to prevent it"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 3461,
                "end_index": 3558,
                "part_index": null,
                "text": "Actively Manage Workloads\n* Regularly check in with team members regarding their current capacity"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                2
              ],
              "segment": {
                "start_index": 3661,
                "end_index": 3741,
                "part_index": null,
                "text": "* Avoid unrealistic deadlines that force employees to consistently work overtime"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 3863,
                "end_index": 3962,
                "part_index": null,
                "text": "Ensure employees know exactly what is expected of them and how their performance is being evaluated"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 3964,
                "end_index": 4132,
                "part_index": null,
                "text": "* **Create Psychological Safety:** Ensure team members feel safe expressing that they are overwhelmed without fear of professional penalty or being labeled \"unreliable\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 4143,
                "end_index": 4251,
                "part_index": null,
                "text": "Limit Micromanagement and Grant Autonomy\n* Micromanagement strips away employees' sense of control and trust"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                15
              ],
              "segment": {
                "start_index": 4253,
                "end_index": 4378,
                "part_index": null,
                "text": "Giving employees autonomy over *how* and *when* they do their work fosters a healthier work environment and higher engagement"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 4562,
                "end_index": 4711,
                "part_index": null,
                "text": "* Encourage team members to take their vacation days and actively respect their time off by not contacting them unless there is an absolute emergency"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 4756,
                "end_index": 4841,
                "part_index": null,
                "text": "Preventing burnout requires catching it in its early stages before it becomes chronic"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 4843,
                "end_index": 4925,
                "part_index": null,
                "text": "**Watch for these red flags:**\n* Feeling constantly exhausted, even after sleeping"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                15
              ],
              "segment": {
                "start_index": 4927,
                "end_index": 5007,
                "part_index": null,
                "text": "* Feeling cynical, irritable, or unusually detached from your work or colleagues"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                15
              ],
              "segment": {
                "start_index": 5009,
                "end_index": 5094,
                "part_index": null,
                "text": "* Experiencing \"brain fog,\" trouble concentrating, or a drop in your standard of work"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                11
              ],
              "segment": {
                "start_index": 5162,
                "end_index": 5245,
                "part_index": null,
                "text": "It is time to step back, communicate with your team or manager, and prioritize rest"
              },
              "rendered_parts": null
            }
          ],
