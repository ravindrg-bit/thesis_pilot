              "segment": {
                "start_index": 2892,
                "end_index": 3001,
                "part_index": null,
                "text": "**The Equipment:** You will need a satellite dish (a 30-to-35-inch dish for Ku-band signals in North America)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
