          ],
          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1,
                2
              ],
              "segment": {
                "start_index": 135,
                "end_index": 227,
                "part_index": null,
                "text": "Instead, it is the result of a physical phenomenon occurring inside the fluid of your joints"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                3,
                4
              ],
              "segment": {
                "start_index": 231,
                "end_index": 356,
                "part_index": null,
                "text": "Scientists have studied this for decades, and the consensus points to a process involving **gas bubbles in your joint fluid**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                6
              ],
              "segment": {
                "start_index": 372,
                "end_index": 484,
                "part_index": null,
                "text": "The Anatomy of a Knuckle\nYour knuckles\u2014specifically the *metacarpophalangeal joints*\u2014are **synovial joints**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 486,
                "end_index": 610,
                "part_index": null,
                "text": "The space where the bones meet is enclosed by a capsule filled with a thick, lubricating substance called **synovial fluid**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 612,
                "end_index": 695,
                "part_index": null,
                "text": "This fluid contains dissolved gases, primarily nitrogen, oxygen, and carbon dioxide"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                7
              ],
              "segment": {
                "start_index": 705,
                "end_index": 839,
                "part_index": null,
                "text": "The Pressure Drop\nWhen you pull, bend, or stretch your fingers to \"crack\" your knuckle, you pull the bones of the joint slightly apart"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                8
              ],
              "segment": {
                "start_index": 841,
                "end_index": 917,
                "part_index": null,
                "text": "This rapid separation increases the volume of space inside the joint capsule"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                9
              ],
              "segment": {
                "start_index": 921,
                "end_index": 1011,
                "part_index": null,
                "text": "Because the capsule is sealed, this increase in volume causes a **sharp drop in pressure**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                9,
                2
              ],
              "segment": {
                "start_index": 1054,
                "end_index": 1229,
                "part_index": null,
                "text": "Collapse\nThe sudden drop in pressure causes the dissolved gases to rapidly escape the synovial fluid and form a gas bubble (a process called *cavitation* or *tribonucleation*)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                10
              ],
              "segment": {
                "start_index": 1233,
                "end_index": 1342,
                "part_index": null,
                "text": "For years, scientists debated whether the sound came from the **formation** of the bubble or its **collapse**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                11
              ],
              "segment": {
                "start_index": 1233,
                "end_index": 1481,
                "part_index": null,
                "text": "For years, scientists debated whether the sound came from the **formation** of the bubble or its **collapse**:\n* **The 1971 Theory:** Researchers initially believed that the bubble completely collapsed (popped), and this implosion created the sound"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                13
              ],
              "segment": {
                "start_index": 1483,
                "end_index": 1570,
                "part_index": null,
                "text": "* **The 2015 MRI Breakthrough:** Researchers used real-time MRI to watch a finger crack"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                11
              ],
              "segment": {
                "start_index": 1572,
                "end_index": 1671,
                "part_index": null,
                "text": "They observed that the bubble actually *remained* in the joint for up to 20 minutes after the crack"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15
              ],
              "segment": {
                "start_index": 1673,
                "end_index": 1796,
                "part_index": null,
                "text": "Because the bubble didn't disappear, they concluded that the sound must be created by the rapid **formation** of the bubble"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                12
              ],
              "segment": {
                "start_index": 1798,
                "end_index": 1986,
                "part_index": null,
                "text": "* **The 2018 Solution (The Current Consensus):** To resolve this contradiction, researchers at Stanford University and \u00c9cole Polytechnique built a mathematical model of the fluid dynamics"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                14
              ],
              "segment": {
                "start_index": 1988,
                "end_index": 2075,
                "part_index": null,
                "text": "They proved that the sound is actually caused by the **partial collapse** of the bubble"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                14
              ],
              "segment": {
                "start_index": 2077,
                "end_index": 2209,
                "part_index": null,
                "text": "The acoustic wave generated by even a partial bubble implosion is loud enough to match the exact pitch and volume of a knuckle crack"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                14,
                11
              ],
              "segment": {
                "start_index": 2211,
                "end_index": 2316,
                "part_index": null,
                "text": "Because the collapse is only partial, the bubble survives, which explains why it is still visible on MRIs"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                13
              ],
              "segment": {
                "start_index": 2376,
                "end_index": 2466,
                "part_index": null,
                "text": "Once a knuckle is cracked, it enters a \"refractory period\" that lasts about **20 minutes**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                7
              ],
              "segment": {
                "start_index": 2468,
                "end_index": 2576,
                "part_index": null,
                "text": "You cannot crack the joint again during this time because the gas bubble is still sitting in the joint fluid"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                16
              ],
              "segment": {
                "start_index": 2578,
                "end_index": 2702,
                "part_index": null,
                "text": "It takes about 20 minutes for the gas to fully dissolve back into the synovial fluid and for the joint pressure to normalize"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                7,
                2
              ],
              "segment": {
                "start_index": 2742,
                "end_index": 2832,
                "part_index": null,
                "text": "Despite the popular \"old wives' tale,\" cracking your knuckles **does not cause arthritis**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                3
              ],
              "segment": {
                "start_index": 2834,
                "end_index": 3020,
                "part_index": null,
                "text": "Numerous studies (including one by a doctor who cracked the knuckles on only his left hand for over 50 years to compare them) have shown no link between knuckle cracking and joint damage"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1,
                7
              ],
              "segment": {
                "start_index": 3022,
                "end_index": 3162,
                "part_index": null,
                "text": "However, pulling or cracking your joints with extreme, painful force can occasionally lead to stretched ligaments or temporary hand swelling"
              },
              "rendered_parts": null
            }
          ],
