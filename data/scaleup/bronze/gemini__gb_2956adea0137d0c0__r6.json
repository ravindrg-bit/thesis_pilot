              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 1970,
                "end_index": 2112,
                "part_index": null,
                "text": "* **Streaming Only:** You can sign up via the SiriusXM website or app to get a free trial to listen on your phone, smart speakers, or computer"
