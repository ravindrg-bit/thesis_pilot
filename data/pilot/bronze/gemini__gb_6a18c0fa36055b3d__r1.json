          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 161,
                "end_index": 236,
                "part_index": null,
                "text": "Contrary to popular belief, **sour cream packets *do* require refrigeration"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 237,
                "end_index": 452,
                "part_index": null,
                "text": "** Sour cream is a fresh dairy product; even when sealed in single-serve packets (like those from meal kits or fast-food chains), it must be kept cold (at or below 40\u00b0F / 4\u00b0C) to prevent dangerous bacterial growth"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2
              ],
              "segment": {
                "start_index": 456,
                "end_index": 566,
                "part_index": null,
                "text": "However, **ketchup, mayonnaise, mustard, and hot sauce packets** can safely sit at room temperature for months"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                2
              ],
              "segment": {
                "start_index": 668,
                "end_index": 807,
                "part_index": null,
                "text": "The Airtight \"Fortress\" Seal (Barrier Packaging)\nAt home, standard bottles of ketchup and mayonnaise are shelf-stable *until* you open them"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 905,
                "end_index": 1030,
                "part_index": null,
                "text": "Single-serve packets are hermetically sealed in multi-layer laminated packaging (usually layers of plastic and aluminum foil)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1032,
                "end_index": 1159,
                "part_index": null,
                "text": "This specialized barrier completely blocks out:\n* **Oxygen:** Preventing oxidation, which causes food to spoil and change color"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2
              ],
              "segment": {
                "start_index": 1229,
                "end_index": 1315,
                "part_index": null,
                "text": "* **Microbes:** Keeping the sterile, factory-sealed environment inside entirely intact"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                2
              ],
              "segment": {
                "start_index": 1409,
                "end_index": 1581,
                "part_index": null,
                "text": "Both ketchup and mayonnaise are highly acidic:\n* **Ketchup** is formulated with tomato paste and a high concentration of vinegar (acetic acid), giving it a pH of around 3.9"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                2
              ],
              "segment": {
                "start_index": 1584,
                "end_index": 1678,
                "part_index": null,
                "text": "* **Commercial Mayonnaise** is made with vinegar and lemon juice, giving it a pH of around 4.0"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1682,
                "end_index": 1740,
                "part_index": null,
                "text": "This high acidity creates a chemically hostile environment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1742,
                "end_index": 1853,
                "part_index": null,
                "text": "Most foodborne pathogens simply cannot survive or reproduce in such acidic conditions, even at room temperature"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
