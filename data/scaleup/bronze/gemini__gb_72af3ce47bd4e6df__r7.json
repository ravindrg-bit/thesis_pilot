            }
          ],
          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 178,
                "part_index": null,
                "text": "No, the destruction of large quantities of contemporary art in the 2004 Momart warehouse fire (often referred to as the Saatchi warehouse fire) was far more than a financial loss"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                2
              ],
              "segment": {
                "start_index": 180,
                "end_index": 350,
                "part_index": null,
                "text": "While the financial damage was massive\u2014estimated between \u00a330 million and \u00a350 million\u2014the true devastation was **cultural, historical, emotional, and philosophical**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 354,
                "end_index": 584,
                "part_index": null,
                "text": "The fire, which broke out on May 24, 2004, at a storage facility in Leyton, East London, destroyed over 100 works from Charles Saatchi\u2019s collection alongside works belonging to public institutions, galleries, and private estates"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                3
              ],
              "segment": {
                "start_index": 673,
                "end_index": 825,
                "part_index": null,
                "text": "The Erasure of a Cultural Era\nThe fire destroyed some of the most era-defining masterpieces of the **Young British Artists (YBA)** movement of the 1990s"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 827,
                "end_index": 954,
                "part_index": null,
                "text": "These pieces were not just expensive objects; they were physical touchstones of a highly specific cultural zeitgeist in Britain"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                1
              ],
              "segment": {
                "start_index": 957,
                "end_index": 1079,
                "part_index": null,
                "text": "* **Tracey Emin\u2019s *Everyone I Have Ever Slept With 1963\u20131995*** (the famous embroidered tent) was completely destroyed"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                3,
                5
              ],
              "segment": {
                "start_index": 1082,
                "end_index": 1274,
                "part_index": null,
                "text": "* **Jake and Dinos Chapman\u2019s *Hell***\u2014a massive, intricate diorama featuring tens of thousands of hand-painted miniature figures depicting a swastika-shaped apocalypse\u2014was reduced to ash"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1277,
                "end_index": 1327,
                "part_index": null,
                "text": "These works were key moments in modern art history"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                3
              ],
              "segment": {
                "start_index": 1329,
                "end_index": 1514,
                "part_index": null,
                "text": "Their physical loss meant that future generations would only ever experience them through photographs and catalog entries, creating a permanent gap in the physical record of British art"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1524,
                "end_index": 1688,
                "part_index": null,
                "text": "Tragic Losses for Deceased Artists\nWhile living artists could theoretically continue creating, the fire was an absolute tragedy for the legacies of deceased artists"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                4,
                1
              ],
              "segment": {
                "start_index": 1691,
                "end_index": 1806,
                "part_index": null,
                "text": "* A substantial portion of the life\u2019s work of abstract pioneer **Patrick Heron** (who died in 1999) was destroyed"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1808,
                "end_index": 1883,
                "part_index": null,
                "text": "His daughters described the loss of his paintings as a \"second bereavement\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1886,
                "end_index": 2030,
                "part_index": null,
                "text": "* Key unique sculptures by **Helen Chadwick**, including the final works she was preparing right before her sudden death in 1996, were also lost"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2032,
                "end_index": 2170,
                "part_index": null,
                "text": "For these artists, the fire represented an irreversible erasure of their artistic legacies, which could never be replaced or reconstructed"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 2172,
                "end_index": 2314,
                "part_index": null,
                "text": "As artist Michael Craig-Martin noted, the loss of so many works simultaneously damaged the very \"continuity and fabric\" of British art history"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 2484,
                "end_index": 2650,
                "part_index": null,
                "text": "* The differing responses of the artists highlighted the complex nature of artistic value:\n* **Tracey Emin** famously refused a \u00a31 million offer to recreate her tent"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2652,
                "end_index": 2768,
                "part_index": null,
                "text": "She argued that the piece was inextricably bound to the specific time, emotion, and lived experience of its creation"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 2770,
                "end_index": 2959,
                "part_index": null,
                "text": "To remake it would be to create a \"soulless copy,\" proving that for some artists, the value of the art was not in the materials, but in the irreproducible \"spirit\" of the moment it was made"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 2961,
                "end_index": 3045,
                "part_index": null,
                "text": "* **The Chapman Brothers** took a wildly different, characteristically dark approach"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 3047,
                "end_index": 3283,
                "part_index": null,
                "text": "Recognizing the irony of a piece called *Hell* burning in a fire (\"You couldn't fail to see something funny about Hell being on fire\"), they spent four years building an even larger, more complex version called ***Fucking Hell*** (2008)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 3285,
                "end_index": 3386,
                "part_index": null,
                "text": "In doing so, they turned the trauma of the fire itself into a continuation of the artwork's narrative"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                9
              ],
              "segment": {
                "start_index": 3396,
                "end_index": 3526,
                "part_index": null,
                "text": "Cultural Backlash and \"Schadenfreude\"\nThe public and media reaction to the fire exposed deep class and cultural divides in Britain"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                9
              ],
              "segment": {
                "start_index": 3528,
                "end_index": 3788,
                "part_index": null,
                "text": "Because Charles Saatchi and the YBAs were polarizing figures\u2014often accused by traditionalists of making \"shock art\" or \"rubbish\"\u2014several tabloid newspapers and cultural critics greeted the fire with outright *schadenfreude* (pleasure at others' misfortune)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 3925,
                "end_index": 4067,
                "part_index": null,
                "text": "This response turned the tragedy into a cultural battleground, highlighting the ongoing \"culture wars\" surrounding contemporary conceptual art"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 4070,
                "end_index": 4151,
                "part_index": null,
                "text": "### Conclusion\nUltimately, the Momart fire was far more than a financial disaster"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                1
              ],
              "segment": {
                "start_index": 4153,
                "end_index": 4293,
                "part_index": null,
                "text": "While insurance companies paid out millions of pounds in damages, no financial settlement could restore the physical history of a generation"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                1
              ],
              "segment": {
                "start_index": 4295,
                "end_index": 4462,
                "part_index": null,
                "text": "The fire permanently depleted Britain\u2019s cultural heritage, leaving behind a void that changed how an entire era of British art is studied, remembered, and understood"
              },
              "rendered_parts": null
            }
          ],
