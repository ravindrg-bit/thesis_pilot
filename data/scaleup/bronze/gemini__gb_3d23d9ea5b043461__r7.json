          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 200,
                "end_index": 241,
                "part_index": null,
                "text": "Gold is in a period of intense volatility"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 243,
                "end_index": 304,
                "part_index": null,
                "text": "After a spectacular bull run that saw prices rise by over 40%"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3,
                4
              ],
              "segment": {
                "start_index": 243,
                "end_index": 481,
                "part_index": null,
                "text": "After a spectacular bull run that saw prices rise by over 40% and peak at historic, all-time highs of **$5,400 to $5,600 per ounce**, the precious metal has undergone a significant correction, trading around **$4,315 to $4,330 per ounce**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 693,
                "end_index": 843,
                "part_index": null,
                "text": "Proponents of the \"undervalued\" thesis point to several powerful, structural drivers that suggest the current correction is a prime buying opportunity"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 849,
                "end_index": 1016,
                "part_index": null,
                "text": "**Massive Central Bank Demand:** Central banks globally are accumulating gold at historic rates as part of a broader de-dollarization and reserve-diversification trend"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                7
              ],
              "segment": {
                "start_index": 1018,
                "end_index": 1101,
                "part_index": null,
                "text": "Central banks bought 863 tonnes of gold, and Q1 alone saw an addition of 244 tonnes"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                1,
                9
              ],
              "segment": {
                "start_index": 1184,
                "end_index": 1389,
                "part_index": null,
                "text": "**Elevated Geopolitical and Economic Uncertainty:** Ongoing geopolitical crises\u2014most notably escalations in the Middle East and Ukraine\u2014continue to support gold's traditional role as a safe-haven asset"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1516,
                "end_index": 1600,
                "part_index": null,
                "text": "For instance, **J.P. Morgan** maintains a base-case year-end target of **$6,000/oz**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1516,
                "end_index": 1712,
                "part_index": null,
                "text": "For instance, **J.P. Morgan** maintains a base-case year-end target of **$6,000/oz**, and independent precious metals consultancy **Metals Focus** projects a record annual average of **$4,920/oz**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                11
              ],
              "segment": {
                "start_index": 1803,
                "end_index": 2009,
                "part_index": null,
                "text": "**Inflation and Currency Debasement:** Persistent global debt, high deficits, and inflationary pressures (largely driven by volatile oil prices from geopolitical conflict) continue to debase fiat currencies"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 2011,
                "end_index": 2103,
                "part_index": null,
                "text": "Gold remains one of the few historically proven hedges against this loss of purchasing power"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                5
              ],
              "segment": {
                "start_index": 2190,
                "end_index": 2352,
                "part_index": null,
                "text": "Conversely, several macroeconomic shifts suggest that gold\u2019s correction is justified and that it may face further downward pressure before finding a true bottom"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 2358,
                "end_index": 2577,
                "part_index": null,
                "text": "**A Highly Hawkish Federal Reserve:** Strong U.S. economic data\u2014especially blowout non-farm payrolls (NFP) numbers showing job growth nearly double the consensus forecasts\u2014has fundamentally shifted rate expectations"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 2579,
                "end_index": 2684,
                "part_index": null,
                "text": "Under a hawkish Fed, CME FedWatch tool probabilities point to a **72% chance of a rate hike** by December"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 2690,
                "end_index": 2816,
                "part_index": null,
                "text": "**Rising Real Yields:** High interest rates and rising 10-year Treasury yields increase the \"opportunity cost\" of holding gold"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 2818,
                "end_index": 2948,
                "part_index": null,
                "text": "Because gold pays no yield or dividend, investors often migrate to bonds or high-yield money market funds when yields are elevated"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 2953,
                "end_index": 3103,
                "part_index": null,
                "text": "**Technical Breakdown:** From a trading perspective, gold has recently broken below key long-term support levels, including its 200-day moving average"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 3105,
                "end_index": 3241,
                "part_index": null,
                "text": "Many technical analysts believe a mid-year low (likely forming in July) must be established before the broader uptrend can safely resume"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                9
              ],
              "segment": {
                "start_index": 3305,
                "end_index": 3456,
                "part_index": null,
                "text": "While the debate continues over physical gold, there is a strong consensus among analysts that **gold mining stocks (equities)** are deeply undervalued"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 3460,
                "end_index": 3599,
                "part_index": null,
                "text": "Throughout the record price surges of the last couple of years, mining companies have generated historic free cash flows and bumper profits"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 3820,
                "end_index": 3857,
                "part_index": null,
                "text": "ounce-out-of-the-ground\" discrepancy)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15,
                13
              ],
              "segment": {
                "start_index": 3859,
                "end_index": 4039,
                "part_index": null,
                "text": "Firms like BMO Capital Markets and Sprott have noted that gold equities remain highly under-owned and present a deeply undervalued entry point with significant operational leverage"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                5
              ],
              "segment": {
                "start_index": 4042,
                "end_index": 4229,
                "part_index": null,
                "text": "### Summary\n* **If you are a short-term trader:** Gold may not be undervalued yet, as the technical breakdown and hawkish Fed rate expectations could drive prices lower through the summer"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                6
              ],
              "segment": {
                "start_index": 4231,
                "end_index": 4406,
                "part_index": null,
                "text": "* **If you are a long-term investor:** The fundamental pillars of the gold bull market\u2014central bank buying, geopolitical tension, and sovereign debt\u2014remain entirely intact"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                16
              ],
              "segment": {
                "start_index": 4408,
                "end_index": 4557,
                "part_index": null,
                "text": "From this perspective, the dip to the $4,300 range represents an undervalued buying opportunity ahead of a projected move back toward $5,000\u2013$6,000"
              },
              "rendered_parts": null
            }
          ],
