          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 220,
                "part_index": null,
                "text": "Welch Allyn (now part of Hillrom/Baxter) is one of the most trusted names in healthcare, renowned for its highly reliable diagnostic tools used by ophthalmologists, optometrists, pediatricians, and primary care providers"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2,
                3
              ],
              "segment": {
                "start_index": 224,
                "end_index": 381,
                "part_index": null,
                "text": "Their ophthalmic product lineup ranges from traditional direct ophthalmoscopes to advanced automated vision screeners and digital teleretinal imaging systems"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                4
              ],
              "segment": {
                "start_index": 396,
                "end_index": 539,
                "part_index": null,
                "text": "Ophthalmoscopes (Direct Examination)\nDirect ophthalmoscopes are Welch Allyn's flagship products, known for their superior optics and durability"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                6
              ],
              "segment": {
                "start_index": 542,
                "end_index": 644,
                "part_index": null,
                "text": "*   **PanOptic\u2122 Plus Ophthalmoscope:** This is a major redesign of the classic direct ophthalmoscope"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 651,
                "end_index": 850,
                "part_index": null,
                "text": "*   **Large Field of View:** Provides a viewing area **20 times larger** than a traditional standard ophthalmoscope, making it significantly easier to get a complete look at the optic disc and retina"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 856,
                "end_index": 1011,
                "part_index": null,
                "text": "*   **Quick Eye Alignment:** Features two light targets on the patient side of the device to help guide the patient\u2019s gaze, facilitating faster alignment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1017,
                "end_index": 1089,
                "part_index": null,
                "text": "*   **DuraShock\u2122 Technology:** Designed with drop-resistant durability"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                10
              ],
              "segment": {
                "start_index": 1091,
                "end_index": 1238,
                "part_index": null,
                "text": "*   **Traditional 3.5 V Coaxial Ophthalmoscope:** The longtime industry standard, featuring a coaxial optical design that reduces shadows and glare"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                6
              ],
              "segment": {
                "start_index": 1240,
                "end_index": 1380,
                "part_index": null,
                "text": "It offers a wide array of apertures and filters (such as cobalt blue for corneal examinations and red-free filters to examine blood vessels)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                11
              ],
              "segment": {
                "start_index": 1382,
                "end_index": 1529,
                "part_index": null,
                "text": "*   **Pocket LED Ophthalmoscope:** A compact, lightweight, and highly portable option ideal for medical students, residents, or doctors on the move"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                9
              ],
              "segment": {
                "start_index": 1531,
                "end_index": 1612,
                "part_index": null,
                "text": "It features long-lasting LED illumination and is available in customizable colors"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 1627,
                "end_index": 1752,
                "part_index": null,
                "text": "Digital Ophthalmic Imaging\nWelch Allyn offers digital imaging extensions to make documentation and remote consultation easier"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                6
              ],
              "segment": {
                "start_index": 1755,
                "end_index": 1926,
                "part_index": null,
                "text": "*   **iExaminer\u2122 Pro System:** This system uses a custom adapter (**SmartBracket\u2122**) to align a smartphone camera with the eyepiece of the PanOptic Plus ophthalmoscope"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                13
              ],
              "segment": {
                "start_index": 1928,
                "end_index": 2088,
                "part_index": null,
                "text": "Paired with the iExaminer Pro app, it allows clinicians to capture, save, and share digital images of the patient's fundus for education, tracking, or referrals"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                3
              ],
              "segment": {
                "start_index": 2090,
                "end_index": 2208,
                "part_index": null,
                "text": "*   **RetinaVue\u00ae 700 Imager:** A hand-held, non-mydriatic (no dilation required in most cases) digital retinal camera"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2210,
                "end_index": 2287,
                "part_index": null,
                "text": "It is widely used in primary care settings for diabetic retinopathy screening"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15
              ],
              "segment": {
                "start_index": 2294,
                "end_index": 2445,
                "part_index": null,
                "text": "*   Features **auto-alignment, auto-focus, and auto-capture** to make taking a clean retinal picture very simple even for non-specialist clinical staff"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                15
              ],
              "segment": {
                "start_index": 2451,
                "end_index": 2506,
                "part_index": null,
                "text": "*   Connects wirelessly to EMRs for quick data transfer"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17,
                10
              ],
              "segment": {
                "start_index": 2677,
                "end_index": 2785,
                "part_index": null,
                "text": "*   **Spot\u00ae Vision Screener:** A highly popular, portable, handheld instrument-based autorefractor/screener"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                18,
                10
              ],
              "segment": {
                "start_index": 2792,
                "end_index": 2905,
                "part_index": null,
                "text": "*   It scans both eyes simultaneously from a comfortable, non-threatening distance of 3 feet (1 meter) in seconds"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17,
                19
              ],
              "segment": {
                "start_index": 2911,
                "end_index": 2999,
                "part_index": null,
                "text": "*   It is specifically designed for pediatric screenings (children as young as 6 months)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                19
              ],
              "segment": {
                "start_index": 3005,
                "end_index": 3137,
                "part_index": null,
                "text": "*   It screens for six primary amblyopia risk factors: **myopia, hyperopia, astigmatism, anisometropia, strabismus, and anisocoria**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                20
              ],
              "segment": {
                "start_index": 3139,
                "end_index": 3267,
                "part_index": null,
                "text": "*   **Elite\u2122 Retinoscope (Streak & Spot):** Highly valued by optometrists and ophthalmologists for manual objective refraction"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                21,
                22
              ],
              "segment": {
                "start_index": 3273,
                "end_index": 3375,
                "part_index": null,
                "text": "*   Provides **2.8X the brightness** of standard retinoscopes and an exceptionally clean, sharp streak"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                21,
                22
              ],
              "segment": {
                "start_index": 3381,
                "end_index": 3482,
                "part_index": null,
                "text": "*   Features an optional crossed-linear polarizing filter to eliminate 99% of glare from trial lenses"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                23,
                20
              ],
              "segment": {
                "start_index": 3488,
                "end_index": 3582,
                "part_index": null,
                "text": "*   Can easily convert from streak retinoscopy to spot retinoscopy simply by swapping the bulb"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                24,
                20
              ],
              "segment": {
                "start_index": 3731,
                "end_index": 3882,
                "part_index": null,
                "text": "*   **3.5 V Lithium-Ion Rechargeable Handles:** Ergonomic, lightweight, and long-lasting handles that power direct ophthalmoscope and retinoscope heads"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                20
              ],
              "segment": {
                "start_index": 3884,
                "end_index": 4128,
                "part_index": null,
                "text": "*   **Desk Chargers & Wall Diagnostic Stations:** Integrated wall units (such as the Green Series\u2122 or Connex\u00ae Integrated Wall Systems) allow clinicians to easily mount and charge their ophthalmoscopes and otoscopes side-by-side in exam rooms"
              },
              "rendered_parts": null
            }
