                22
              ],
              "segment": {
                "start_index": 2892,
                "end_index": 3052,
                "part_index": null,
                "text": "**The Equipment:** You will need a satellite dish (a 30-to-35-inch dish for Ku-band signals in North America), a linear LNB (the receiving node on the dish arm)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
