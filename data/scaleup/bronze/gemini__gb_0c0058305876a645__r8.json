          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 75,
                "part_index": null,
                "text": "Because the common cold is caused by viruses, **antibiotics will not work**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 77,
                "end_index": 205,
                "part_index": null,
                "text": "Antibiotics only target bacteria, and taking them unnecessarily can cause unwanted side effects or lead to antibiotic resistance"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 209,
                "end_index": 354,
                "part_index": null,
                "text": "There is no cure for a cold, so the primary goal of medication is to relieve your specific symptoms while your immune system fights off the virus"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 356,
                "end_index": 477,
                "part_index": null,
                "text": "Instead of choosing a generic \"all-in-one\" cold medicine, it is best to target the specific symptoms you are experiencing"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 487,
                "end_index": 646,
                "part_index": null,
                "text": "For Body Aches, Sore Throat, and Fever\n*   **Acetaminophen (Tylenol):** Helps lower fever and relieve mild-to-moderate pain, such as headaches or a sore throat"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                3
              ],
              "segment": {
                "start_index": 648,
                "end_index": 749,
                "part_index": null,
                "text": "*   **NSAIDs (Ibuprofen/Advil/Motrin or Naproxen/Aleve):** These reduce fever, pain, and inflammation"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                3
              ],
              "segment": {
                "start_index": 775,
                "end_index": 851,
                "part_index": null,
                "text": "Gargling with warm salt water is highly effective for soothing a sore throat"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                2
              ],
              "segment": {
                "start_index": 861,
                "end_index": 1046,
                "part_index": null,
                "text": "For Nasal Congestion (Stuffy Nose)\n*   **Oral Decongestants (Pseudoephedrine or Phenylephrine):** These narrow the blood vessels in your nasal passages to reduce swelling and congestion"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                3
              ],
              "segment": {
                "start_index": 1491,
                "end_index": 1615,
                "part_index": null,
                "text": "*   **Saline Nasal Sprays or Rinses:** A completely safe, non-medicated option to help loosen mucus and clear nasal passages"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1625,
                "end_index": 1763,
                "part_index": null,
                "text": "For a Cough\n*   **Expectorants (Guaifenesin/Mucinex):** These help thin and loosen mucus in your chest, making your coughs more productive"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                3
              ],
              "segment": {
                "start_index": 1943,
                "end_index": 2082,
                "part_index": null,
                "text": "A spoonful of honey (for adults and children over age 1) has been clinically shown to soothe a cough as effectively as some OTC medications"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                2
              ],
              "segment": {
                "start_index": 2542,
                "end_index": 2711,
                "part_index": null,
                "text": "*   **Avoid Overlapping Ingredients (Accidental Overdose):** Many multi-symptom cold products (like NyQuil, DayQuil, or Tylenol Cold) contain multiple active ingredients"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                2
              ],
              "segment": {
                "start_index": 2713,
                "end_index": 2913,
                "part_index": null,
                "text": "If you take a multi-symptom medicine *and* a separate pain reliever like Tylenol, you can easily exceed the safe daily limit of acetaminophen, which can cause severe, life-threatening **liver damage**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 2915,
                "end_index": 2967,
                "part_index": null,
                "text": "Always read the \"Active Ingredients\" label carefully"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                3
              ],
              "segment": {
                "start_index": 3213,
                "end_index": 3414,
                "part_index": null,
