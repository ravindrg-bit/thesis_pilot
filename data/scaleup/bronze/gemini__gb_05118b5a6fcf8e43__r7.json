          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 281,
                "end_index": 511,
                "part_index": null,
                "text": "High-Fashion Meets Fine Art\n*   **Louis Vuitton x Yayoi Kusama (January 2023):** Ten years after their first historic partnership, French luxury house Louis Vuitton reunited with legendary Japanese contemporary artist Yayoi Kusama"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 513,
                "end_index": 592,
                "part_index": null,
                "text": "The collaboration was a massive global event characterized by a \"dot takeover.\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                1
              ],
              "segment": {
                "start_index": 513,
                "end_index": 739,
                "part_index": null,
                "text": "The collaboration was a massive global event characterized by a \"dot takeover.\" It featured Kusama\u2019s signature polka dots, metallic spheres, and painted pumpkins splashed across handbags, ready-to-wear clothing, and perfumes"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                4
              ],
              "segment": {
                "start_index": 741,
                "end_index": 994,
                "part_index": null,
                "text": "The campaign was accompanied by massive, viral public art installations\u2014such as a 15-meter-tall animatronic sculpture of Kusama \"painting\" the storefront of Harrods in London and hypnotic, hyper-realistic 3D anamorphic billboards in Tokyo and New York"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 996,
                "end_index": 1232,
                "part_index": null,
                "text": "*   **Stella McCartney x Yoshitomo Nara (March 2023):** Expanding on their first successful 2021 partnership, designer Stella McCartney teamed up with Japanese artist Yoshitomo Nara for a second, highly-coveted unisex capsule collection"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                5
              ],
              "segment": {
                "start_index": 1234,
                "end_index": 1454,
                "part_index": null,
                "text": "The collection fused style with social activism, showcasing Nara's trademark illustration style of defiant, wide-eyed children alongside countercultural and activist slogans like \"STOP THE BOMBS\" and \"CHANGE THE HISTORY\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1457,
                "end_index": 1632,
                "part_index": null,
                "text": "*   **Loewe x Maruja Mallo (Summer 2023):** Loewe\u2019s creative director, Jonathan Anderson, collaborated with the estate of trailblazing Spanish Surrealist artist Maruja Mallo"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1634,
                "end_index": 1848,
                "part_index": null,
                "text": "Paying homage to her role in the \"Generation of '27\" avant-garde movement, the mid-summer capsule collection reimagined her signature floral, seashell, and botanical paintings on dresses, knitwear, and leather bags"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1938,
                "end_index": 2094,
                "part_index": null,
                "text": "Painting Four Hands\" at Fondation Louis Vuitton, Paris (April \u2013 August 2023):** This was heralded as one of the most important art exhibitions of the year"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 2096,
                "end_index": 2271,
                "part_index": null,
                "text": "Rather than a new product release, it was a massive retrospective dedicated entirely to the prolific, historic 1980s collaboration between Jean-Michel Basquiat and Andy Warhol"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 2273,
                "end_index": 2495,
                "part_index": null,
                "text": "The exhibition gathered more than 80 paintings signed jointly by both artists, alongside works by fellow New York icons like Keith Haring and Francesco Clemente, capturing the intense creative chemistry of their friendship"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                11
              ],
              "segment": {
                "start_index": 2717,
                "end_index": 2741,
                "part_index": null,
                "text": "Air Force 1 Low \"1837\"**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                11
              ],
              "segment": {
                "start_index": 2743,
                "end_index": 2927,
                "part_index": null,
                "text": "Named after the year Tiffany was founded, the luxury sneaker featured premium black suede with a striking \"Tiffany Blue\" leather swoosh, topped with a sterling silver badge on the heel"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 2929,
                "end_index": 3086,
                "part_index": null,
                "text": "To elevate the artistic partnership, the drop was accompanied by co-branded sterling silver accessories, including a whistle, shoe brush, and silver shoehorn"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                10
              ],
              "segment": {
                "start_index": 3108,
                "end_index": 3326,
                "part_index": null,
                "text": "x Daniel Arsham (Late 2023):** Continuing his work with the luxury jeweler, contemporary artist Daniel Arsham utilized his famous \"Future Relics\" aesthetic to create a limited-edition series of eroded bronze sculptures"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                14
              ],
              "segment": {
                "start_index": 3328,
                "end_index": 3463,
                "part_index": null,
                "text": "Titled *The Amalgamated Bust of Venus*, the collaborative series presented classical art fragments cast in bronze with oxidized patinas"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 3465,
                "end_index": 3572,
                "part_index": null,
                "text": "Hidden inside each sculpture was a limited-edition \"T by Tiffany\" bracelet set with diamonds and tsavorites"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15,
                16
              ],
              "segment": {
                "start_index": 3587,
                "end_index": 3793,
                "part_index": null,
                "text": "Dedicated Collaborative Art Fairs\n*   **Art Collaboration Kyoto (ACK) 2023 (October 2023):** ACK established itself as a premier global art event by building an entire fair around the ethos of collaboration"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15,
                17,
                16
              ],
              "segment": {
                "start_index": 3795,
                "end_index": 4021,
                "part_index": null,
                "text": "Held at the Kyoto International Conference Center under the curatorial theme \"Visions of a Torn World: Circulation and Coexistence,\" the fair required Japanese galleries to co-host and share booths with international galleries"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                18,
                16
              ],
              "segment": {
                "start_index": 4023,
                "end_index": 4155,
                "part_index": null,
                "text": "This unique structure encouraged cross-cultural dialogue, shared artist representations, and new market opportunities across borders"
              },
              "rendered_parts": null
            }
          ],
