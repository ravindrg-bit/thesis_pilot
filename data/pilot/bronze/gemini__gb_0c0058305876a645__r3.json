              ],
              "segment": {
                "start_index": 2381,
                "end_index": 2566,
                "part_index": null,
                "text": "Runny Nose and Sneezing\n*   **Antihistamines:** Older, \"first-generation\" antihistamines like diphenhydramine (Benadryl) or chlorpheniramine can help dry up watery eyes and a runny nose"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
