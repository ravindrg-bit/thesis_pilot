              ],
              "segment": {
                "start_index": 2603,
                "end_index": 2769,
                "part_index": null,
                "text": "If you are looking for free, unencrypted radio signals broadcast directly from space to a satellite dish at your house, you want **Free-to-Air (FTA) Satellite Radio**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                19
              ],
              "segment": {
                "start_index": 2773,
                "end_index": 2887,
                "part_index": null,
                "text": "Unlike SiriusXM, this is completely free forever with no subscriptions, but it requires a physical equipment setup"
