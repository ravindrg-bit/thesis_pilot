                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGfpJ-baER51W4r1d4GPYiifzD3fjy1dWHR6y6CJ-uaNUWkksftpGOhZKKx7PgZjgiJg8MptgemsGa0q5diixPrSxD6oGi-mHUB9w2cqDchJ2LYWfRssNOZNWcWTFB5FPvMh_PVW-g="
