                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHFH1LJ9Bm6fE-J6U6hfqFRFOwb9RKEtB0l_u4Z5ZeJKyjpYRkEqUSgaqoXqLcQtBm73et8LJACiYmnwjrQfw-VgsN9ZjW_6CqeWhL47ho7F4_cNyA1rrKIkue9_hatLA=="
