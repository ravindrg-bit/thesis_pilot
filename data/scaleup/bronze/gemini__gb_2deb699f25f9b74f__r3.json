          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 229,
                "part_index": null,
                "text": "**Medi-Cal** is California\u2019s Medicaid program, which provides free or low-cost health coverage for eligible California residents, including low-income individuals, families, seniors, pregnant women, and people with disabilities"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 245,
                "end_index": 344,
                "part_index": null,
                "text": "General Eligibility Requirements\nFor most adults, eligibility is based primarily on your **income**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                4
              ],
              "segment": {
                "start_index": 245,
                "end_index": 455,
                "part_index": null,
                "text": "General Eligibility Requirements\nFor most adults, eligibility is based primarily on your **income**:\n* **Adults (Ages 19\u201364):** Income must generally be at or below **138% of the Federal Poverty Level (FPL)**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                3
              ],
              "segment": {
                "start_index": 457,
                "end_index": 506,
                "part_index": null,
                "text": "For a single person, this is roughly $21,600/year"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 508,
                "end_index": 597,
                "part_index": null,
                "text": "* **Children (Ages 0\u201319):** Families can qualify with incomes up to **266% of the FPL**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                5
              ],
              "segment": {
                "start_index": 599,
                "end_index": 712,
                "part_index": null,
                "text": "* **Pregnant Individuals:** Eligibility limits are typically higher to ensure coverage during and after pregnancy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 727,
                "end_index": 855,
                "part_index": null,
                "text": "Major Changes (2026 Rules & Reinstatements)\nDue to recent California budget legislation, several significant changes took effect"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                3
              ],
              "segment": {
                "start_index": 1021,
                "end_index": 1138,
                "part_index": null,
                "text": "Older adults (65+), people with disabilities, and individuals needing long-term nursing home care (non-MAGI Medi-Cal)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 1140,
                "end_index": 1244,
                "part_index": null,
                "text": "(Asset tests still do not apply to standard, income-based MAGI Medi-Cal for younger adults and families)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 1263,
                "end_index": 1395,
                "part_index": null,
                "text": "Countable assets are now limited to **$130,000 for an individual**, plus $65,000 for each additional family member (up to 10 people)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                11
              ],
              "segment": {
                "start_index": 1420,
                "end_index": 1545,
                "part_index": null,
                "text": "Your primary home, one vehicle, personal belongings, and some retirement accounts are generally not counted toward this limit"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1643,
                "end_index": 1738,
                "part_index": null,
                "text": "Undocumented adults (ages 19 and older) who do not have a Satisfactory Immigration Status (SIS)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                13
              ],
              "segment": {
                "start_index": 1758,
                "end_index": 1935,
                "part_index": null,
                "text": "While California previously expanded full-scope Medi-Cal to all residents, a **new enrollment freeze** prevents undocumented adults from signing up for *new* full-scope coverage"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                10,
                13
              ],
              "segment": {
                "start_index": 1962,
                "end_index": 2108,
                "part_index": null,
                "text": "If you were enrolled in full-scope Medi-Cal before January 1, 2026, you will keep your full coverage as long as you complete your renewals on time"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                13
              ],
              "segment": {
                "start_index": 2128,
                "end_index": 2223,
                "part_index": null,
                "text": "Undocumented children under 19 and pregnant individuals remain eligible for full-scope Medi-Cal"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                13
              ],
              "segment": {
                "start_index": 2225,
                "end_index": 2399,
                "part_index": null,
                "text": "* **Dental Coverage Changes (Effective July 1, 2026):**\n  * Undocumented adults (19+) will lose full dental benefits and will transition to **emergency dental coverage only**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                13
              ],
              "segment": {
                "start_index": 2401,
                "end_index": 2497,
                "part_index": null,
                "text": "Full dental benefits will remain available only for children (under 19) and pregnant individuals"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2538,
                "end_index": 2581,
                "part_index": null,
                "text": "Medi-Cal covers \"essential health benefits\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2538,
                "end_index": 2647,
                "part_index": null,
                "text": "Medi-Cal covers \"essential health benefits\", including:\n* **Outpatient services:** Doctor visits and checkups"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2649,
                "end_index": 2708,
                "part_index": null,
                "text": "* **Emergency care:** Emergency room visits and urgent care"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2710,
                "end_index": 2761,
                "part_index": null,
                "text": "* **Hospitalization:** Inpatient care and surgeries"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                7
              ],
              "segment": {
                "start_index": 2763,
                "end_index": 2828,
                "part_index": null,
                "text": "* **Prescription drugs:** Medi-Cal Rx covers approved medications"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2830,
                "end_index": 2862,
                "part_index": null,
                "text": "* **Maternity and newborn care**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2864,
                "end_index": 2909,
                "part_index": null,
                "text": "* **Mental health & substance use treatment**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2911,
                "end_index": 2995,
                "part_index": null,
                "text": "* **Preventive services:** Immunizations, screenings, and chronic disease management"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                14,
                5
              ],
              "segment": {
                "start_index": 2997,
                "end_index": 3063,
                "part_index": null,
                "text": "* **Pediatric services:** Including vision and dental for children"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 3078,
                "end_index": 3316,
                "part_index": null,
                "text": "How to Apply\nYou can apply for Medi-Cal at any time of year using one of the following methods:\n* **Online:** \n  * **BenefitsCal:** [BenefitsCal.com](https://benefitscal.com) (Best if applying for other benefits like CalFresh/food stamps)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 3320,
                "end_index": 3494,
                "part_index": null,
                "text": "* **Covered California:** [CoveredCA.com](https://www.coveredca.com) (If you do not qualify for Medi-Cal, you will automatically be screened for discounted private insurance)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 3496,
                "end_index": 3598,
                "part_index": null,
                "text": "* **By Phone:** Call your local county social services office or the Covered California service center"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 3600,
                "end_index": 3769,
                "part_index": null,
                "text": "* **By Mail / In Person:** Download and print an application to mail in, or visit your county's Department of Social Services office to apply with a caseworker in person"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                10
              ],
              "segment": {
                "start_index": 3943,
                "end_index": 4093,
                "part_index": null,
                "text": "** You must complete and return them, or log into your online account to complete your renewal, to prevent your coverage from being paused or canceled"
              },
              "rendered_parts": null
            }
          ],
