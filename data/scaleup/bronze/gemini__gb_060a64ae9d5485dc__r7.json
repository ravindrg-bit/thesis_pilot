              "segment": {
                "start_index": 1737,
                "end_index": 1880,
                "part_index": null,
                "text": "#### **High-End Estimate (20 blinks per minute)**\n* **Per day:** $20\\text{ blinks} \\times 960\\text{ waking minutes} = 19,200\\text{ blinks/day}$"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
