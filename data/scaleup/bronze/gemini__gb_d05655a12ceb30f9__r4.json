          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 101,
                "part_index": null,
                "text": "When your bladder does not empty completely, it is a medical condition known as **urinary retention**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 156,
                "end_index": 241,
                "part_index": null,
                "text": "*   **Acute urinary retention:** A sudden, painful, and complete inability to urinate"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 243,
                "end_index": 308,
                "part_index": null,
                "text": "**This is a medical emergency** that requires immediate treatment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 310,
                "end_index": 397,
                "part_index": null,
                "text": "*   **Chronic urinary retention:** A gradual, long-term difficulty emptying the bladder"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 399,
                "end_index": 478,
                "part_index": null,
                "text": "You are still able to urinate, but a significant amount of urine is left behind"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 480,
                "end_index": 549,
                "part_index": null,
                "text": "It is often painless at first but can lead to complications over time"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 552,
                "end_index": 634,
                "part_index": null,
                "text": "The causes of urinary retention are generally grouped into several main categories"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 644,
                "end_index": 794,
                "part_index": null,
                "text": "Physical Obstructions (Blockages)\nAnything that physically blocks or narrows the pathway out of the bladder (the urethra) can prevent it from emptying"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 644,
                "end_index": 877,
                "part_index": null,
                "text": "Physical Obstructions (Blockages)\nAnything that physically blocks or narrows the pathway out of the bladder (the urethra) can prevent it from emptying:\n*   **Enlarged Prostate (BPH):** In men, the prostate gland surrounds the urethra"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 879,
                "end_index": 999,
                "part_index": null,
                "text": "As men age, the prostate often enlarges (Benign Prostatic Hyperplasia), squeezing the urethra and restricting urine flow"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1001,
                "end_index": 1058,
                "part_index": null,
                "text": "This is the most common cause of urinary retention in men"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1060,
                "end_index": 1260,
                "part_index": null,
                "text": "*   **Pelvic Organ Prolapse:** In women, weakened pelvic floor muscles can cause pelvic organs like the bladder (cystocele) or rectum (rectocele) to sag and press against the urethra, pinching it shut"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1262,
                "end_index": 1414,
                "part_index": null,
                "text": "*   **Urethral Strictures:** Scar tissue resulting from prior infections, trauma, or medical procedures (like catheter insertion) can narrow the urethra"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1416,
                "end_index": 1523,
                "part_index": null,
                "text": "*   **Urinary Stones:** Bladder or kidney stones can travel and physically block the opening of the urethra"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1525,
                "end_index": 1676,
                "part_index": null,
                "text": "*   **Severe Constipation:** A large, hard mass of stool in the rectum can physically press against the bladder and urethra, blocking the flow of urine"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1868,
                "end_index": 1929,
                "part_index": null,
                "text": "If these nerve pathways are damaged, the coordination is lost"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                3
              ],
              "segment": {
                "start_index": 1868,
                "end_index": 1978,
                "part_index": null,
                "text": "If these nerve pathways are damaged, the coordination is lost:\n*   **Spinal cord injuries** or herniated discs"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1980,
                "end_index": 2094,
                "part_index": null,
                "text": "*   **Neurological diseases** such as Multiple Sclerosis (MS), Parkinson\u2019s disease, Alzheimer's, or spina bifida"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2096,
                "end_index": 2128,
                "part_index": null,
