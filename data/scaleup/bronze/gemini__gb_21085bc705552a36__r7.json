          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 529,
                "end_index": 705,
                "part_index": null,
                "text": "*   **Instapoetry (Early 2010s):** A portmanteau of \"Instagram\" and \"poetry,\" this genre emerged as writers began sharing short, highly visual, minimalist poems on social media"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                0,
                2
              ],
              "segment": {
                "start_index": 707,
                "end_index": 925,
                "part_index": null,
                "text": "Instapoetry bypasses traditional publishing gatekeepers, featuring simple language, raw emotional themes (like healing, trauma, and self-love), and distinct visual formatting\u2014often accompanied by simple line drawings"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                2
              ],
              "segment": {
                "start_index": 927,
                "end_index": 1027,
                "part_index": null,
                "text": "Poets like Rupi Kaur and Lang Leav popularized the genre, turning it into a massive commercial force"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4,
                5
              ],
              "segment": {
                "start_index": 1029,
                "end_index": 1233,
                "part_index": null,
                "text": "*   **Twitterature / Twitter Fiction (Late 2000s):** Born out of the character limits of Twitter (now X), this genre consists of micro-fiction, aphorisms, or serialized novels told entirely through tweets"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                6
              ],
              "segment": {
                "start_index": 1235,
                "end_index": 1374,
                "part_index": null,
                "text": "Writers use the constraint of 140 (later 280) characters to build suspense and master brevity, often involving real-time reader interaction"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8,
                9
              ],
              "segment": {
                "start_index": 2094,
                "end_index": 2344,
                "part_index": null,
                "text": "*   **Cli-Fi (Climate Fiction - Coined in 2007):** While stories about environmental disaster existed previously, the term \"cli-fi\" was coined by blogger Dan Bloom in 2007 and grew into a formally recognized academic and commercial genre in the 2010s"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                10
              ],
              "segment": {
                "start_index": 2346,
                "end_index": 2596,
                "part_index": null,
                "text": "Unlike traditional science fiction, which might feature distant alien worlds, cli-fi is grounded specifically on Earth, focusing on the immediate psychological, social, and emotional realities of humanity grappling with anthropocentric climate change"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                12
              ],
              "segment": {
                "start_index": 2599,
                "end_index": 2857,
                "part_index": null,
                "text": "*   **Solarpunk (Coined in 2008):** Born on the internet in the late 2000s and formalized in a 2012 Brazilian anthology, Solarpunk is a direct rebellion against the corporate nihilism of *Cyberpunk* and the ecological doom of typical post-apocalyptic fiction"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                11,
                14
              ],
              "segment": {
                "start_index": 2859,
                "end_index": 3032,
                "part_index": null,
                "text": "It is an optimistic, eco-speculative genre that envisions a sustainable, decentralized, green future where humanity lives in harmony with nature, powered by renewable energy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15,
                16
              ],
              "segment": {
                "start_index": 3268,
                "end_index": 3523,
                "part_index": null,
                "text": "*   **LitRPG (Literary Role-Playing Game - Codified in 2013):** While \"portal fantasies\" (characters entering game worlds) have existed for decades, LitRPG was officially named and codified as a distinct genre in 2013 by the Russian publishing house EKSMO"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17,
                16
              ],
              "segment": {
                "start_index": 3525,
                "end_index": 3616,
                "part_index": null,
                "text": "It explicitly blends novel-length narrative with the mechanics of Role-Playing Games (RPGs)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                18,
                16
              ],
              "segment": {
                "start_index": 3618,
                "end_index": 3797,
                "part_index": null,
                "text": "In a LitRPG, game statistics, experience points, quest notifications, and level-ups are literal, visible parts of the text that the characters actively monitor and use to progress"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                18,
                16
              ],
              "segment": {
                "start_index": 3799,
                "end_index": 3912,
                "part_index": null,
                "text": "It has exploded in popularity on self-publishing and serialization platforms like Royal Road and Kindle Unlimited"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                19
              ],
              "segment": {
                "start_index": 3914,
                "end_index": 4059,
                "part_index": null,
                "text": "*   **Cozy Fantasy (Early 2020s):** For decades, high fantasy was dominated by epic, world-ending stakes, gritty realism, and \"grimdark\" violence"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                20
              ],
              "segment": {
                "start_index": 4061,
                "end_index": 4218,
                "part_index": null,
                "text": "In the early 2020s\u2014greatly accelerated by a collective desire for escapism during the COVID-19 pandemic\u2014**Cozy Fantasy** was codified as a distinct genre"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                21,
                20
              ],
              "segment": {
                "start_index": 4220,
                "end_index": 4310,
                "part_index": null,
                "text": "It trades world-ending wars for low-stakes, slice-of-life narratives set in magical worlds"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                21,
                20,
                22
              ],
              "segment": {
                "start_index": 4312,
                "end_index": 4517,
                "part_index": null,
                "text": "The plots focus on community, quiet domesticity, gentle magic, and deep personal healing (perfectly encapsulated by Travis Baldree's 2022 hit *Legends & Lattes*, which follows an orc opening a coffee shop)"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
