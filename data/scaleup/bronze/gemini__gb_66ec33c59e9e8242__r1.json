          ],
          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 339,
                "end_index": 483,
                "part_index": null,
                "text": "Why We Turn Pale: The Redirection of Blood\nThe primary cause of paleness (called **pallor**) is a process called **peripheral vasoconstriction**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 597,
                "end_index": 673,
                "part_index": null,
                "text": "Your sympathetic nervous system kicks in, releasing hormones like adrenaline"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 676,
                "end_index": 769,
                "part_index": null,
                "text": "* **Prioritizing Vital Organs:** To fight off the threat, your body prioritizes its resources"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                4
              ],
              "segment": {
                "start_index": 771,
                "end_index": 992,
                "part_index": null,
                "text": "It restricts the blood vessels near the surface of your skin and redirects that warm, oxygen-rich red blood inward toward your vital organs (like your heart, brain, and lungs) and to the active areas of your immune system"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                3
              ],
              "segment": {
                "start_index": 995,
                "end_index": 1162,
                "part_index": null,
                "text": "* **The Nausea Trigger:** When you feel severely nauseous or are about to vomit, your body experiences a rapid drop in blood pressure and a surge of autonomic activity"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1164,
                "end_index": 1281,
                "part_index": null,
                "text": "This instantly pulls blood away from your face, lips, and neck, leaving you looking cold, clammy, and incredibly pale"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1283,
                "end_index": 1385,
                "part_index": null,
                "text": "* **Dehydration:** Sickness often comes with sweating, vomiting, or diarrhea, which drains your fluids"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                2
              ],
              "segment": {
                "start_index": 1387,
                "end_index": 1512,
                "part_index": null,
                "text": "Dehydration reduces your overall blood volume, which lowers your blood pressure and makes your skin look even drier and paler"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 1527,
                "end_index": 1645,
                "part_index": null,
                "text": "Why We Turn \"Green\": The Optical Illusion\nWhile cartoon characters turn a vibrant emerald green when they are nauseous"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 1527,
                "end_index": 1707,
                "part_index": null,
                "text": "Why We Turn \"Green\": The Optical Illusion\nWhile cartoon characters turn a vibrant emerald green when they are nauseous, humans actually develop a faint, sickly \"greenish-gray\" cast"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                10
              ],
              "segment": {
                "start_index": 1774,
                "end_index": 1910,
                "part_index": null,
                "text": "* **Warmth is Masked:** Healthy skin gets its warm, pink undertone from the red hemoglobin in the blood circulating close to the surface"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                7
              ],
              "segment": {
                "start_index": 1913,
                "end_index": 2012,
                "part_index": null,
                "text": "* **The Yellow-Blue Mix:** When vasoconstriction pulls that red blood away, you lose that warm mask"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                7
              ],
              "segment": {
                "start_index": 2014,
                "end_index": 2118,
                "part_index": null,
                "text": "What remains is your skin's natural structural pigment (which contains yellow-toned melanin or carotene)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                7
              ],
              "segment": {
                "start_index": 2120,
                "end_index": 2175,
                "part_index": null,
                "text": "At the same time, the veins under your skin appear blue"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 2177,
                "end_index": 2260,
                "part_index": null,
                "text": "(Veins look blue because of the way light refracts and scatters through skin tissue"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                7
              ],
              "segment": {
                "start_index": 2263,
                "end_index": 2466,
                "part_index": null,
                "text": "* **The Result:** When the yellow undertones of your skin blend visually with the blue/purple of your veins without any red blood to balance them out, **yellow + blue creates a faint greenish-gray tint**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 2482,
                "end_index": 2675,
                "part_index": null,
                "text": "The True Chemical \"Green\": Jaundice & Biliverdin\nIn some specific illnesses, particularly those involving the liver, gallbladder, or blood, a patient can turn a literal shade of greenish-yellow"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                13,
                15
              ],
              "segment": {
                "start_index": 2678,
                "end_index": 2838,
                "part_index": null,
                "text": "* When the liver is compromised (by conditions like hepatitis, gallstones, or severe infection), it cannot properly process a waste product called **bilirubin**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                13
              ],
              "segment": {
                "start_index": 2841,
                "end_index": 2916,
                "part_index": null,
                "text": "* A buildup of bilirubin turns the skin and eyes yellow (known as jaundice)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 2919,
                "end_index": 3109,
                "part_index": null,
                "text": "* Over time, if the bilirubin continues to build up, it oxidizes into a green pigment called **biliverdin** (the same pigment that makes bile green and gives healing bruises a greenish edge)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 3111,
                "end_index": 3160,
                "part_index": null,
                "text": "This can cause a distinctly green hue to the skin"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16
              ],
              "segment": {
                "start_index": 3289,
                "end_index": 3381,
                "part_index": null,
                "text": "Evolutionarily, humans have developed an acute sensitivity to subtle changes in facial color"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17,
                16,
                18
              ],
              "segment": {
                "start_index": 3383,
                "end_index": 3591,
                "part_index": null,
                "text": "Studies have shown that our brains are hardwired to associate yellowish-green facial tones with \"sickness\" or \"rot,\" serving as an evolutionary alarm system to warn us to stay away from contagious individuals"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                19,
                10
              ],
              "segment": {
                "start_index": 3595,
                "end_index": 3767,
                "part_index": null,
                "text": "This visual association is so strong that we created the idiom **\"green around the gills\"** (referring to the rapid loss of color in a person's face and neck during nausea)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 3595,
                "end_index": 3886,
                "part_index": null,
                "text": "This visual association is so strong that we created the idiom **\"green around the gills\"** (referring to the rapid loss of color in a person's face and neck during nausea), which pop culture and cartoonists eventually exaggerated into the fully green, nauseous characters we recognize today"
              },
              "rendered_parts": null
            }
          ],
