              "segment": {
                "start_index": 3863,
                "end_index": 4081,
                "part_index": null,
                "text": "* Despite having electrons at different energy levels, both theories align to show that the physical, spatial distribution of the bonds results in a perfectly symmetrical tetrahedral shape with equal C\u2013H bond lengths"
              },
              "rendered_parts": null
            }
