          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 513,
                "end_index": 715,
                "part_index": null,
                "text": "* **Faint lines:** If you see a second line that has **visible color** (pink or blue) and it appeared **within the test\u2019s recommended reading window** (usually 3 to 5 minutes), it is a positive result"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                0
              ],
              "segment": {
                "start_index": 717,
                "end_index": 802,
                "part_index": null,
                "text": "In the very early stages of pregnancy, hCG levels are low, which makes the line faint"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1283,
                "end_index": 1554,
                "part_index": null,
                "text": "Negative Result\n* **What it looks like:** Only the control line is visible, a minus sign, or the words \"Not Pregnant.\"\n* **Testing too early:** If you test before or right around the day of your missed period, your hCG levels might still be too low for the test to detect"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                0
              ],
              "segment": {
                "start_index": 1557,
                "end_index": 1716,
                "part_index": null,
                "text": "* **Next steps:** If your period is late but your test is negative, wait 48 hours and test again using your first-morning urine, which is the most concentrated"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1944,
                "end_index": 2105,
                "part_index": null,
                "text": "Evaporation Line (Commonly Confused for a Faint Positive)\n* **What it looks like:** A faint, colorless, grey, or shadow-like line where the second line should be"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2107,
                "end_index": 2158,
                "part_index": null,
                "text": "* **Why it happens:** This is not a positive result"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                0
              ],
              "segment": {
                "start_index": 2160,
                "end_index": 2233,
                "part_index": null,
                "text": "It is a line left behind by the urine as it evaporates off the test strip"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 2235,
                "end_index": 2381,
                "part_index": null,
                "text": "Evaporation lines typically appear **after** the manufacturer\u2019s recommended reading window has passed (usually 10 minutes or more after testing)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                0
              ],
              "segment": {
                "start_index": 2461,
                "end_index": 2550,
                "part_index": null,
                "text": "Take a new test and make sure to read the result strictly within the 3-to-5-minute window"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                0
              ],
              "segment": {
                "start_index": 2805,
                "end_index": 2986,
                "part_index": null,
                "text": "### Tips for Getting the Most Accurate Result\n* **Use first-morning urine:** Your urine is most concentrated when you first wake up, which makes it easier for the test to detect hCG"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                0
              ],
              "segment": {
                "start_index": 3040,
                "end_index": 3135,
                "part_index": null,
                "text": "Do not read the test before the minimum time has passed, and do not look at it after 10 minutes"
              },
              "rendered_parts": null
            }
          ],
