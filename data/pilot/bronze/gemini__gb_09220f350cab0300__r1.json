          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 130,
                "end_index": 256,
                "part_index": null,
                "text": "Even though you are using filtered water, it is almost certainly a combination of two things: **mineral deposits (limescale)**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 130,
                "end_index": 291,
                "part_index": null,
                "text": "Even though you are using filtered water, it is almost certainly a combination of two things: **mineral deposits (limescale)** and **biofilm (microbial growth)**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                4
              ],
              "segment": {
                "start_index": 490,
                "end_index": 708,
                "part_index": null,
                "text": "** Most of them use activated carbon, which is highly effective at removing chlorine, heavy metals, pesticides, and bad tastes or odors, but they leave dissolved minerals like calcium and magnesium completely untouched"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 712,
                "end_index": 824,
                "part_index": null,
                "text": "* **How it forms:** Every time you sip from the glass, take a drink, or let it sit, some of the water evaporates"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                5
              ],
              "segment": {
                "start_index": 826,
                "end_index": 890,
                "part_index": null,
                "text": "When water evaporates, it leaves those dissolved minerals behind"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 892,
                "end_index": 1084,
                "part_index": null,
                "text": "Over a week of continuous refilling, these minerals stack up, bonding to the glass as a chalky, white film\u2014especially around the water line and where individual drops have dried on the sides"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 1094,
                "end_index": 1289,
                "part_index": null,
                "text": "Biofilm (Microbial Growth)\nWhenever you drink from a glass, your lips and mouth transfer saliva, dead skin cells, and natural oral bacteria to the rim and into the water (often called \"backwash\")"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1293,
                "end_index": 1411,
                "part_index": null,
                "text": "* **How it forms:** If a glass goes unwashed for a week, it becomes a perfect, damp breeding ground for these microbes"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1413,
                "end_index": 1556,
                "part_index": null,
                "text": "Together with microscopic airborne mold spores and yeast, they begin to colonize the glass, creating a thin, sticky matrix called a **biofilm**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1558,
                "end_index": 1658,
                "part_index": null,
                "text": "This biofilm can look like a cloudy, milky, or slightly opaque film on the wet surfaces of the glass"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1668,
                "end_index": 1895,
                "part_index": null,
                "text": "Settling Dust\nIf the glass sits uncovered on a nightstand, desk, or counter, microscopic dust, pet dander, and fibers from the air settle onto the water\u2019s surface and stick to the damp glass as the water level rises and falls"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 2106,
                "end_index": 2177,
                "part_index": null,
                "text": "* If it feels **rough, dry, or chalky**, it is likely **mineral scale**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 2181,
                "end_index": 2244,
                "part_index": null,
                "text": "* If it feels **slippery, slimy, or smooth**, it is **biofilm**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                10
              ],
              "segment": {
                "start_index": 2246,
                "end_index": 2325,
                "part_index": null,
                "text": "* **The Vinegar Test:** Put a splash of white vinegar on a rag and rub the film"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                11
              ],
              "segment": {
                "start_index": 2329,
                "end_index": 2442,
                "part_index": null,
                "text": "* If the film dissolves instantly, it is **mineral scale** (the acid in vinegar breaks down the alkaline calcium)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 2446,
                "end_index": 2546,
                "part_index": null,
                "text": "* If the vinegar does nothing but dish soap and a sponge easily wipe it away, it is **biofilm/dust**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                13
              ],
              "segment": {
                "start_index": 2570,
                "end_index": 2610,
                "part_index": null,
                "text": "The mineral scale is completely harmless"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2612,
                "end_index": 2666,
                "part_index": null,
                "text": "However, the biofilm is a colony of bacteria and yeast"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                14
              ],
              "segment": {
                "start_index": 2668,
                "end_index": 2850,
                "part_index": null,
                "text": "While it is mostly made of your own mouth microbes, letting them sit and multiply at room temperature for a week can introduce external bacteria or mold, which is not ideal to ingest"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15
              ],
              "segment": {
                "start_index": 2879,
                "end_index": 3005,
                "part_index": null,
                "text": "**Wash more frequently:** To avoid biofilm, it is highly recommended to swap out or wash your drinking glass every 1 to 2 days"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 3011,
                "end_index": 3173,
                "part_index": null,
                "text": "**Cover your glass:** Use a coaster or a small lid to cover the top of the glass when you aren't drinking to prevent dust and airborne spores from settling inside"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                9
              ],
              "segment": {
                "start_index": 3178,
                "end_index": 3363,
                "part_index": null,
                "text": "**Use vinegar to clean:** If minerals are stubbornly clinging to the glass, soak it in a 50/50 mix of warm water and white vinegar for 15 minutes before washing it with normal dish soap"
              },
              "rendered_parts": null
            }
          ],
