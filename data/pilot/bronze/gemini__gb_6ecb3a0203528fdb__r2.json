              "web": {
                "domain": null,
                "title": "nih.gov",
                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEjMtX6qzdm8mRwjSSCh4GEfimdiUe2JEpon-BvpMXgIEbilYuZNcq3qv5Y6lZUmPMYXZUKWYSDtp1L0aWodEz5eHq2p-MYKgnKC7CPEJrdpSpYh0Q1NDlQnVuNIpnsE1q-CLMyTRwc"
