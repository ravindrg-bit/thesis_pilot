              "maps": null,
              "retrieved_context": null,
              "web": {
                "domain": null,
                "title": "youtube.com",
                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEGyK49r1P-ZUdJ1x46zkk981JcsH5VQb12YvnTlreGGXJyYvUfkgkyZCySCMcyo-7bl-aalTNzecpE52yVtOcfsIoe_RdiK-sAM8htv8wVezEr_3VnKcQ6Sd7mvJuZdz0="
