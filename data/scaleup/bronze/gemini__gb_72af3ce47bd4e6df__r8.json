                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFwHM3fsDHOHrqr0Xrp5onKA_gQ7lR9nKLrMv813dRR86rAsPZvrmi32nVt7zXDuMRelsRj-bL94vknpPKn9iN-Gf_1OoxcUCsCnJSq3S82pb0Nb5ZXMLFe5z7Q9zqISw7SOyf87czCQczivtrf3OgBIOojaKb9Ufqx24Ow88Q="
