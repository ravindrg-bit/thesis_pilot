              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                4
              ],
              "segment": {
                "start_index": 1255,
                "end_index": 1374,
                "part_index": null,
                "text": "To heat your body up quickly, your blood vessels constrict dramatically to prevent heat from escaping through your skin"
