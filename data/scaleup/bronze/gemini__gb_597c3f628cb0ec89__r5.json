              "segment": {
                "start_index": 2321,
                "end_index": 2516,
                "part_index": null,
                "text": "*   **Civil Law and *Lex Mitior*:** In many civil-law jurisdictions (found in continental Europe and Latin America), there is a legal doctrine called ***lex mitior*** (Latin for \"the milder law\")"
              },
              "rendered_parts": null
            },
