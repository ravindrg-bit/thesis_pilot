          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 178,
                "part_index": null,
                "text": "To estimate how many times an average human blinks in a lifetime, we have to look at a few key variables: how fast we blink, how many hours we are awake, and our average lifespan"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2
              ],
              "segment": {
                "start_index": 182,
                "end_index": 386,
                "part_index": null,
                "text": "By looking at both a **realistic biological estimate** (which accounts for sleep) and a **simplified mathematical estimate** (which is commonly cited online), we can determine the range of lifetime blinks"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 401,
                "end_index": 546,
                "part_index": null,
                "text": "The Realistic Estimate (Accounting for Sleep)\nSince humans do not blink while sleeping, we should only calculate blinking during our waking hours"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 549,
                "end_index": 660,
                "part_index": null,
                "text": "* **Blinks per minute:** Healthy adults blink between **15 and 20 times per minute** under normal circumstances"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 662,
                "end_index": 714,
                "part_index": null,
                "text": "We will use an average of **17.5 blinks per minute**"
              },
