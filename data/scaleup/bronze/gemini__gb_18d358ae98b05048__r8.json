          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": null,
                "end_index": 159,
                "part_index": null,
                "text": "You **cannot legally buy a live Japanese dwarf flying squirrel** (*Pteromys momonga*) or its northern Japanese cousin, the Ezo momonga (*Pteromys volans orii*)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 163,
                "end_index": 281,
                "part_index": null,
                "text": "While they are famous on the internet for their incredibly cute, anime-like appearance, they are not available as pets"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 285,
                "end_index": 403,
                "part_index": null,
                "text": "### Why You Can\u2019t Buy One\n* **Strict Wildlife Laws in Japan:** The Japanese dwarf flying squirrel is native to Japan"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 405,
                "end_index": 686,
                "part_index": null,
                "text": "Under Japan\u2019s Wildlife Protection and Management Law, it is strictly illegal to capture, raise, keep, or breed native wild mammals without specific, highly regulated government permits (which are only granted for conservation research or wildlife rescue, never for pet ownership)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 689,
                "end_index": 796,
                "part_index": null,
                "text": "* **Export Prohibitions:** Japan does not allow these squirrels to be exported for the commercial pet trade"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 948,
                "end_index": 1020,
                "part_index": null,
                "text": "There are zero legitimate breeders of this species anywhere in the world"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 1163,
                "end_index": 1316,
                "part_index": null,
                "text": "** They will either steal your money via a fraudulent shipping/handling scheme or illegally ship you a completely different, potentially smuggled species"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                10
              ],
              "segment": {
                "start_index": 1461,
                "end_index": 1639,
                "part_index": null,
                "text": "A Legal Alternative: The Southern Flying Squirrel (*Glaucomys volans*)\nIf you live in the United States, you can legally buy and own a **Southern Flying Squirrel** in many states"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                11
              ],
              "segment": {
                "start_index": 1641,
                "end_index": 1816,
                "part_index": null,
                "text": "They are native to North America, look remarkably similar to the Japanese dwarf flying squirrel, and bond very closely with their owners (often sleeping in pockets or pouches)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1818,
                "end_index": 1940,
                "part_index": null,
                "text": "* **Where to find them:** You can purchase them from USDA-licensed exotic breeders such as *JEAR (Janda Exotics)* in Texas"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                9
              ],
              "segment": {
                "start_index": 1977,
                "end_index": 2124,
                "part_index": null,
                "text": "* *Note: Always check your local and state laws first, as some U.S. states (like California and Utah) prohibit keeping any flying squirrels as pets"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                13
              ],
              "segment": {
                "start_index": 2136,
                "end_index": 2194,
                "part_index": null,
                "text": "Sugar Gliders\nSugar gliders are marsupials (not squirrels)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                11
              ],
              "segment": {
                "start_index": 2136,
                "end_index": 2297,
                "part_index": null,
                "text": "Sugar Gliders\nSugar gliders are marsupials (not squirrels), but they possess the same gliding membranes, large nocturnal eyes, and \"pocket pet\" bonding qualities"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                11
              ],
              "segment": {
                "start_index": 2299,
                "end_index": 2397,
                "part_index": null,
                "text": "They are widely bred in captivity and much easier to legally purchase and find veterinary care for"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2408,
                "end_index": 2560,
                "part_index": null,
                "text": "Plushies and Merchandise\nBecause of their popularity, you can buy incredibly realistic and highly rated plush toys of the Japanese dwarf flying squirrel"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15
              ],
              "segment": {
                "start_index": 2563,
                "end_index": 2677,
                "part_index": null,
                "text": "* For example, **Wild Republic** makes a popular 8-inch *Cuddlekins Eco Mini Japanese Dwarf Flying Squirrel* plush"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                17
              ],
              "segment": {
                "start_index": 2679,
                "end_index": 2801,
                "part_index": null,
                "text": "* Artists on **Etsy** also sell highly detailed, needle-felted models and stickers of both the *Momonga* and *Ezo momonga*"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                18,
                19
              ],
              "segment": {
                "start_index": 2812,
                "end_index": 2920,
                "part_index": null,
                "text": "Wildlife Tourism in Japan\nIf your dream is to see one in person, the best way to do so is to travel to Japan"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                4
              ],
              "segment": {
                "start_index": 2922,
                "end_index": 3001,
                "part_index": null,
                "text": "You can book nocturnal wildlife tours in **Hokkaido** (to spot the Ezo momonga)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                20,
                19
              ],
              "segment": {
                "start_index": 2922,
                "end_index": 3117,
                "part_index": null,
                "text": "You can book nocturnal wildlife tours in **Hokkaido** (to spot the Ezo momonga) or the sub-alpine forests of **Honshu** (to spot the Japanese dwarf flying squirrel) with experienced nature guides"
              },
              "rendered_parts": null
            }
          ],
