              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                5
              ],
              "segment": {
                "start_index": 976,
                "end_index": 1148,
                "part_index": null,
                "text": "The Realistic Estimate (Accounting for Sleep)\nAssuming the average person sleeps for 8 hours a night, we are awake and active for **16 hours a day** (or 960 waking minutes)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1150,
                "end_index": 1233,
                "part_index": null,
                "text": "Healthy adults blink between **15 and 20 times per minute** under normal conditions"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1300,
                "end_index": 1442,
                "part_index": null,
                "text": "#### **Low-End Estimate (15 blinks per minute)**\n* **Per day:** $15\\text{ blinks} \\times 960\\text{ waking minutes} = 14,400\\text{ blinks/day}$"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1300,
                "end_index": 1533,
                "part_index": null,
                "text": "#### **Low-End Estimate (15 blinks per minute)**\n* **Per day:** $15\\text{ blinks} \\times 960\\text{ waking minutes} = 14,400\\text{ blinks/day}$\n* **Per year:** $14,400 \\times 365.25\\text{ days} \\approx 5.26\\text{ million blinks/year}$"
