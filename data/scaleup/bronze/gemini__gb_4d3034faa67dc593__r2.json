          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 417,
                "end_index": 472,
                "part_index": null,
                "text": "1200\u20131000 BC)\n* **Location:** Sichuan Province, China"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 417,
                "end_index": 627,
                "part_index": null,
                "text": "1200\u20131000 BC)\n* **Location:** Sichuan Province, China\n* **What we know:** In 1986, construction workers accidentally unearthed massive sacrificial pits containing thousands of gold, jade, and bronze artifacts"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                2
              ],
              "segment": {
                "start_index": 629,
                "end_index": 762,
                "part_index": null,
                "text": "Among the finds were towering, highly stylized bronze masks with protruding, alien-like eyes, and a 13-foot-tall bronze \"sacred tree\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 764,
                "end_index": 909,
                "part_index": null,
                "text": "Their metalworking technology was incredibly advanced\u2014far more sophisticated than anything previously known to exist in that region at the time"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 911,
                "end_index": 1048,
                "part_index": null,
                "text": "* **The Mystery:** Traditional Chinese historical texts\u2014which are famously meticulous\u2014make absolutely no mention of this civilization"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1050,
                "end_index": 1141,
                "part_index": null,
                "text": "They left behind no written records, and scientists have found no human remains at the site"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                3
              ],
              "segment": {
                "start_index": 1143,
                "end_index": 1342,
                "part_index": null,
                "text": "We do not know who their leaders were, what their stylized artwork represented, or why they suddenly smashed, burned, and buried all of their most sacred treasures before abandoning the city entirely"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                5
              ],
              "segment": {
                "start_index": 1372,
                "end_index": 1427,
                "part_index": null,
                "text": "1500 BC \u2013 AD 1)\n* **Location:** Kaduna State, Nigeria"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                6,
                7
              ],
              "segment": {
                "start_index": 1372,
                "end_index": 1591,
                "part_index": null,
                "text": "1500 BC \u2013 AD 1)\n* **Location:** Kaduna State, Nigeria\n* **What we know:** Discovered by accident during a tin-mining operation in 1928, the Nok culture is the earliest known iron-smelting society in sub-Saharan Africa"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                7
              ],
              "segment": {
                "start_index": 1593,
                "end_index": 1749,
                "part_index": null,
                "text": "They are famous for creating highly detailed, expressive terracotta sculptures featuring individuals with elaborate hairstyles, jewelry, and triangular eyes"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                7
              ],
              "segment": {
                "start_index": 1751,
                "end_index": 1847,
                "part_index": null,
                "text": "These sculptures suggest a highly structured society with a complex religious or funerary system"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                6
              ],
              "segment": {
                "start_index": 1849,
                "end_index": 2006,
                "part_index": null,
                "text": "* **The Mystery:** \"Nok\" is simply the name of the modern village where the first artifacts were found\u2014we have no idea what they actually called themselves"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 2127,
                "end_index": 2238,
                "part_index": null,
                "text": "Furthermore, around AD 1, they vanished from the archaeological record for reasons that remain entirely unknown"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 2283,
                "end_index": 2355,
                "part_index": null,
                "text": "5050\u20132950 BC)\n* **Location:** Modern-day Romania, Moldova, and Ukraine"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 2283,
                "end_index": 2506,
                "part_index": null,
                "text": "5050\u20132950 BC)\n* **Location:** Modern-day Romania, Moldova, and Ukraine\n* **What we know:** Living during the Copper Age, this society built some of the largest settlements on Earth at the time, housing up to 40,000 people"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 2508,
                "end_index": 2605,
                "part_index": null,
                "text": "They were master potters, creating stunning, intricately painted ceramics with geometric patterns"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 2607,
                "end_index": 2849,
                "part_index": null,
                "text": "* **The Mystery:** This civilization practiced a bizarre, systematic ritual: every 60 to 80 years, they would completely burn their entire settlement to the ground, pack up, and rebuild a new one on top of the ashes or in a different location"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                11
              ],
              "segment": {
                "start_index": 2851,
                "end_index": 2930,
                "part_index": null,
                "text": "Archeologists have found hundreds of these \"burnt houses\" across Eastern Europe"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                13
              ],
              "segment": {
                "start_index": 3113,
                "end_index": 3194,
                "part_index": null,
                "text": "9th\u20135th centuries BC)\n* **Location:** Southern Iberian Peninsula (modern Spain)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                12,
                15
              ],
              "segment": {
                "start_index": 3113,
                "end_index": 3371,
                "part_index": null,
                "text": "9th\u20135th centuries BC)\n* **Location:** Southern Iberian Peninsula (modern Spain)\n* **What we know:** Mentioned in Greek, Roman, and Phoenician texts as a fabulously wealthy kingdom overflowing with gold, silver, and copper, Tartessos was a major trading hub"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                16
              ],
              "segment": {
                "start_index": 3373,
                "end_index": 3575,
                "part_index": null,
                "text": "Recent excavations (such as at Casas de Turu\u00f1uelo) have uncovered massive, highly sophisticated two-story buildings, beautiful stone busts showing their faces, and evidence of massive animal sacrifices"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 3578,
                "end_index": 3680,
                "part_index": null,
                "text": "* **The Mystery:** Despite their incredible wealth, the capital city of Tartessos has never been found"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 3682,
                "end_index": 3730,
                "part_index": null,
                "text": "They had a writing system, but we cannot read it"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                12
              ],
              "segment": {
                "start_index": 3732,
                "end_index": 3797,
                "part_index": null,
                "text": "Around the 5th century BC, Tartessos seemingly vanished overnight"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16
              ],
              "segment": {
                "start_index": 3799,
                "end_index": 4028,
                "part_index": null,
                "text": "At multiple sites, archaeologists have found that the Tartessians held massive final banquets, sacrificed dozens of horses and cattle, and then systematically burned their own palaces, buried them in clay, and walked away forever"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17,
                15
              ],
              "segment": {
                "start_index": 4030,
                "end_index": 4141,
                "part_index": null,
                "text": "Whether they were fleeing Carthaginians, a devastating tsunami, or an economic collapse is still highly debated"
              },
              "rendered_parts": null
            }
          ],
