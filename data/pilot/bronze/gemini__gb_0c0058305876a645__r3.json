              ],
              "segment": {
                "start_index": 1957,
                "end_index": 2137,
                "part_index": null,
                "text": "*   **Suppressants:** If you have a dry, hacking cough that is keeping you awake, medications with **dextromethorphan** (e.g., Delsym or Robitussin) can help quiet the cough reflex"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2139,
                "end_index": 2294,
                "part_index": null,
                "text": "*   **Natural Alternative:** For adults and children over the age of one, a spoonful of **honey** has been shown to be highly effective at soothing a cough"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
