                "domain": null,
                "title": "phoenixrefining.com",
                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGDn60P1O3UBTaGatkoHeMlIboMnbcCw4NKZGU6l_sKZPkjZTFEX4irnlHRyOegJL_R6gfdu4LulqmetiVMsALXq0LPNL5qJrIJz0SIoI6hB7IR1nL-60zeOP40pKI74tWn3b5JSYxgs8UrqMj5hFZk"
