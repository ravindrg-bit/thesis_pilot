          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 254,
                "end_index": 496,
                "part_index": null,
                "text": "The Fees Charged to Investors (% of Assets under Management)\nWhen you invest in a mutual fund, the management company charges an annual fee called an **expense ratio**, which is taken as a percentage of the total Assets Under Management (AUM)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 614,
                "end_index": 699,
                "part_index": null,
                "text": "The management fee typically ranges from **0.5% to 1.5%** of your investment per year"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 701,
                "end_index": 782,
                "part_index": null,
                "text": "(For example, if you have $10,000 in a fund with a 1% fee, you pay $100 annually)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 784,
                "end_index": 924,
                "part_index": null,
                "text": "* **Passively Managed Funds (Index Funds):** These funds simply track an index (like the S&P 500) and require very little human intervention"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                2
              ],
              "segment": {
                "start_index": 926,
                "end_index": 993,
                "part_index": null,
                "text": "Their fees are much lower, typically ranging from **0.02% to 0.2%**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 995,
                "end_index": 1172,
                "part_index": null,
                "text": "* **No Performance Fees:** Unlike hedge funds\u2014which famously charge \"2 and 20\" (a 2% asset fee plus 20% of all profits)\u2014**mutual funds almost never charge performance fees**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 1174,
                "end_index": 1263,
                "part_index": null,
                "text": "They make their percentage regardless of whether the fund goes up or down in a given year"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                9
              ],
              "segment": {
                "start_index": 1462,
                "end_index": 1598,
                "part_index": null,
                "text": "That fee goes to the parent company (e.g., Fidelity, Vanguard, BlackRock) to pay for legal, marketing, administrative, and trading costs"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                11
              ],
              "segment": {
                "start_index": 1602,
                "end_index": 1720,
                "part_index": null,
                "text": "Individual mutual fund managers are compensated through a combination of a **base salary** and a **performance bonus**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 1884,
                "end_index": 2110,
                "part_index": null,
                "text": "40% to 50% of fees):** Generally, asset management firms allocate roughly **40% to 50% of the fund\u2019s total fee revenue** to compensate the investment team (which includes the lead manager, co-managers, and research analysts)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                9
              ],
              "segment": {
                "start_index": 2112,
                "end_index": 2315,
                "part_index": null,
                "text": "* **The \"Basis Point\" equivalent:** On average, a successful mutual fund manager's total personal compensation equates to roughly **0.05% to 0.15% (5 to 15 basis points)** of the total assets they manage"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 2418,
                "end_index": 2524,
                "part_index": null,
                "text": "The fund charges a **0.75%** management fee, generating **$7.5 million** in annual revenue for the company"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 2529,
                "end_index": 2631,
                "part_index": null,
                "text": "The company allocates roughly 50% of that ($3.75 million) to the investment team\u2019s compensation pool"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 2636,
                "end_index": 2748,
                "part_index": null,
                "text": "The supporting analysts are paid, and the lead portfolio manager takes home a salary + bonus of **$1.5 million**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 2754,
                "end_index": 2838,
                "part_index": null,
                "text": "In this scenario, the manager personally made **0.15%** of the total fund\u2019s assets"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 2841,
                "end_index": 2951,
                "part_index": null,
                "text": "### Summary of what they make:\n* **The Company\u2019s Cut:** **0.5% to 1.5%** of the fund's total assets annually"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                13
              ],
              "segment": {
                "start_index": 2953,
                "end_index": 3087,
                "part_index": null,
                "text": "* **The Individual\u2019s Cut:** A base salary (typically $150,000 to $250,000) plus a massive bonus tied to performance and asset growth"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                14,
                9
              ],
              "segment": {
                "start_index": 3089,
                "end_index": 3283,
                "part_index": null,
                "text": "At major firms, a successful manager's total annual compensation easily ranges from **$1 million to over $5 million** (which represents a tiny fraction of a percent of the billions they oversee)"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
