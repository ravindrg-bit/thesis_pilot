              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                8
              ],
              "segment": {
                "start_index": 1930,
                "end_index": 2054,
                "part_index": null,
                "text": "**Digestive Discomfort:** Some people report mild nausea, diarrhea, or an upset stomach from highly concentrated supplements"
