              ],
              "segment": {
                "start_index": 1585,
                "end_index": 1753,
                "part_index": null,
                "text": "Standard Free Trials (3 Months)\nIf you have an inactive SiriusXM radio in your car, or if you want to stream on your phone, you can sign up for a **3-month free trial**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 1755,
                "end_index": 1899,
                "part_index": null,
                "text": "* **In-Car:** If you bought a used car, you can check SiriusXM's website to see if your vehicle's Radio ID is eligible for a complimentary trial"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                12
              ],
              "segment": {
                "start_index": 1901,
                "end_index": 1968,
                "part_index": null,
                "text": "Some vehicle promotions don't even require a credit card to sign up"
