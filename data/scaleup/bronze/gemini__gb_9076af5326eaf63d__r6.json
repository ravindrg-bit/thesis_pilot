          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": null,
                "end_index": 104,
                "part_index": null,
                "text": "While the natural biological sex ratio at birth is roughly 1:1 (technically about 105 boys to 100 girls)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 374,
                "end_index": 570,
                "part_index": null,
                "text": "The Spousal Age Gap and the \"Cohort Effect\" (The Mathematics)\nThe most powerful factor sustaining polygamy is a significant age gap between husbands and wives, combined with high population growth"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 574,
                "end_index": 744,
                "part_index": null,
                "text": "In polygynous societies, men typically delay marriage until they are older (e.g., late 20s or 30s) to accumulate wealth, while women marry much younger (e.g., late teens)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 746,
                "end_index": 829,
                "part_index": null,
                "text": "In a growing population, each successive generation is larger than the previous one"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 1332,
                "end_index": 1396,
                "part_index": null,
                "text": "This demographic phenomenon is known as the **marriage squeeze**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                1
              ],
              "segment": {
                "start_index": 1398,
                "end_index": 1646,
                "part_index": null,
                "text": "A study published in the *Proceedings of the National Academy of Sciences (PNAS)* demonstrated that in growing populations, a modest age gap between spouses naturally skews the marriage market sufficiently feminine to sustain high rates of polygyny"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1656,
                "end_index": 1793,
                "part_index": null,
