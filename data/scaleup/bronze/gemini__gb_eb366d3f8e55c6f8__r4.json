              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1398,
                "end_index": 1568,
                "part_index": null,
                "text": "*   **Brown Tumors (Rare):** In severe, long-standing cases of hyperparathyroidism, rapid bone destruction can result in benign, cystic bone lesions called \"brown tumors\""
