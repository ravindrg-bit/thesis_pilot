          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 305,
                "part_index": null,
                "text": "To answer how much a mutual fund manager \"makes\" in terms of percentages, it is helpful to look at it from two different perspectives: **what percentage the mutual fund company charges investors** (the management fee) versus **what percentage the individual manager personally takes home** as compensation"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 320,
                "end_index": 490,
                "part_index": null,
                "text": "The Fund\u2019s Percentage Fee (What the firm charges)\nWhen you invest in a mutual fund, the fund house charges an annual fee called an **expense ratio** to manage the money"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 492,
                "end_index": 542,
                "part_index": null,
                "text": "The largest part of this is the **management fee**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                6,
                7
              ],
              "segment": {
                "start_index": 545,
                "end_index": 681,
                "part_index": null,
                "text": "* **Actively Managed Mutual Funds:** The management fee typically ranges from **0.5% to 1.5%** of Assets Under Management (AUM) annually"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 683,
                "end_index": 815,
                "part_index": null,
                "text": "For example, if a manager oversees a $1 billion active fund with a 1.0% fee, the fund company collects $10 million in fees that year"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                9
              ],
              "segment": {
                "start_index": 818,
                "end_index": 1052,
                "part_index": null,
                "text": "* **Passively Managed Mutual Funds (Index Funds):** Because these funds simply track an index (like the S&P 500) and require less hands-on management, their fees are much lower, typically ranging from **0.02% to 0.2%** of AUM annually"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                11
              ],
              "segment": {
                "start_index": 1054,
                "end_index": 1309,
                "part_index": null,
                "text": "* **No Performance Fees (Unlike Hedge Funds):** Unlike hedge fund managers who typically charge \"2 and 20\" (a 2% management fee **plus 20% of all profits**), mutual fund managers are legally prohibited in the U.S. from charging asymmetric performance fees"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                12
              ],
              "segment": {
                "start_index": 1311,
                "end_index": 1479,
                "part_index": null,
                "text": "In rare cases, they may use a \"fulcrum fee,\" which symmetrically increases or decreases their fee percentage based on whether they beat or fall behind a benchmark index"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                13
              ],
              "segment": {
                "start_index": 1494,
                "end_index": 1647,
                "part_index": null,
                "text": "The Individual Manager\u2019s Compensation (What the actual person makes)\nThe individual portfolio manager does *not* personally pocket the 0.5% to 1.5% fee"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                8
              ],
              "segment": {
                "start_index": 1649,
                "end_index": 1827,
                "part_index": null,
                "text": "That money goes to the asset management company (e.g., Fidelity, Vanguard, BlackRock) to cover operating expenses, compliance, research analysts, marketing, and corporate profits"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                15
              ],
              "segment": {
                "start_index": 1831,
                "end_index": 1981,
                "part_index": null,
                "text": "Instead, the individual mutual fund manager is a salaried employee whose compensation is structured around a base salary and a performance-based bonus"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                17
              ],
              "segment": {
                "start_index": 1984,
                "end_index": 2127,
                "part_index": null,
                "text": "* **The Base Salary:** Typically ranges from **$200,000 to $450,000+** per year, depending on the size of the firm and the manager's experience"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17,
                15
              ],
              "segment": {
                "start_index": 2129,
                "end_index": 2332,
                "part_index": null,
                "text": "* **The Bonus (The \"Percentage\" part of their pay):** The bulk of a manager's income comes from their year-end bonus, which is often 1 to 3 times their base salary (and can be much higher for superstars)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15,
                18
              ],
              "segment": {
                "start_index": 2469,
                "end_index": 2652,
                "part_index": null,
                "text": "80% of funds):** Most managers have their bonuses tied to how well they beat their target benchmark (like the Russell 2000 or S&P 500) over a rolling 1-year, 3-year, and 5-year period"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                17,
                15
              ],
              "segment": {
                "start_index": 2696,
                "end_index": 2936,
                "part_index": null,
                "text": "20% of funds):** Some firms explicitly tie a portion of the bonus directly to a tiny percentage (usually measured in basis points, or hundredths of a percent) of the total AUM they manage or the net inflows of new investor cash they attract"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                19,
                17
              ],
              "segment": {
                "start_index": 2983,
                "end_index": 3096,
                "part_index": null,
                "text": "Because of this structure, a mutual fund manager's total pay is highly dependent on the size of the fund they run"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17
              ],
              "segment": {
                "start_index": 2983,
                "end_index": 3189,
                "part_index": null,
                "text": "Because of this structure, a mutual fund manager's total pay is highly dependent on the size of the fund they run:\n* **Median Fund Manager:** Earns around **$462,000** in total compensation (salary + bonus)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                17
              ],
              "segment": {
                "start_index": 3191,
                "end_index": 3430,
                "part_index": null,
                "text": "* **Superstar/Large-Cap Fund Managers:** Managers overseeing mega-funds (tens of billions of dollars) frequently take home **$1 million to $5 million+** per year due to the massive scale of the fees their fund generates for the parent firm"
              },
              "rendered_parts": null
            }
          ],
