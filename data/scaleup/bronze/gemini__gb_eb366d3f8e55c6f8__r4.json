              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1570,
                "end_index": 1717,
                "part_index": null,
                "text": "If a brown tumor develops in the cervical vertebrae, it can cause localized neck pain, structural instability, or nerve compression (radiculopathy)"
