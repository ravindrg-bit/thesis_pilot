          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 238,
                "end_index": 290,
                "part_index": null,
                "text": "The U.S. is already a \"bilingual\" measurement nation"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2
              ],
              "segment": {
                "start_index": 292,
                "end_index": 454,
                "part_index": null,
                "text": "The U.S. Customary System (inches, pounds, Fahrenheit) is defined officially in terms of the metric system (specifically the International System of Units, or SI)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 456,
                "end_index": 627,
                "part_index": null,
                "text": "Furthermore, major sectors\u2014including science, medicine, the military, and global manufacturing (like the automotive industry)\u2014already operate almost entirely in metric"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                4
              ],
              "segment": {
                "start_index": 1120,
                "end_index": 1207,
                "part_index": null,
                "text": "Every single speed limit sign, distance sign, and mile marker would have to be replaced"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 1371,
                "end_index": 1501,
                "part_index": null,
                "text": "A 1970s estimate scaled to modern dollars suggests replacing and recalculating road signs alone would cost **billions of dollars**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 1585,
                "end_index": 1655,
                "part_index": null,
                "text": "American building standards are built entirely on customary increments"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                4
              ],
              "segment": {
                "start_index": 1822,
                "end_index": 1982,
                "part_index": null,
                "text": "Overhauling building codes, retooling factories that make these materials, and training millions of contractors would cost trillions of dollars and take decades"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 2151,
                "end_index": 2291,
                "part_index": null,
                "text": "Translating every legally binding property line in the country into square meters would result in a tsunami of administrative and legal work"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                9
              ],
              "segment": {
                "start_index": 2478,
                "end_index": 2607,
                "part_index": null,
                "text": "Forcing a change means shops would have to maintain double inventories of tools and parts for decades to service legacy equipment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 3031,
                "end_index": 3111,
                "part_index": null,
                "text": "In contrast, Celsius is built around water (0\u00b0C is freezing, 100\u00b0C is boiling)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                1
              ],
              "segment": {
                "start_index": 3551,
                "end_index": 3679,
                "part_index": null,
                "text": "*   **The Legacy of Backlash:** The U.S. tried a coordinated push toward metrication after the **Metric Conversion Act of 1975**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 3681,
                "end_index": 3836,
                "part_index": null,
                "text": "It was highly unpopular; citizens felt the metric system was an unnecessary government overreach, and the U.S. Metric Board was eventually defunded in 1982"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                13
              ],
              "segment": {
                "start_index": 4117,
                "end_index": 4273,
                "part_index": null,
                "text": "*   **The Canadian Example:** Canada officially metricated in the 1970s, but because of its massive trade relationship with the U.S., the transition stalled"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                14,
                15
              ],
              "segment": {
                "start_index": 4275,
                "end_index": 4479,
                "part_index": null,
                "text": "Today, Canadians drive in km/h and buy gas in liters, but they still measure their height in feet and inches, weigh themselves in pounds, use Fahrenheit for their ovens, and buy lumber in customary inches"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                17
              ],
              "segment": {
                "start_index": 4482,
                "end_index": 4576,
                "part_index": null,
                "text": "*   **The British Example:** The UK began metrication in the 1960s but is still fiercely split"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                18,
                17
              ],
              "segment": {
                "start_index": 4578,
                "end_index": 4739,
                "part_index": null,
                "text": "Road signs are still in miles, speed limits are in mph, milk and beer are legally mandated to be sold in pints, and people still measure their weight in \"stones\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 4922,
                "end_index": 4991,
                "part_index": null,
                "text": "If a transition ever happens, it will be **generational and organic**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                19,
                2
              ],
              "segment": {
                "start_index": 4993,
                "end_index": 5150,
                "part_index": null,
                "text": "As global supply chains become more tightly integrated and digital systems natively handle automatic conversions, the friction of using two systems decreases"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 5152,
                "end_index": 5440,
                "part_index": null,
                "text": "The U.S. is highly likely to remain a hybrid country for the foreseeable future: relying on metric for everything that connects to the global economy (science, tech, medicine, manufacturing), while keeping customary units for local, everyday life (weather, driving, and home construction)"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
