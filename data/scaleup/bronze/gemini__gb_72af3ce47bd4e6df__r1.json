                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEe079DxseKm9byuBCGGfxxA2jIAVWL4s07Q4YLyLBT6Qs0TPryISF6I_drjItrDwNKKpsRvAOj5YSleX9tatMjF8PIDjJ-h1c4wV7RWUFUWFS-8MPpjG0UQlZ-QXAb63Cqn5ZbLFEQC1ikfgisfQxzQtWwaM-brQm5MPWyzbosjIh3LFcEUV0="
