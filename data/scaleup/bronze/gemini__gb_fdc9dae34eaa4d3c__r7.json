            },
            {
              "image": null,
              "maps": null,
              "retrieved_context": null,
              "web": {
                "domain": null,
                "title": "nih.gov",
                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEPa_TzGg2245eOQS7UOMUcjMU_rvs7q0_2PB6RraArXilZn4CXxQEDmioWZyXmnlG42vBp4EldtgxYKXywGXn_hDqYs501PdUp8fRZEWPavtUSwodVhv1ilNi8MWcGFTEAB_s="
