          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 153,
                "end_index": 271,
                "part_index": null,
                "text": "To evaluate whether gold is undervalued, we have to look at its current position\u2014trading around **$4,300 per ounce**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2
              ],
              "segment": {
                "start_index": 153,
                "end_index": 391,
                "part_index": null,
                "text": "To evaluate whether gold is undervalued, we have to look at its current position\u2014trading around **$4,300 per ounce** after a dramatic run-up to an all-time high of over **$5,400** in January 2026, followed by a correction of roughly 20%"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 650,
                "end_index": 808,
                "part_index": null,
                "text": "**Sovereign Debt and Money Supply Expansion:** \n   If you value gold relative to the sheer volume of fiat currency in circulation, it does not look overpriced"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                3
              ],
              "segment": {
                "start_index": 810,
                "end_index": 1004,
                "part_index": null,
                "text": "Global central bank balance sheets, soaring U.S. and international debt levels, and cumulative inflation over the past several years mean that paper currencies have lost massive purchasing power"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1006,
                "end_index": 1102,
                "part_index": null,
                "text": "Against this backdrop of currency debasement, $4,300 gold can be viewed as a rational adjustment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                6
              ],
              "segment": {
                "start_index": 1107,
                "end_index": 1334,
                "part_index": null,
                "text": "**De-Dollarization and Central Bank Buying:** \n   Central banks worldwide (particularly in emerging economies like China, Poland, and Brazil) continue to diversify their reserves away from the U.S. dollar and into physical gold"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                5
              ],
              "segment": {
                "start_index": 1336,
                "end_index": 1499,
                "part_index": null,
                "text": "A structural shift toward a multipolar financial system provides a permanent floor for gold demand that is largely independent of typical retail investor sentiment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1504,
                "end_index": 1638,
                "part_index": null,
                "text": "**The Gold-to-Silver Ratio:** \n   With silver experiencing explosive price action (briefly hitting $110 per ounce earlier in the year)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 1504,
                "end_index": 1694,
                "part_index": null,
                "text": "**The Gold-to-Silver Ratio:** \n   With silver experiencing explosive price action (briefly hitting $110 per ounce earlier in the year), the gold-to-silver ratio compressed to around **50:1**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 1696,
                "end_index": 1854,
                "part_index": null,
                "text": "Historically, when this ratio is low, it can signal that gold is relatively undervalued compared to its sister metal and may be poised to lead the next leg up"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                5,
                10
              ],
              "segment": {
                "start_index": 1859,
                "end_index": 2020,
                "part_index": null,
                "text": "**Deeply Undervalued Mining Stocks:** \n   Even if physical gold is debated, there is strong consensus that **gold mining equities** are significantly undervalued"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                11
              ],
              "segment": {
                "start_index": 2022,
                "end_index": 2213,
                "part_index": null,
                "text": "Many producers are generating record-breaking free cash flows with gold above $4,000, yet their stock prices are still trading at very conservative multiples on an \"ounce-in-the-ground\" basis"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2438,
                "end_index": 2502,
                "part_index": null,
                "text": "**Price Anchoring:** \n   Historically, $4,300 is incredibly high"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2504,
                "end_index": 2622,
                "part_index": null,
                "text": "For investors anchored to the $1,800\u2013$2,000 ranges of 2022\u20132023, the current price feels like a speculative bubble"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 2624,
                "end_index": 2664,
                "part_index": null,
                "text": "After skyrocketing more than 70% in 2025"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                12
              ],
              "segment": {
                "start_index": 2624,
                "end_index": 2775,
                "part_index": null,
                "text": "After skyrocketing more than 70% in 2025, critics argue that the market became heavily overbought and still needs to bleed off excess speculative froth"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                2
              ],
              "segment": {
                "start_index": 2780,
                "end_index": 2899,
                "part_index": null,
                "text": "**Rising Opportunity Costs (Higher Interest Rates):** \n   Gold is a non-yielding asset; it pays no dividend or interest"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 2901,
                "end_index": 3014,
                "part_index": null,
                "text": "With U.S. employment data coming in unexpectedly strong (e.g., May nonfarm payrolls nearly doubling expectations)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                14
              ],
              "segment": {
                "start_index": 2901,
                "end_index": 3122,
                "part_index": null,
                "text": "With U.S. employment data coming in unexpectedly strong (e.g., May nonfarm payrolls nearly doubling expectations), the market has begun pricing in a higher-for-longer interest rate environment or even potential rate hikes"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 3124,
                "end_index": 3210,
                "part_index": null,
                "text": "Higher yields on safe-haven competitors like U.S. Treasuries make gold less attractive"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15
              ],
              "segment": {
                "start_index": 3215,
                "end_index": 3381,
                "part_index": null,
                "text": "**A More Hawkish Federal Reserve:** \n   The nomination of Kevin Warsh as the next Fed Chair has signaled to markets a potentially tighter, less dovish monetary policy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15
              ],
              "segment": {
                "start_index": 3383,
                "end_index": 3467,
                "part_index": null,
                "text": "This has strengthened the U.S. dollar, historically a major headwind for gold prices"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                17
              ],
              "segment": {
                "start_index": 3472,
                "end_index": 3656,
                "part_index": null,
                "text": "**Supply Responses:** \n   High gold prices have naturally incentivized a surge in scrap gold recycling and motivated mining companies to bring older, offline mines back into production"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                17
              ],
              "segment": {
                "start_index": 3658,
                "end_index": 3745,
                "part_index": null,
                "text": "Increased supply could dampen the supply-demand deficit that helped fuel the 2025 rally"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                3
              ],
              "segment": {
                "start_index": 3766,
                "end_index": 3949,
                "part_index": null,
                "text": "* **In nominal, historical terms,** gold is not cheap, and near-term headwinds like rising bond yields, a stronger dollar, and hawkish Fed expectations could keep pressuring the metal"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                5
              ],
              "segment": {
                "start_index": 3951,
                "end_index": 4130,
                "part_index": null,
                "text": "* **In structural, monetary terms,** gold is arguably fairly valued or even undervalued when adjusted for massive global debt, geopolitical fragmentation, and persistent inflation"
              },
              "rendered_parts": null
            }
          ],
