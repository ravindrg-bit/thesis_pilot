          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 228,
                "part_index": null,
                "text": "The **Lockheed P-3 Orion** is a legendary four-engine, turboprop maritime patrol and anti-submarine warfare (ASW) aircraft that served as the backbone of the U.S. Navy\u2019s land-based ocean surveillance fleet for over six decades"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 232,
                "end_index": 318,
                "part_index": null,
                "text": "Based on the civilian Lockheed L-188 Electra airliner, the P-3 entered service in 1962"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                2,
                3
              ],
              "segment": {
                "start_index": 320,
                "end_index": 536,
                "part_index": null,
                "text": "It is most famous for its role during the Cold War, tracking Soviet submarines, but evolved into a highly versatile multi-mission platform used for overland reconnaissance, anti-surface warfare, and search and rescue"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                3
              ],
              "segment": {
                "start_index": 551,
                "end_index": 731,
                "part_index": null,
                "text": "Key Design and Capabilities\n* **Submarine Hunting (ASW):** The P-3's most recognizable feature is its long tail stinger, which houses **Magnetic Anomaly Detection (MAD) equipment**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                3
              ],
              "segment": {
                "start_index": 733,
                "end_index": 846,
                "part_index": null,
                "text": "This sensor detects the metallic hulls of submerged submarines by measuring changes in the Earth's magnetic field"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                6
              ],
              "segment": {
                "start_index": 848,
                "end_index": 957,
                "part_index": null,
                "text": "It also deploys **sonobuoys** (acoustic detection devices dropped into the water) to track underwater targets"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2,
                7
              ],
              "segment": {
                "start_index": 959,
                "end_index": 1193,
                "part_index": null,
                "text": "* **Exceptional Endurance:** Powered by four Allison T-56-A-14 turboprop engines, the Orion was designed to fly at low altitudes and slow speeds for up to 10\u201312 hours at a time, allowing it to loiter over search areas far out at sea"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                7
              ],
              "segment": {
                "start_index": 1195,
                "end_index": 1280,
                "part_index": null,
                "text": "* **Heavy Armament:** The P-3 features an internal bomb bay and under-wing hardpoints"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1282,
                "end_index": 1455,
                "part_index": null,
                "text": "It can carry a diverse array of weaponry, including **Mk 46/50/54 lightweight torpedoes**, **AGM-84 Harpoon anti-ship missiles**, Maverick missiles, mines, and depth charges"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                8
              ],
              "segment": {
                "start_index": 1470,
                "end_index": 1557,
                "part_index": null,
                "text": "Major Variants\n* **P-3C Orion:** The standard and most advanced baseline patrol version"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1559,
                "end_index": 1686,
                "part_index": null,
                "text": "It received numerous electronics and acoustic processor upgrades over the decades to keep pace with modern submarine technology"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                10
              ],
              "segment": {
                "start_index": 1688,
                "end_index": 1802,
                "part_index": null,
                "text": "* **EP-3E Aries II:** A highly specialized **Signals Intelligence (SIGINT)** and electronic reconnaissance variant"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                12
              ],
              "segment": {
                "start_index": 1804,
                "end_index": 1916,
                "part_index": null,
                "text": "It was packed with highly sensitive antennas and receivers to intercept enemy communications and radar emissions"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 1918,
                "end_index": 2084,
                "part_index": null,
                "text": "An EP-3E was notably involved in the 2001 **Hainan Island incident**, where it made an emergency landing in China after a mid-air collision with a Chinese fighter jet"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 2086,
                "end_index": 2344,
                "part_index": null,
                "text": "* **WP-3D Orion:** Operated by the National Oceanic and Atmospheric Administration (NOAA), these specialized aircraft (nicknamed *\"Kermit\"* and *\"Miss Piggy\"*) are used as \"Hurricane Hunters\" to fly directly into tropical storms to gather meteorological data"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                14
              ],
              "segment": {
                "start_index": 2359,
                "end_index": 2480,
                "part_index": null,
                "text": "Retirement and Current Status\nThe U.S. Navy has phased out the P-3 Orion family in favor of modern, jet-powered platforms"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15
              ],
              "segment": {
                "start_index": 2483,
                "end_index": 2689,
                "part_index": null,
                "text": "* **Active-Duty Patrol Transition:** Starting in 2012, the Navy began transitioning all active-duty maritime patrol squadrons from the P-3C to the **Boeing P-8A Poseidon** (based on the Boeing 737 airliner)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15
              ],
              "segment": {
                "start_index": 2691,
                "end_index": 2757,
                "part_index": null,
                "text": "This transition for active-duty patrol units was completed in 2020"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                17
              ],
              "segment": {
                "start_index": 2759,
                "end_index": 2911,
                "part_index": null,
                "text": "* **The Final Sundown (2025):** The electronic reconnaissance variant, the **EP-3E Aries II**, remained in service longer due to its unique capabilities"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                18,
                11
              ],
              "segment": {
                "start_index": 2913,
                "end_index": 2999,
                "part_index": null,
                "text": "However, the U.S. Navy **officially retired its last EP-3E Aries II in February 2025**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                19
              ],
              "segment": {
                "start_index": 3001,
                "end_index": 3149,
                "part_index": null,
                "text": "Fleet Air Reconnaissance Squadron One (VQ-1), the final operational squadron flying the EP-3-based aircraft, deactivated shortly after in March 2025"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                20,
                19
              ],
              "segment": {
                "start_index": 3152,
                "end_index": 3392,
                "part_index": null,
                "text": "* **Replacement Platforms:** The P-3's historical roles are now split between the **P-8A Poseidon** (manned maritime patrol) and the **MQ-4C Triton** (a high-altitude, long-endurance unmanned aerial vehicle used for broad-area surveillance)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                21
              ],
              "segment": {
                "start_index": 3422,
                "end_index": 3579,
                "part_index": null,
                "text": "** \n  * Within the U.S., a tiny number of specialized P-3s still operate in non-combat support roles, such as Navy test and evaluation squadrons (like VX-30)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 3422,
                "end_index": 3608,
                "part_index": null,
                "text": "** \n  * Within the U.S., a tiny number of specialized P-3s still operate in non-combat support roles, such as Navy test and evaluation squadrons (like VX-30), scientific research (VXS-1)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 3422,
                "end_index": 3614,
                "part_index": null,
                "text": "** \n  * Within the U.S., a tiny number of specialized P-3s still operate in non-combat support roles, such as Navy test and evaluation squadrons (like VX-30), scientific research (VXS-1), NOAA"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                21
              ],
              "segment": {
                "start_index": 3422,
                "end_index": 3660,
                "part_index": null,
                "text": "** \n  * Within the U.S., a tiny number of specialized P-3s still operate in non-combat support roles, such as Navy test and evaluation squadrons (like VX-30), scientific research (VXS-1), NOAA, and U.S. Customs and Border Protection (CBP)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                13,
                22
              ],
              "segment": {
                "start_index": 3664,
                "end_index": 3827,
                "part_index": null,
                "text": "* Internationally, several allied militaries\u2014including Japan, South Korea, Greece, and Argentina\u2014continue to operate and upgrade their own fleets of P-3 Orions"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
          "search_entry_point": {
