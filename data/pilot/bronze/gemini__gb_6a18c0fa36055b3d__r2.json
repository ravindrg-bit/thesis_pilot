          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 168,
                "end_index": 269,
                "part_index": null,
                "text": "While **ketchup** and **mayonnaise** packets are indeed shelf-stable and do not require refrigeration"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 168,
                "end_index": 400,
                "part_index": null,
                "text": "While **ketchup** and **mayonnaise** packets are indeed shelf-stable and do not require refrigeration, the premise about **sour cream** is actually a common misconception\u2014**real dairy sour cream packets must always be refrigerated"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 511,
                "end_index": 703,
                "part_index": null,
                "text": "Ketchup and Mayonnaise: The Science of Shelf-Stability\nMany people are surprised to learn that even large bottles of ketchup and mayonnaise are completely shelf-stable *before* they are opened"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                5
              ],
              "segment": {
                "start_index": 705,
                "end_index": 781,
                "part_index": null,
                "text": "They only require refrigeration because of what happens *after* we open them"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 858,
                "end_index": 962,
                "part_index": null,
                "text": "* **High Acidity (Low pH):** Bacteria and foodborne pathogens struggle to survive in acidic environments"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 969,
                "end_index": 1044,
                "part_index": null,
                "text": "* **Ketchup** has a very low pH (highly acidic) due to tomatoes and vinegar"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                1
              ],
              "segment": {
                "start_index": 1051,
                "end_index": 1150,
                "part_index": null,
                "text": "* Commercial **mayonnaise** is also highly acidic because it is loaded with vinegar and lemon juice"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 1230,
                "end_index": 1432,
                "part_index": null,
                "text": "* **No \"After Opening\" Phase:** The warning on a bottle that says *\"Refrigerate after opening\"* is not because the condiment itself suddenly goes bad, but because **outside contamination** is introduced"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                8
              ],
              "segment": {
                "start_index": 1434,
                "end_index": 1547,
                "part_index": null,
                "text": "Every time you open a jar of mayo, double-dip a knife, or let room-air in, you introduce bacteria and mold spores"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                10
              ],
              "segment": {
                "start_index": 1621,
                "end_index": 1701,
                "part_index": null,
                "text": "Because small packets are **single-use**, you open them and eat them immediately"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                9
              ],
              "segment": {
                "start_index": 1703,
                "end_index": 1775,
                "part_index": null,
                "text": "There is no \"open\" phase where they sit in a cupboard gathering bacteria"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                8
              ],
              "segment": {
                "start_index": 1777,
                "end_index": 1877,
                "part_index": null,
                "text": "* **Airtight and Sterile Packaging:** Condiment packets are filled in a sterile, commercial facility"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                8
              ],
              "segment": {
                "start_index": 1879,
                "end_index": 2001,
                "part_index": null,
                "text": "The foil-lined plastic film is completely airtight, preventing oxygen (which bacteria and mold need to grow) from entering"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2003,
                "end_index": 2100,
                "part_index": null,
                "text": "It also blocks out light, which prevents the oils in mayonnaise from oxidizing and turning rancid"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 2103,
                "end_index": 2179,
                "part_index": null,
                "text": "*Note: While unopened packets won\u2019t make you sick, they don't last forever"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                12
              ],
              "segment": {
                "start_index": 2181,
                "end_index": 2316,
                "part_index": null,
                "text": "Over many months, the plastic will slowly let in tiny amounts of oxygen, causing the ketchup to turn dark brown or the mayo to separate"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 2332,
                "end_index": 2553,
                "part_index": null,
                "text": "Why Sour Cream is Different (And MUST Be Refrigerated)\nIf you have seen sour cream packets or squeeze pouches (like Daisy brand) sitting out, they are either non-dairy alternatives (like aseptic-packaged vegan sour cream)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 2332,
                "end_index": 2588,
                "part_index": null,
                "text": "Why Sour Cream is Different (And MUST Be Refrigerated)\nIf you have seen sour cream packets or squeeze pouches (like Daisy brand) sitting out, they are either non-dairy alternatives (like aseptic-packaged vegan sour cream), or they are being stored unsafely"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                14
              ],
              "segment": {
                "start_index": 2592,
                "end_index": 2669,
                "part_index": null,
                "text": "**Real dairy sour cream must always be kept refrigerated (below 40\u00b0F / 4\u00b0C)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                2
              ],
              "segment": {
                "start_index": 2687,
                "end_index": 2790,
                "part_index": null,
                "text": "* **It is a Live Dairy Product:** Sour cream is made by fermenting real cream with lactic acid bacteria"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 2792,
                "end_index": 2947,
                "part_index": null,
                "text": "Because it contains active, live cultures, it cannot be completely sterilized during packaging without destroying the very bacteria that make it sour cream"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 2950,
                "end_index": 3075,
                "part_index": null,
                "text": "* **Low Acid, High Moisture and Fat:** Unlike ketchup, sour cream is a fresh dairy product with high moisture and fat content"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 3077,
                "end_index": 3188,
                "part_index": null,
                "text": "It is not acidic enough to prevent the growth of dangerous pathogens like *Listeria* or *Staphylococcus aureus*"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                14
              ],
              "segment": {
                "start_index": 3191,
                "end_index": 3360,
                "part_index": null,
                "text": "* **The 2-Hour Rule:** If a packet of real dairy sour cream is left at room temperature for more than two hours, it is considered unsafe to eat and should be thrown away"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                9,
                5
              ],
              "segment": {
                "start_index": 3364,
                "end_index": 3591,
                "part_index": null,
                "text": "### Summary\n* **Ketchup and Mayo packets** don't need refrigeration because they are highly acidic, sterilely sealed, and designed for immediate, single-use consumption\u2014leaving no time for post-opening bacterial contamination"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                2
              ],
              "segment": {
                "start_index": 3593,
                "end_index": 3798,
                "part_index": null,
                "text": "* **Sour cream packets** *do* need refrigeration because they are fresh dairy products containing live cultures and do not have the acid or salt levels required to stop bacterial growth at room temperature"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
