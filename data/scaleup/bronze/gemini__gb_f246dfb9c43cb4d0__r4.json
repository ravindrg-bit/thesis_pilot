              ],
              "segment": {
                "start_index": 2124,
                "end_index": 2239,
                "part_index": null,
                "text": "#### Power and Lifespan\n* **Sputnik 1:** Had to carry heavy chemical batteries inside its pressurized nitrogen hull"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 2241,
                "end_index": 2410,
                "part_index": null,
                "text": "Once those batteries depleted after three weeks, the satellite went completely silent and became space junk, eventually burning up in the atmosphere 92 days after launch"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                6
              ],
              "segment": {
                "start_index": 2752,
                "end_index": 2867,
                "part_index": null,
                "text": "#### Navigation and Control (Propulsion)\n* **Sputnik 1:** Was entirely at the mercy of gravity and atmospheric drag"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 3156,
                "end_index": 3232,
                "part_index": null,
                "text": "Modern constellations also feature **automatic collision-avoidance systems**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 3323,
                "end_index": 3435,
                "part_index": null,
                "text": "#### Mission Capability\n* **Sputnik 1:** Its primary mission was geopolitical and technological proof of concept"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 3437,
                "end_index": 3565,
                "part_index": null,
                "text": "Its scientific output was limited to studying how its simple radio signals behaved when traveling through the Earth's ionosphere"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                9
              ],
              "segment": {
                "start_index": 3962,
                "end_index": 4035,
                "part_index": null,
                "text": "* **Modern Satellites:** We now live in the era of **megaconstellations**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
