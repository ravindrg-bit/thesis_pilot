          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 348,
                "end_index": 464,
                "part_index": null,
                "text": "Low Population Density and Nomadism\nIn the era of hunter-gatherers, the human population was small and highly mobile"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 466,
                "end_index": 579,
                "part_index": null,
                "text": "Waterborne killer diseases like cholera, typhoid, and dysentery are primarily spread through the fecal-oral route"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 581,
                "end_index": 746,
                "part_index": null,
                "text": "Because early humans did not live in dense, permanent settlements, they did not stay in one place long enough to heavily pollute their local water sources with waste"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 855,
                "end_index": 951,
                "part_index": null,
                "text": "Sourcing Naturally Filtered Water\nEarly humans knew how to seek out naturally safe water sources"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2
              ],
              "segment": {
                "start_index": 855,
                "end_index": 1165,
                "part_index": null,
                "text": "Sourcing Naturally Filtered Water\nEarly humans knew how to seek out naturally safe water sources:\n* **Groundwater and Springs:** Rainwater that seeps deep into the earth goes through a natural filtration process as it trickles through layers of sand, clay, soil, and rock, which strips out biological pathogens"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                1
              ],
              "segment": {
                "start_index": 1167,
                "end_index": 1224,
                "part_index": null,
                "text": "Springs and deep wells were highly prized for this reason"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                1
              ],
              "segment": {
                "start_index": 1226,
                "end_index": 1312,
                "part_index": null,
                "text": "* **Fast-Flowing Headwaters:** Humans preferred fast-moving rivers or mountain streams"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                5
              ],
              "segment": {
                "start_index": 1455,
                "end_index": 1586,
                "part_index": null,
                "text": "Fermentation and \"Small Beer\"\nAs populations grew and local water sources became contaminated, people turned to fermented beverages"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                6
              ],
              "segment": {
                "start_index": 1588,
                "end_index": 1738,
                "part_index": null,
                "text": "For thousands of years, beer, ale, cider, and wine were the primary sources of daily hydration for many civilizations, particularly in medieval Europe"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                7
              ],
              "segment": {
                "start_index": 1740,
                "end_index": 1906,
                "part_index": null,
                "text": "* **The Brewing Process:** While people did not yet understand germ theory, the process of brewing beer required **boiling the water**, which killed harmful pathogens"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                7
              ],
              "segment": {
                "start_index": 1908,
                "end_index": 2072,
                "part_index": null,
                "text": "* **Preservation:** The resulting beverage had a low alcohol content (known as \"small beer,\" often around 1% to 2% ABV, which was drank by both adults and children)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 2074,
                "end_index": 2194,
                "part_index": null,
                "text": "The combination of mild alcohol and acidity acted as a natural preservative, keeping the drink safe to store and consume"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                8
              ],
              "segment": {
                "start_index": 2534,
                "end_index": 2840,
                "part_index": null,
                "text": "While they did not have modern treatment plants, early civilizations developed highly effective low-tech purification methods:\n* **Boiling and Sunlight:** Sanskrit medical texts (dating back to 2000 BCE) and ancient Egyptian records recommend boiling water over fire or leaving it in the sun to \"purify\" it"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 2842,
                "end_index": 2973,
                "part_index": null,
                "text": "* **Oligodynamic Metals:** Ancient civilizations in India, Egypt, and Greece stored their water in copper, brass, or silver vessels"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                11
              ],
              "segment": {
                "start_index": 2975,
                "end_index": 3174,
                "part_index": null,
                "text": "These metals possess **oligodynamic properties**, meaning metal ions naturally leach into the water in tiny amounts and destroy the cellular membranes of bacteria, algae, and fungi within a few hours"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                12
              ],
              "segment": {
                "start_index": 3176,
                "end_index": 3323,
                "part_index": null,
                "text": "* **Sand and Charcoal Filtration:** Ancient Greeks and Romans built complex sand-and-gravel filtration systems to clarify water and remove sediment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                7
              ],
              "segment": {
                "start_index": 3519,
                "end_index": 3691,
                "part_index": null,
                "text": "While this did not protect humans from microscopic, odorless pathogens, it successfully kept them away from rotting organic matter and stagnant pools where parasites thrive"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                14
              ],
              "segment": {
                "start_index": 3856,
                "end_index": 3984,
                "part_index": null,
                "text": "Historically, infant and child mortality rates were staggeringly high\u2014often 30% to 50% of children did not survive to age five"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                14
              ],
              "segment": {
                "start_index": 3986,
                "end_index": 4063,
                "part_index": null,
                "text": "A massive portion of these deaths was caused by waterborne diarrheal diseases"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                15
              ],
              "segment": {
                "start_index": 4065,
                "end_index": 4139,
                "part_index": null,
                "text": "Entire cities were regularly decimated by outbreaks of cholera and typhoid"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                14
              ],
              "segment": {
                "start_index": 4141,
                "end_index": 4401,
                "part_index": null,
                "text": "It was only with the introduction of municipal sand filtration and chlorination in the late 19th and early 20th centuries that drinking water became universally safe in developed nations, triggering one of the greatest leaps in human life expectancy in history"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
