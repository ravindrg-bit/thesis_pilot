          ],
          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 101,
                "part_index": null,
                "text": "**Coagulopathy** is a medical condition in which the body\u2019s ability to form blood clots is impaired"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                1
              ],
              "segment": {
                "start_index": 103,
                "end_index": 257,
                "part_index": null,
                "text": "This can lead to prolonged or excessive bleeding (hypocoagulability) or, conversely, abnormal and dangerous clotting (hypercoagulability or thrombophilia)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                2
              ],
              "segment": {
                "start_index": 261,
                "end_index": 426,
                "part_index": null,
                "text": "The clotting process (hemostasis) relies on a delicate balance between platelets (cells that plug damaged vessels) and proteins called coagulation (clotting) factors"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 428,
                "end_index": 527,
                "part_index": null,
                "text": "Coagulopathies occur when there is a deficiency, dysfunction, or complete absence of these elements"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 530,
                "end_index": 629,
                "part_index": null,
                "text": "The causes of coagulopathy are broadly categorized into **Inherited (Congenital)** and **Acquired**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                4,
                5
              ],
              "segment": {
                "start_index": 644,
                "end_index": 796,
                "part_index": null,
                "text": "Inherited (Congenital) Causes\nThese are genetic conditions present at birth, typically involving a deficiency or mutation in a specific clotting protein"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 799,
                "end_index": 880,
                "part_index": null,
                "text": "*   **von Willebrand Disease (vWD):** The most common inherited bleeding disorder"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 882,
                "end_index": 1022,
                "part_index": null,
                "text": "It is caused by a deficiency or dysfunction of the von Willebrand factor, a protein that helps platelets stick to damaged blood vessel walls"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1069,
                "end_index": 1096,
                "part_index": null,
                "text": "A deficiency of Factor VIII"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                8
              ],
              "segment": {
                "start_index": 1102,
                "end_index": 1167,
                "part_index": null,
                "text": "*   *Hemophilia B (Christmas Disease):* A deficiency of Factor IX"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 1377,
                "end_index": 1633,
                "part_index": null,
                "text": "*   **Inherited Thrombophilias (Hypercoagulability):** Genetic mutations that cause the blood to clot *too* easily, such as Factor V Leiden, Prothrombin G20210A mutation, or deficiencies in natural anticoagulants like Protein C, Protein S, and Antithrombin"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 1648,
                "end_index": 1796,
                "part_index": null,
                "text": "Acquired Causes\nThese conditions develop during a person\u2019s lifetime due to other medical conditions, external injuries, or medication side effects"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1799,
                "end_index": 1878,
                "part_index": null,
                "text": "*   **Liver Disease:** Nearly all coagulation factors are produced by the liver"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                7
              ],
              "segment": {
                "start_index": 1880,
                "end_index": 2075,
                "part_index": null,
                "text": "Severe liver diseases\u2014such as cirrhosis, hepatitis, or acute liver failure\u2014disrupt the synthesis of these proteins, making liver disease one of the most common causes of acquired coagulopathy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 2077,
                "end_index": 2240,
                "part_index": null,
                "text": "*   **Vitamin K Deficiency:** Vitamin K is a crucial building block required by the liver to synthesize several vital clotting factors (Factors II, VII, IX, and X)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 2242,
                "end_index": 2453,
                "part_index": null,
                "text": "A deficiency can arise from poor diet, malabsorption disorders (e.g., celiac disease, Crohn's disease), or prolonged use of broad-spectrum antibiotics that destroy gut bacteria (which normally produce vitamin K)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                8
              ],
              "segment": {
                "start_index": 2455,
                "end_index": 2578,
                "part_index": null,
                "text": "*   **Medications:**\n    *   *Anticoagulants (Blood Thinners):* Medications like warfarin (which interferes with Vitamin K)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 2455,
                "end_index": 2587,
                "part_index": null,
                "text": "*   **Medications:**\n    *   *Anticoagulants (Blood Thinners):* Medications like warfarin (which interferes with Vitamin K), heparin"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 2756,
                "end_index": 2840,
                "part_index": null,
                "text": "Drugs like aspirin and clopidogrel impair the ability of platelets to clump together"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                7
              ],
              "segment": {
                "start_index": 2842,
                "end_index": 3030,
                "part_index": null,
                "text": "*   **Disseminated Intravascular Coagulation (DIC):** A life-threatening systemic condition where clotting factors and platelets are hyper-activated, forming tiny clots throughout the body"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 3032,
                "end_index": 3157,
                "part_index": null,
                "text": "This process rapidly depletes (consumes) the body\u2019s supply of clotting factors, leading to massive, uncontrollable bleeding"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 3159,
                "end_index": 3268,
                "part_index": null,
                "text": "DIC is typically triggered by severe sepsis, major trauma, advanced cancer, or severe obstetric complications"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 3270,
                "end_index": 3419,
                "part_index": null,
                "text": "*   **Trauma and Massive Transfusion (Trauma-Induced Coagulopathy):** Severe injury paired with massive blood loss can trigger a complex coagulopathy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                3
              ],
              "segment": {
                "start_index": 3638,
                "end_index": 3826,
                "part_index": null,
                "text": "*   **Autoimmune Inhibitors:** Sometimes the immune system mistakenly develops antibodies (\"inhibitors\") that target and destroy its own clotting factors (such as in Acquired Hemophilia A)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                7
              ],
              "segment": {
                "start_index": 4067,
                "end_index": 4212,
                "part_index": null,
                "text": "### How Coagulopathies Are Diagnosed\nHealthcare providers typically use a panel of blood tests to identify the underlying cause of a coagulopathy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 4067,
                "end_index": 4282,
                "part_index": null,
                "text": "### How Coagulopathies Are Diagnosed\nHealthcare providers typically use a panel of blood tests to identify the underlying cause of a coagulopathy:\n*   **Complete Blood Count (CBC):** To check the number of platelets"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                7
              ],
              "segment": {
                "start_index": 4284,
                "end_index": 4427,
                "part_index": null,
                "text": "*   **Prothrombin Time (PT) / INR:** Evaluates the \"extrinsic\" pathway of clotting; highly sensitive to Vitamin K deficiency and liver function"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                12
              ],
              "segment": {
                "start_index": 4429,
                "end_index": 4583,
                "part_index": null,
                "text": "*   **Activated Partial Thromboplastin Time (aPTT):** Evaluates the \"intrinsic\" pathway; commonly used to screen for hemophilia or monitor heparin therapy"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                12
              ],
              "segment": {
                "start_index": 4585,
                "end_index": 4689,
                "part_index": null,
                "text": "*   **Mixing Studies:** If a clotting time is prolonged, the patient's blood is mixed with normal plasma"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13,
                12
              ],
              "segment": {
                "start_index": 4691,
                "end_index": 4841,
                "part_index": null,
                "text": "If the clotting time corrects, the patient has a *factor deficiency*; if it does not, they have a *factor inhibitor* (an antibody blocking the factor)"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
