              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1577,
                "end_index": 1656,
                "part_index": null,
                "text": "**Skin Issues:** The most common side effect of excessive B12 is dermatological"
