                5
              ],
              "segment": {
                "start_index": 2000,
                "end_index": 2096,
                "part_index": null,
                "text": "However, observations from the **James Webb Space Telescope (JWST)** have challenged this theory"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                5
              ],
              "segment": {
                "start_index": 2098,
                "end_index": 2243,
                "part_index": null,
                "text": "JWST detected fully formed supermassive black holes in the very early universe, some appearing even *before* their host galaxies had time to form"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 2247,
                "end_index": 2471,
                "part_index": null,
                "text": "This has confirmed two major alternative pathways:\n* **Direct Collapse (\"Heavy Seeds\"):** In the early universe, massive clouds of pristine hydrogen and helium gas became so dense that they bypassed the star phase altogether"
