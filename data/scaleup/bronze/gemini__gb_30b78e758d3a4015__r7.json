          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 91,
                "part_index": null,
                "text": "When people talk about \"clean\" gold, they are referring to **fine gold** (or 24-karat gold)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 93,
                "end_index": 231,
                "part_index": null,
                "text": "While you will often see it stamped as **99.9%** (three nines) or **99.99%** (four nines) pure, you will never see a stamp for 100% purity"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 235,
                "end_index": 324,
                "part_index": null,
                "text": "Achieving absolute, 100% purity is scientifically, chemically, and practically impossible"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 340,
                "end_index": 449,
                "part_index": null,
                "text": "The Laws of Physics and Thermodynamics (Entropy)\nAt a fundamental level, the universe resists absolute purity"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 451,
                "end_index": 574,
                "part_index": null,
                "text": "According to the **Second Law of Thermodynamics**, physical systems naturally progress toward a state of disorder (entropy)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 577,
                "end_index": 716,
                "part_index": null,
                "text": "To have a 100% pure block of gold, you would need trillions of trillions of gold atoms aligned perfectly with absolutely zero foreign atoms"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 751,
                "end_index": 851,
                "part_index": null,
                "text": "At a microscopic level, gold will always attract, bond with, or trap trace amounts of other elements"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 861,
                "end_index": 964,
                "part_index": null,
                "text": "The Limits of Chemical Refining\nGold is refined using aggressive chemical and electrochemical processes"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 967,
                "end_index": 1139,
                "part_index": null,
                "text": "* First, the **Miller Process** (bubbling chlorine gas through molten gold) refines gold up to about **99.5%** purity by turning impurities into salts that float to the top"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1142,
                "end_index": 1331,
                "part_index": null,
                "text": "* To get cleaner gold, refineries use the **Wohlwill Process**, an electrolytic method that dissolves the gold and uses electricity to redeposit it onto a cathode, leaving impurities behind"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 1334,
                "end_index": 1441,
                "part_index": null,
                "text": "While this can get gold to **99.9%** or even **99.99%** purity, it faces the law of **diminishing returns**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                5
              ],
              "segment": {
                "start_index": 1443,
                "end_index": 1618,
                "part_index": null,
                "text": "As the concentration of impurities drops, it becomes exponentially harder for the chemical processes to \"find\" and isolate the remaining trace atoms of silver, copper, or iron"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1620,
                "end_index": 1695,
                "part_index": null,
                "text": "Attempting to filter out those last few stray atoms is virtually impossible"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1705,
                "end_index": 1893,
                "part_index": null,
                "text": "Environmental Contamination during Processing\nEven if a refinery could somehow isolate 100% pure gold in a perfect vacuum, the gold has to be melted, poured, and stamped into bars or coins"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1896,
                "end_index": 2046,
                "part_index": null,
                "text": "The moment the molten gold touches a melting crucible, is exposed to the air, or is poured into a mold, it inevitably absorbs microscopic contaminants"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 2048,
                "end_index": 2207,
                "part_index": null,
                "text": "Tiny particles of carbon from the crucible, oxygen from the air, or dust in the room will instantly dissolve into the gold, dropping its purity back below 100%"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 2217,
                "end_index": 2399,
                "part_index": null,
                "text": "Limits of Scientific Measurement\nTo legally stamp a gold bar as \"100% pure,\" a laboratory would have to scientifically prove that there is not a single foreign atom in the entire bar"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 2402,
                "end_index": 2491,
                "part_index": null,
                "text": "However, even the most advanced assaying equipment\u2014like mass spectrometers\u2014has limits"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 2493,
                "end_index": 2603,
                "part_index": null,
                "text": "These machines can only detect impurities down to a certain threshold (parts per million or parts per billion)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                8
              ],
              "segment": {
                "start_index": 2605,
                "end_index": 2754,
                "part_index": null,
                "text": "Because scientists cannot measure down to \"zero\" impurities with absolute certainty, they cannot ethically or legally certify a metal as 100.00% pure"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 2765,
                "end_index": 2868,
                "part_index": null,
                "text": "Diminishing Economic Returns\nRefining gold from 99.9% to 99.99% is already highly complex and expensive"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                6
              ],
              "segment": {
                "start_index": 2870,
                "end_index": 3042,
                "part_index": null,
                "text": "Trying to squeeze out that final 0.01% or 0.1% would require highly specialized laboratory environments, cost millions of dollars, and yield almost no extra financial value"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                10
              ],
              "segment": {
                "start_index": 3046,
                "end_index": 3246,
                "part_index": null,
                "text": "Because **99.9%** (or 99.99%) is already chemically identical to \"pure\" gold for all practical, industrial, and investment purposes, the global gold market accepts this as the gold standard for purity"
              },
              "rendered_parts": null
            }
          ],
