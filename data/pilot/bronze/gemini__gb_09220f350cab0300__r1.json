              "web": {
                "domain": null,
                "title": "thekitchn.com",
                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEZAdFg8MCuw9B1gbfAMO-R58o7qLhwp0p1a5BYmeACFwmwDaeWARK76UEVO7-sLAOBaDFcscmLgOnEy0b9xPC7uzuw2LowMbx7lbA_BNWIpdQfwGVQJ-vpwFSMC97iRq55Ex_hnrf37MXJdnGWVScF"
