          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 361,
                "end_index": 572,
                "part_index": null,
                "text": "### Part 1: What percentage do mutual fund companies charge? (Fees)\nWhen you invest in a mutual fund, the fund management company charges a recurring annual fee expressed as a percentage of your total investment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2
              ],
              "segment": {
                "start_index": 574,
                "end_index": 610,
                "part_index": null,
                "text": "This is called the **Expense Ratio**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 613,
                "end_index": 765,
                "part_index": null,
                "text": "* **Actively Managed Mutual Funds:** If a human manager is actively researching, buying, and selling stocks to try to beat the market, the fee is higher"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                5
              ],
              "segment": {
                "start_index": 770,
                "end_index": 853,
                "part_index": null,
                "text": "* **Management Fee:** Typically **0.50% to 1.00%** of assets under management (AUM)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 855,
                "end_index": 918,
                "part_index": null,
                "text": "This part directly compensates the management and research team"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 922,
                "end_index": 983,
                "part_index": null,
                "text": "* **Total Expense Ratio (TER):** Typically **0.60% to 1.50%**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                6
              ],
              "segment": {
                "start_index": 985,
                "end_index": 1098,
                "part_index": null,
                "text": "This includes the management fee plus administrative, compliance, recordkeeping, and marketing costs (12b-1 fees)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                3
              ],
              "segment": {
                "start_index": 1100,
                "end_index": 1247,
                "part_index": null,
                "text": "* **Passively Managed Index Funds:** If the fund simply tracks an index (like the S&P 500), the fees are minimal because there is no active manager"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                6
              ],
              "segment": {
                "start_index": 1252,
                "end_index": 1313,
                "part_index": null,
                "text": "* **Total Expense Ratio (TER):** Typically **0.02% to 0.20%**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 1382,
                "end_index": 1507,
                "part_index": null,
                "text": "** Unlike hedge fund managers\u2014who famously use a \"2 and 20\" model (taking a 2% flat fee plus **20% of all profits** earned)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 1382,
                "end_index": 1601,
                "part_index": null,
                "text": "** Unlike hedge fund managers\u2014who famously use a \"2 and 20\" model (taking a 2% flat fee plus **20% of all profits** earned)\u2014traditional mutual funds are heavily regulated and almost **never charge performance fees**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 1603,
                "end_index": 1700,
                "part_index": null,
                "text": "They make their percentage fee regardless of whether the fund wins or loses money in a given year"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 1708,
                "end_index": 1937,
                "part_index": null,
                "text": "### Part 2: How much do individual mutual fund managers personally make? (Compensation)\nIf you are wondering how much money the actual human being running the fund takes home, they do **not** directly pocket the 1% management fee"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 1939,
                "end_index": 2033,
                "part_index": null,
                "text": "They are salaried employees of the asset management firm (e.g., Fidelity, Vanguard, BlackRock)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 2036,
                "end_index": 2130,
                "part_index": null,
                "text": "Over **95% of mutual fund managers** are compensated through a **Salary-plus-Bonus** structure"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                15
              ],
              "segment": {
                "start_index": 2133,
                "end_index": 2259,
                "part_index": null,
                "text": "* **The Base Salary:** Usually a fixed six-figure salary depending on their experience, ranging from **$150,000 to $350,000+**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                13
              ],
              "segment": {
                "start_index": 2262,
                "end_index": 2412,
                "part_index": null,
                "text": "* **The Performance Bonus (The bulk of their pay):** About **75% to 80%** of mutual fund managers have their bonuses tied directly to fund performance"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16,
                13
              ],
              "segment": {
                "start_index": 2417,
                "end_index": 2569,
                "part_index": null,
                "text": "* Their bonus is typically calculated based on **how much they beat their benchmark** (like the S&P 500) over a rolling 1-year, 3-year, or 5-year period"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16
              ],
              "segment": {
                "start_index": 2574,
                "end_index": 2726,
                "part_index": null,
                "text": "* They may also receive **profit-sharing** based on the overall profitability of the investment firm, which is tied to the total assets the firm manages"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2777,
                "end_index": 2921,
                "part_index": null,
                "text": "Because of these performance bonuses, a manager\u2019s compensation varies heavily based on the size of the fund they manage and their track record"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17
              ],
              "segment": {
                "start_index": 2777,
                "end_index": 3048,
                "part_index": null,
                "text": "Because of these performance bonuses, a manager\u2019s compensation varies heavily based on the size of the fund they manage and their track record:\n* **Median Compensation:** The median mutual fund manager in the U.S. earns about **$462,000 per year** in total compensation"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17
              ],
              "segment": {
                "start_index": 3050,
                "end_index": 3145,
                "part_index": null,
                "text": "* **Average (Mean) Compensation:** The average is much higher, around **$1.1 million per year**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17
              ],
              "segment": {
                "start_index": 3147,
                "end_index": 3261,
                "part_index": null,
                "text": "This is because elite managers of massive, multi-billion-dollar funds can earn multi-million dollar annual bonuses"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
