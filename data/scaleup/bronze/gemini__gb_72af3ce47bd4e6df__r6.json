          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 113,
                "part_index": null,
                "text": "The fire at the Momart warehouse in Leyton, East London, on May 24, 2004, was far more than a financial write-off"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                1,
                3
              ],
              "segment": {
                "start_index": 115,
                "end_index": 447,
                "part_index": null,
                "text": "While the financial loss was staggering\u2014estimated between \u00a330 million and \u00a350 million and covered by substantial insurance payouts and subsequent legal settlements\u2014the destruction of over a hundred iconic works of contemporary and modern British art had profound cultural, historical, emotional, and philosophical consequences"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 539,
                "end_index": 736,
                "part_index": null,
                "text": "The Erasure of Cultural History and the *Zeitgeist*\nThe physical works destroyed were not just valuable assets; they were the defining artifacts of a highly specific era in British cultural history"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                5
              ],
              "segment": {
                "start_index": 738,
                "end_index": 1051,
                "part_index": null,
                "text": "This included seminal pieces of the **Young British Artists (YBA)** movement of the 1990s, such as Tracey Emin\u2019s *Everyone I Have Ever Slept With 1963\u20131995* (the famous embroidered tent) and Jake and Dinos Chapman's *Hell* (a massive, intricate tableau of miniature figures representing a dystopian nightmare)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 1055,
                "end_index": 1136,
                "part_index": null,
                "text": "Art critics argued that these pieces were \"snapshots\" of a unique cultural moment"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 1138,
                "end_index": 1292,
                "part_index": null,
                "text": "Even if a work can be physically remade, the specific spirit, cultural atmosphere, and artistic impulse of the moment it was conceived cannot be recreated"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                4
              ],
              "segment": {
                "start_index": 1294,
                "end_index": 1373,
                "part_index": null,
                "text": "The fire effectively erased key physical evidence of the 1990s British art boom"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 1383,
                "end_index": 1543,
                "part_index": null,
                "text": "Devastation for the Legacies of Deceased Artists\nFor living artists, the fire was a major setback; but for deceased artists, the loss was absolute and permanent"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1546,
                "end_index": 1662,
                "part_index": null,
                "text": "* **Patrick Heron:** More than 50 major abstract paintings by Patrick Heron (who died in 1999) were reduced to ashes"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1664,
