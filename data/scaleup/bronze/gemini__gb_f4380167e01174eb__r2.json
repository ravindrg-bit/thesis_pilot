              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 1146,
                "end_index": 1264,
                "part_index": null,
                "text": "This voltage spike physically and permanently degraded the silicon inside the CPUs (called **Vmin Shift Instability**)"
