              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1658,
                "end_index": 1731,
                "part_index": null,
                "text": "It can trigger severe **acne-like breakouts** or flare-ups of **rosacea**"
