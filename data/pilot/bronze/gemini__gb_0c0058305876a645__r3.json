              "segment": {
                "start_index": 1647,
                "end_index": 1800,
                "part_index": null,
                "text": "*   **Saline Nasal Sprays or Rinses:** Non-medicated saline sprays or neti pots are excellent, safe ways to flush out mucus and keep nasal passages moist"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
