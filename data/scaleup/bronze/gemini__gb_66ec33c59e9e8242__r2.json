              "web": {
                "domain": null,
                "title": "nih.gov",
                "uri": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQF4a7vMXSvKFtuLUU319ad61qRLBkecdG1nrgilGrCYiJL_eTjW09emDMLdYXz8Nxd_eKVG0pTncY78vsR2mSm1BBHtf7fQWlDlMbqWocTf9ED8IlEvoa2IKMjpK0X-zFkI542sKMChvHGeh5Vg2ywYEpkhYf3D44l2iWelFx00V30_FRH8_qIoqYZqg2J2tn3ADgvAV2vNo0czEI3qIsSHnG_nktSIwYENxwqtna8="
