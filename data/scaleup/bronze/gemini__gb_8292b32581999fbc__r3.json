          ],
          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": null,
                "end_index": 191,
                "part_index": null,
                "text": "The journey of making chocolate\u2014from a tropical fruit hanging on a tree to the smooth, glossy bar that melts in your mouth\u2014is a fascinating mix of agriculture, chemistry, and culinary art"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 193,
                "end_index": 263,
                "part_index": null,
                "text": "This process is known in the industry as the **\"bean-to-bar\" process**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 494,
                "end_index": 548,
                "part_index": null,
                "text": "Harvesting:** Cacao trees produce large, colorful pods"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 550,
                "end_index": 624,
                "part_index": null,
                "text": "Once ripe, workers harvest these pods by hand using machetes or long poles"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 626,
                "end_index": 727,
                "part_index": null,
                "text": "The pods are sliced open to reveal 30 to 50 seeds (cacao beans) nestled in a sweet, white, gooey pulp"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 736,
                "end_index": 805,
                "part_index": null,
                "text": "Fermentation:** This is the most critical step for flavor development"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 807,
                "end_index": 921,
                "part_index": null,
                "text": "The beans and their sugary pulp are scooped out and placed in large wooden boxes, often covered with banana leaves"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 923,
                "end_index": 997,
                "part_index": null,
                "text": "Over 5 to 7 days, naturally occurring yeasts and bacteria ferment the pulp"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                5
              ],
              "segment": {
                "start_index": 999,
                "end_index": 1183,
                "part_index": null,
                "text": "The heat generated by fermentation (up to 120\u00b0F/50\u00b0C) kills the seed germ and triggers biochemical reactions inside the bean, creating the precursors of that classic chocolate flavor"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1192,
                "end_index": 1273,
                "part_index": null,
                "text": "Drying:** After fermentation, the beans are wet and must be dried before they rot"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 1380,
                "end_index": 1500,
                "part_index": null,
                "text": "This drops the moisture content from 60% down to about 7%, making them stable for shipping to chocolate makers worldwide"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                6
              ],
              "segment": {
                "start_index": 1673,
                "end_index": 1730,
                "part_index": null,
                "text": "Roasting:** The beans are roasted in large rotating drums"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                4
              ],
              "segment": {
                "start_index": 1732,
                "end_index": 1919,
                "part_index": null,
                "text": "Roasting kills any bacteria, removes moisture, and develops the deep, rich chocolate aromas through the *Maillard reaction* (the same chemical reaction that Browns steak and toasts bread)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1928,
                "end_index": 2075,
                "part_index": null,
                "text": "Winnowing:** The roasted beans are fed into a winnowing machine that cracks the thin, brittle outer shells and blows them away with a stream of air"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 2077,
                "end_index": 2128,
                "part_index": null,
                "text": "This leaves behind the prize inside: **cacao nibs**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 2137,
                "end_index": 2249,
                "part_index": null,
                "text": "Grinding (Milling):** The nibs (which are roughly 50% fat) are ground down by heavy stone mills or steel rollers"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                1,
                0
              ],
              "segment": {
                "start_index": 2251,
                "end_index": 2424,
                "part_index": null,
                "text": "The friction and heat melt the natural fat (known as **cocoa butter**), turning the solid nibs into a rich, dark, flowing paste called **chocolate liquor** or **cocoa mass**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                0
              ],
              "segment": {
                "start_index": 2676,
                "end_index": 2786,
                "part_index": null,
                "text": "Mixing:** Depending on the type of chocolate being made, other ingredients are mixed into the chocolate liquor"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7
              ],
              "segment": {
                "start_index": 2676,
                "end_index": 2859,
                "part_index": null,
                "text": "Mixing:** Depending on the type of chocolate being made, other ingredients are mixed into the chocolate liquor:\n  * **Dark Chocolate:** Chocolate liquor, sugar, and extra cocoa butter"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 2863,
                "end_index": 2945,
                "part_index": null,
                "text": "* **Milk Chocolate:** Chocolate liquor, sugar, extra cocoa butter, and milk powder"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 3040,
                "end_index": 3091,
                "part_index": null,
                "text": "Refining:** The mixed ingredients still feel gritty"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 3093,
                "end_index": 3283,
                "part_index": null,
                "text": "The mixture is run through a series of heavy steel rollers that crush the sugar crystals and cocoa particles down to a microscopic size\u2014usually under 20 microns (thinner than a human hair)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 3285,
                "end_index": 3396,
                "part_index": null,
                "text": "At this size, the human tongue can no longer detect individual grains, making the mixture feel perfectly smooth"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                8,
                9
              ],
              "segment": {
                "start_index": 3405,
                "end_index": 3602,
                "part_index": null,
                "text": "Conching:** Invented by Swiss chocolatier Rodolphe Lindt in 1879, conching is a process where the refined chocolate is kept warm and constantly agitated, scraped, and aerated for hours or even days"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 3646,
                "end_index": 3748,
                "part_index": null,
                "text": "It rounds off any remaining jagged edges on the sugar and cocoa particles, improving the liquid's flow"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8,
                10
              ],
              "segment": {
                "start_index": 3755,
                "end_index": 3841,
                "part_index": null,
                "text": "It allows unwanted, bitter volatile acids (like acetic acid) to evaporate into the air"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8,
                9
              ],
              "segment": {
                "start_index": 3848,
                "end_index": 3945,
                "part_index": null,
                "text": "It evenly coats every tiny solid particle in cocoa butter, giving chocolate its luxurious texture"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 4018,
                "end_index": 4158,
                "part_index": null,
                "text": "Tempering:** Cocoa butter is a polymorphic fat, meaning its crystals can solidify into six different physical structures (Form I to Form VI)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                5
              ],
              "segment": {
                "start_index": 4160,
                "end_index": 4280,
                "part_index": null,
                "text": "Only **Form V (Beta)** crystals yield chocolate with a glossy shine, a stable shelf life, and a clean \"snap\" when broken"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                11,
                5
              ],
              "segment": {
                "start_index": 4282,
                "end_index": 4459,
                "part_index": null,
                "text": "To achieve this, the chocolate is carefully heated, cooled to a specific temperature to \"seed\" the Form V crystals, and slightly reheated to melt away any unstable crystal types"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                13
              ],
              "segment": {
                "start_index": 4461,
                "end_index": 4563,
                "part_index": null,
                "text": "*(Untempered chocolate is dull, soft, and will quickly develop a dusty white film called \"fat bloom\")*"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11,
                13
              ],
              "segment": {
                "start_index": 4573,
                "end_index": 4735,
                "part_index": null,
                "text": "Molding and Packaging:** The perfectly tempered chocolate is poured into plastic molds, vibrated to release trapped air bubbles, and sent through a cooling tunnel"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                11
              ],
              "segment": {
                "start_index": 4824,
                "end_index": 4898,
                "part_index": null,
                "text": "The finished bars are then wrapped in foil and paper to preserve freshness"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
          "search_entry_point": {
