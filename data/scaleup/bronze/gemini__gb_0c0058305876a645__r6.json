          ],
          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": null,
                "end_index": 105,
                "part_index": null,
                "text": "Because the common cold is a viral infection, there is no cure, and antibiotics will not help you recover"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 107,
                "end_index": 245,
                "part_index": null,
                "text": "Instead, over-the-counter (OTC) medications are used to manage and relieve specific symptoms while your immune system fights off the virus"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 249,
                "end_index": 382,
                "part_index": null,
                "text": "To choose the safest and most effective medicine, target your specific symptoms rather than taking a broad \"multi-symptom\" medication"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 428,
                "end_index": 677,
                "part_index": null,
                "text": "#### For Fever, Headache, Sore Throat, or Body Aches\n*   **What to take:** Pain relievers and fever reducers like **acetaminophen** (Tylenol) or Nonsteroidal Anti-inflammatory Drugs (NSAIDs) like **ibuprofen** (Advil, Motrin) or **naproxen** (Aleve)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                4
              ],
              "segment": {
                "start_index": 758,
                "end_index": 837,
                "part_index": null,
                "text": "** It is linked to a rare but life-threatening condition called Reye's syndrome"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                3
              ],
              "segment": {
                "start_index": 843,
                "end_index": 956,
                "part_index": null,
                "text": "*   Be highly aware of \"double-dosing.\" Many multi-symptom cold liquids and powders already contain acetaminophen"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                6
              ],
              "segment": {
                "start_index": 1790,
                "end_index": 1984,
                "part_index": null,
                "text": "Though widely available on store shelves, the FDA has proposed removing oral phenylephrine from OTC monographs after extensive reviews concluded it is not effective as an oral nasal decongestant"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1987,
                "end_index": 2075,
                "part_index": null,
                "text": "#### For a Runny Nose, Sneezing, or Watery Eyes\n*   **What to take:** **Antihistamines**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2101,
                "end_index": 2236,
                "part_index": null,
                "text": "Use non-drowsy, second-generation antihistamines like **cetirizine** (Zyrtec), **loratadine** (Claritin), or **fexofenadine** (Allegra)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2263,
                "end_index": 2423,
                "part_index": null,
                "text": "First-generation antihistamines like **diphenhydramine** (Benadryl) or **doxylamine succinate** (found in NyQuil) can help dry up a runny nose and promote sleep"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2426,
                "end_index": 2576,
                "part_index": null,
                "text": "*   **Safety Warning:** First-generation antihistamines cause significant drowsiness and should not be taken if you need to drive or operate machinery"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2579,
                "end_index": 2684,
                "part_index": null,
                "text": "#### For a Cough\n*   **For a wet, mucus-filled cough:** Use an expectorant like **guaifenesin** (Mucinex)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2686,
                "end_index": 2744,
                "part_index": null,
                "text": "This thins and loosens mucus, making it easier to cough up"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 2746,
                "end_index": 2892,
                "part_index": null,
                "text": "*   **For a dry, hacking cough:** Use a cough suppressant like **dextromethorphan** (Robitussin, Delsym) to quiet the cough reflex so you can rest"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 2907,
                "end_index": 3080,
                "part_index": null,
                "text": "Supportive Home Remedies (Non-Medicinal)\nSometimes the most effective relief comes from simple home care:\n*   **Hydration:** Drink plenty of water, broth, or warm herbal tea"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 3082,
                "end_index": 3123,
                "part_index": null,
                "text": "This thins mucus and prevents dehydration"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                2
              ],
              "segment": {
                "start_index": 3125,
                "end_index": 3281,
                "part_index": null,
                "text": "*   **Saline Nasal Sprays or Rinses:** Using a saline spray or a Neti pot (with distilled or boiled water) safely clears nasal passages without side effects"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 3283,
                "end_index": 3394,
                "part_index": null,
                "text": "*   **Honey:** One to two teaspoons of honey can soothe a sore throat and is clinically proven to quiet a cough"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 3396,
                "end_index": 3481,
                "part_index": null,
                "text": "*(Never give honey to infants under 1 year of age due to the risk of infant botulism)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                2
              ],
              "segment": {
                "start_index": 3482,
                "end_index": 3592,
                "part_index": null,
                "text": "*\n*   **Humidifier:** Running a cool-mist humidifier in your room adds moisture to the air and eases breathing"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 3594,
                "end_index": 3721,
                "part_index": null,
                "text": "*   **Saltwater Gargle:** Dissolve 1/4 to 1/2 teaspoon of salt in warm water and gargle to temporarily soothe a scratchy throat"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 3736,
                "end_index": 3909,
                "part_index": null,
                "text": "When to See a Doctor\nWhile most colds resolve on their own within 7 to 10 days, you should seek medical evaluation if you experience any of the following \"red flag\" symptoms"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                0
              ],
              "segment": {
                "start_index": 4089,
                "end_index": 4287,
                "part_index": null,
                "text": "*   Symptoms that last longer than 10 to 14 days, or symptoms that improve and then suddenly get significantly worse (which can indicate a secondary bacterial infection like sinus or ear infections)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                3
              ],
              "segment": {
                "start_index": 4291,
                "end_index": 4489,
                "part_index": null,
                "text": "*If you have underlying health conditions, are pregnant, or are looking for medications for a young child, please consult a pharmacist or primary care physician before starting any new OTC therapies"
              },
              "rendered_parts": null
            }
          ],
