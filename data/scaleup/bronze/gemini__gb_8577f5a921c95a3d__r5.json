              "segment": {
                "start_index": 105,
                "end_index": 243,
                "part_index": null,
                "text": "For a long time, these worlds existed only in science fiction\u2014most famously as Luke Skywalker\u2019s home planet of Tatooine in *Star Wars*"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
