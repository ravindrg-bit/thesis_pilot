          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 419,
                "end_index": 643,
                "part_index": null,
                "text": "To understand this leap, here is a direct comparison between **Sputnik 1** (the first satellite) and a couple of the most advanced modern benchmarks: **Jupiter 3** (the largest commercial communications satellite ever built)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 745,
                "end_index": 784,
                "part_index": null,
                "text": "| Feature | The First: Sputnik 1 (1957)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 745,
                "end_index": 821,
                "part_index": null,
                "text": "| Feature | The First: Sputnik 1 (1957) | The Modern Giant: Jupiter 3 (2023)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                3
              ],
              "segment": {
                "start_index": 745,
                "end_index": 972,
                "part_index": null,
                "text": "| Feature | The First: Sputnik 1 (1957) | The Modern Giant: Jupiter 3 (2023) | The Modern Network: Starlink V2 (Present) |\n| :--- | :--- | :--- | :--- |\n| **Purpose** | To prove spaceflight was possible and study the ionosphere"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 974,
                "end_index": 1030,
                "part_index": null,
                "text": "| High-speed satellite internet for an entire hemisphere"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5,
                2
              ],
              "segment": {
                "start_index": 1106,
                "end_index": 1212,
                "part_index": null,
                "text": "|\n| **Physical Size** | **58 cm (23 in) sphere**\u2014about the size of a beach ball, with four whip antennas"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                7
              ],
              "segment": {
                "start_index": 1214,
                "end_index": 1318,
                "part_index": null,
                "text": "| **Size of a school bus**; when deployed, its solar arrays span **127 feet** (like a 10-story building)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1402,
                "end_index": 1447,
                "part_index": null,
                "text": "|\n| **Weight (Mass)** | **83.6 kg** (184 lbs)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1449,
                "end_index": 1481,
                "part_index": null,
                "text": "| **9,200 kg** (over 20,000 lbs)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 1555,
                "end_index": 1621,
                "part_index": null,
                "text": "|\n| **Power Source** | Three simple silver-zinc chemical batteries"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 1623,
                "end_index": 1648,
                "part_index": null,
                "text": "| 14 massive solar panels"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2
              ],
              "segment": {
                "start_index": 1753,
                "end_index": 1817,
                "part_index": null,
                "text": "** Tumbled freely in orbit until aerodynamic drag pulled it down"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1,
                2
              ],
              "segment": {
                "start_index": 2282,
                "end_index": 2340,
                "part_index": null,
                "text": "** Just a 1-watt transmitter broadcasting a pulsing \"beep\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 2342,
                "end_index": 2380,
                "part_index": null,
                "text": "| **Over 500 Gbps** of data throughput"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 2342,
                "end_index": 2431,
                "part_index": null,
                "text": "| **Over 500 Gbps** of data throughput (enough to support millions of simultaneous users)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 2516,
                "end_index": 2580,
                "part_index": null,
                "text": "|\n| **Active Lifespan** | **21 days** (until the batteries died)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 2582,
                "end_index": 2607,
                "part_index": null,
                "text": "| **15+ years** (planned)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 2664,
                "end_index": 2701,
                "part_index": null,
                "text": "|\n| **Orbit** | Low Earth Orbit (LEO)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                9
              ],
              "segment": {
                "start_index": 2664,
                "end_index": 2743,
                "part_index": null,
                "text": "|\n| **Orbit** | Low Earth Orbit (LEO) (de-orbited and burned up after 3 months)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10
              ],
              "segment": {
                "start_index": 2745,
                "end_index": 2772,
                "part_index": null,
                "text": "| Geostationary Orbit (GEO)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                8
              ],
              "segment": {
                "start_index": 2745,
                "end_index": 2840,
                "part_index": null,
                "text": "| Geostationary Orbit (GEO) (~35,800 km/22,300 miles out\u2014permanently fixed over the Americas)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                1
              ],
              "segment": {
                "start_index": 2982,
                "end_index": 3075,
                "part_index": null,
                "text": "Battery Dependence\n* **Then:** Sputnik 1 was entirely dependent on onboard chemical batteries"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2,
                9
              ],
              "segment": {
                "start_index": 3077,
                "end_index": 3232,
                "part_index": null,
                "text": "Once they ran dry 21 days after launch, the satellite was functionally \"dead,\" serving as a silent piece of space junk until it burned up in the atmosphere"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 3480,
                "end_index": 3605,
                "part_index": null,
                "text": "Communication and \"Space Lasers\"\n* **Then:** Sputnik\u2019s radio transmitter had only one job: to broadcast a simple radio tone"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 3607,
                "end_index": 3733,
                "part_index": null,
                "text": "Amateurs and scientists on Earth listened to its famous *\"beep... beep... beep\"* as proof that the Soviets had conquered orbit"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                4
              ],
              "segment": {
                "start_index": 3736,
                "end_index": 3873,
                "part_index": null,
                "text": "* **Now:** A single modern satellite like Jupiter 3 uses Ka, Q, and V-band frequencies to transmit massive amounts of data back and forth"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 4174,
                "end_index": 4277,
                "part_index": null,
                "text": "Once pushed out of the R-7 rocket, it had no steering, no stabilization, and no way to control its path"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 4880,
                "end_index": 4987,
                "part_index": null,
                "text": "* **Now:** While we still launch massive solo satellites (like Jupiter 3 or the James Webb Space Telescope)"
              },
              "rendered_parts": null
            }
          ],
