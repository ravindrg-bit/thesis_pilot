              "segment": {
                "start_index": 399,
                "end_index": 603,
                "part_index": null,
                "text": "The Common (But Flawed) \"Internet\" Estimate: ~620 Million\nIf you search the internet for this answer, you will often find sources claiming the average human blinks over **620 million times** in a lifetime"
              },
              "rendered_parts": null
            },
