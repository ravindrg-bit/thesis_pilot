          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 325,
                "end_index": 554,
                "part_index": null,
                "text": "The Default Rule: No Automatic Retroactivity\nIn common-law countries like the United States, Canada, and the United Kingdom, the default rule is that **an act is judged by the law as it existed at the time the act was committed**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 665,
                "end_index": 790,
                "part_index": null,
                "text": "Under this principle, their conviction and sentence remain legally valid, and they are expected to serve their remaining time"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 793,
                "end_index": 875,
                "part_index": null,
                "text": "Constitutions (such as the U.S. Constitution) usually have *ex post facto* clauses"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 877,
                "end_index": 982,
                "part_index": null,
                "text": "These clauses protect you from being prosecuted if the government makes an act illegal *after* you did it"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                3
              ],
              "segment": {
                "start_index": 1023,
                "end_index": 1150,
                "part_index": null,
                "text": "** There is no constitutional rule stating that you must be freed if the government legalizes an act *after* you were convicted"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1160,
                "end_index": 1375,
                "part_index": null,
                "text": "The International Principle of *Lex Mitior*\nIn contrast to the common-law default, some international treaties and civil-law countries recognize the legal principle of **_lex mitior_** (Latin for \"more lenient law\")"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3,
                4
              ],
              "segment": {
                "start_index": 1377,
                "end_index": 1586,
                "part_index": null,
                "text": "Under Article 15 of the International Covenant on Civil and Political Rights (ICCPR), if a law changes to reduce a penalty or decriminalize an act, the offender is supposed to benefit from the more lenient law"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1589,
                "end_index": 1782,
                "part_index": null,
                "text": "However, *lex mitior* has two major limitations:\n* **Finality of Judgments:** In many countries, the principle only applies to active cases\u2014meaning those currently going to trial or on appeal"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 1784,
                "end_index": 1931,
                "part_index": null,
                "text": "If a person has already been convicted and their appeals have run out (a \"final judgment\"), they often cannot use *lex mitior* to get out of prison"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 1933,
                "end_index": 2141,
                "part_index": null,
                "text": "* **National Reservations:** The United States is one of the few nations that attached a formal reservation to the ICCPR, specifically exempting itself from being federally bound by the *lex mitior* principle"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 2151,
                "end_index": 2380,
                "part_index": null,
                "text": "How Prisoners *Do* Get Released\nEven though release is not automatic, governments frequently choose to release prisoners or clear their records as a matter of policy, calling it **restorative justice** or **retroactive legality**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 2432,
                "end_index": 2605,
                "part_index": null,
                "text": "Specific Retroactive Provisions in the Legalization Bill\nWhen lawmakers write a legalization bill, they can explicitly include instructions on what to do with past offenders"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                9
              ],
              "segment": {
                "start_index": 2608,
                "end_index": 2733,
                "part_index": null,
                "text": "* **Resentencing:** The law can allow current inmates to petition a judge to have their sentences reduced or vacated entirely"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 2736,
                "end_index": 2850,
                "part_index": null,
                "text": "* **Expungement:** The law can dictate that past criminal records for the newly legalized drug be erased or sealed"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                10,
                6
              ],
              "segment": {
                "start_index": 2866,
                "end_index": 3137,
                "part_index": null,
                "text": "When states like California, Illinois, and New York legalized recreational cannabis, they built provisions into the laws to automatically or systematically expunge hundreds of thousands of low-level marijuana convictions and resentence or release those still incarcerated"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 3148,
                "end_index": 3384,
                "part_index": null,
                "text": "Executive Clemency (Pardons and Commutations)\nIf the legalization bill does not address past convictions, the head of the executive branch (such as a President, Prime Minister, or State Governor) can use their personal power of clemency"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 3804,
                "end_index": 3971,
                "part_index": null,
                "text": "Why Some People Remain in Prison\nEven when a drug is legalized and retroactive relief is offered, many people convicted of charges relating to that drug stay in prison"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 4113,
                "end_index": 4292,
                "part_index": null,
                "text": "While individuals convicted of simple possession are often released or pardoned, those convicted of large-scale trafficking, manufacturing, or selling to minors are rarely let out"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                13
              ],
              "segment": {
                "start_index": 4294,
                "end_index": 4555,
                "part_index": null,
                "text": "* **Sentence Enhancements:** If a drug charge was paired with other offenses\u2014such as carrying a firearm, committing an act of violence, or money laundering\u2014the inmate will usually have to serve out the remainder of their sentence for those associated crimes"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14,
                15
              ],
              "segment": {
                "start_index": 4557,
                "end_index": 4657,
                "part_index": null,
                "text": "* **Administrative Hurdle (The \"Petition\" System):** In many jurisdictions, release is not automatic"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                15
              ],
              "segment": {
                "start_index": 4659,
                "end_index": 4738,
                "part_index": null,
                "text": "Inmates must formally petition a court, find a lawyer, and go through a hearing"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12,
                10
              ],
              "segment": {
                "start_index": 4740,
                "end_index": 4908,
                "part_index": null,
                "text": "Prisoners who lack legal resources or whose paperwork gets bogged down in court backlogs can remain locked up for months or years after the drug is officially legalized"
              },
              "rendered_parts": null
            }
          ],
          "retrieval_metadata": null,
