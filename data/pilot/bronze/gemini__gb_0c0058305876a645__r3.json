                "end_index": 980,
                "part_index": null,
                "text": "*   **No Aspirin for Children:** Never give aspirin to children or teenagers, as it is linked to Reye\u2019s syndrome\u2014a rare but life-threatening condition"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1316,
                "end_index": 1419,
                "part_index": null,
                "text": "*\n*   **Nasal Decongestant Sprays:** Sprays containing oxymetazoline (e.g., Afrin) provide rapid relief"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0
              ],
              "segment": {
                "start_index": 1426,
                "end_index": 1536,
                "part_index": null,
                "text": "*   **Safety Warning:** Limit the use of nasal decongestant sprays to **no more than 3 to 5 consecutive days**"
