          "grounding_supports": [
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                0,
                1
              ],
              "segment": {
                "start_index": 187,
                "end_index": 265,
                "part_index": null,
                "text": "Since **SiriusXM** is the only major satellite radio provider in North America"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                2
              ],
              "segment": {
                "start_index": 363,
                "end_index": 448,
                "part_index": null,
                "text": "SiriusXM\u2019s \"Free Access\" Plan (Ad-Supported)\nSiriusXM offers a **Free Access Plan**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                3
              ],
              "segment": {
                "start_index": 363,
                "end_index": 523,
                "part_index": null,
                "text": "SiriusXM\u2019s \"Free Access\" Plan (Ad-Supported)\nSiriusXM offers a **Free Access Plan**\u2014a completely free, ad-supported tier designed for inactive in-car radios"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4,
                5
              ],
              "segment": {
                "start_index": 526,
                "end_index": 725,
                "part_index": null,
                "text": "* **How it works:** You get dozens of popular music, news, talk, and sports channels (including *SiriusXM Hits 1*, *'90s on 9*, *Alt Nation*, and *ESPN Radio*) directly through your car\u2019s dashboard"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 728,
                "end_index": 780,
                "part_index": null,
                "text": "* **The Catch:** \n  * **No credit card is required**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 728,
                "end_index": 876,
                "part_index": null,
                "text": "* **The Catch:** \n  * **No credit card is required**, but it is **only available on newer vehicles** equipped with SiriusXM's **360L hybrid radios**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6,
                5
              ],
              "segment": {
                "start_index": 728,
                "end_index": 969,
                "part_index": null,
                "text": "* **The Catch:** \n  * **No credit card is required**, but it is **only available on newer vehicles** equipped with SiriusXM's **360L hybrid radios** (typically 2023 or newer models from manufacturers like Ford, GM, Subaru, Dodge, and Nissan)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                4
              ],
              "segment": {
                "start_index": 973,
                "end_index": 996,
                "part_index": null,
                "text": "* It is **in-car only**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 998,
                "end_index": 1051,
                "part_index": null,
                "text": "It does not include access to the SiriusXM mobile app"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1055,
                "end_index": 1149,
                "part_index": null,
                "text": "* **The 60-Day Rule:** To keep the service active, you must use it at least once every 60 days"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                6
              ],
              "segment": {
                "start_index": 1151,
                "end_index": 1188,
                "part_index": null,
                "text": "If you don't, the plan is deactivated"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                5
              ],
              "segment": {
                "start_index": 1192,
                "end_index": 1286,
                "part_index": null,
                "text": "* It is currently only offered in the United States (SiriusXM Canada does not offer this tier)"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                7,
                8
              ],
              "segment": {
                "start_index": 1296,
                "end_index": 1654,
                "part_index": null,
                "text": "SiriusXM Free Trials & Promotional Events\nIf your vehicle doesn't qualify for the Free Access Plan, you can still get SiriusXM for free temporarily using these methods:\n* **In-Car Free Trials:** If you buy a new or certified pre-owned vehicle with a factory-installed satellite radio, it almost always comes with a **3-month free trial** of the Platinum plan"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9
              ],
              "segment": {
                "start_index": 1656,
                "end_index": 1749,
                "part_index": null,
                "text": "No credit card is required to start this trial, and it automatically shuts off when it's over"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                8
              ],
              "segment": {
                "start_index": 1752,
                "end_index": 1874,
                "part_index": null,
                "text": "* **Streaming-Only Trials:** SiriusXM frequently offers 1- to 3-month free trials of their streaming app for new customers"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                9,
                10
              ],
              "segment": {
                "start_index": 1876,
                "end_index": 2011,
                "part_index": null,
                "text": "*Note: These usually require a credit card and will auto-renew at the standard monthly rate if you don\u2019t cancel before the trial ends"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                11
              ],
              "segment": {
                "start_index": 2117,
                "end_index": 2186,
                "part_index": null,
                "text": "For example, T-Mobile has historically offered several months \"On Us\""
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                12
              ],
              "segment": {
                "start_index": 2117,
                "end_index": 2272,
                "part_index": null,
                "text": "For example, T-Mobile has historically offered several months \"On Us\", and Samsung occasionally runs 6-month free streaming trials through the Galaxy Store"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                13
              ],
              "segment": {
                "start_index": 2274,
                "end_index": 2468,
                "part_index": null,
                "text": "* **Free Listening Events:** A few times a year (typically around major US holidays like Memorial Day, Thanksgiving, or Labor Day), SiriusXM will temporarily **unlock inactive satellite radios**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                14
              ],
              "segment": {
                "start_index": 2861,
                "end_index": 3105,
                "part_index": null,
                "text": "While they rely on your phone\u2019s cell data or Wi-Fi rather than a direct satellite feed, they are highly popular alternatives:\n* **TuneIn:** Gives you access to thousands of live local AM/FM stations, global news networks, podcasts, and sports"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                8
              ],
              "segment": {
                "start_index": 3251,
                "end_index": 3283,
                "part_index": null,
                "text": "* **Pandora:** Owned by SiriusXM"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                15,
                8
              ],
              "segment": {
                "start_index": 3251,
                "end_index": 3384,
                "part_index": null,
                "text": "* **Pandora:** Owned by SiriusXM, Pandora lets you create free, ad-supported custom stations based on your favorite artists or genres"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                16
              ],
              "segment": {
                "start_index": 3386,
                "end_index": 3558,
                "part_index": null,
                "text": "* **Radio Garden:** A unique, free app that allows you to rotate a 3D globe and tune into thousands of live, local radio stations broadcasting across the world in real-time"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17
              ],
              "segment": {
                "start_index": 3568,
                "end_index": 3759,
                "part_index": null,
                "text": "Free-to-Air (FTA) Satellite Radio (For Hobbyists)\nIf you are a tech hobbyist and want actual satellite-beamed radio without paying a company, you can look into **Free-To-Air (FTA) Satellite**"
              },
              "rendered_parts": null
            },
            {
              "confidence_scores": null,
              "grounding_chunk_indices": [
                17
              ],
              "segment": {
                "start_index": 3762,
                "end_index": 3942,
                "part_index": null,
                "text": "By purchasing a satellite dish (C-band or Ku-band) and a DVB satellite receiver, you can tune into hundreds of unencrypted, free radio stations broadcast over the air via satellite"
              },
              "rendered_parts": null
            }
          ],
